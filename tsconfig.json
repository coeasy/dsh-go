{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "functions/**/*.ts",
    "tests/architecture-v4/**/*.ts",
    "tests/deployment-convergence.test.ts",
    "tests/production-sha-gate.test.ts",
    "tests/deployment-dispatch.test.ts",
    "tests/edgeone-deploy-ci.test.ts",
    "tests/npm-audit-retry.test.ts",
    "tests/marketplace-policy.test.ts",
    "tests/package-protocol-conformance.test.ts",
    "site/src/i18n/**/*.ts",
    "marketplace/**/*.ts",
    "mcp/**/*.ts",
    "skills/**/*.ts",
    "agents/**/*.ts",
    "profiles/**/*.ts"
  ]
}
