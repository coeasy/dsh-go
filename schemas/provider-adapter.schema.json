{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coeasy.github.io/dsh-go/schemas/provider-adapter.schema.json",
  "title": "DSH Provider Adapter Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["manifest_version", "id", "name", "version", "kind", "entrypoint", "files"],
  "properties": {
    "manifest_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "minLength": 1, "maxLength": 200 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "kind": { "enum": ["llm", "mcp", "skill", "agent-runtime"] },
    "entrypoint": { "$ref": "#/$defs/relativePath" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "compatibility": { "type": "object" },
    "publisher": { "type": ["object", "null"] },
    "security": { "type": ["object", "null"] },
    "release": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "channel": { "enum": ["stable", "beta", "nightly", "dev"] }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
    }
  }
}
