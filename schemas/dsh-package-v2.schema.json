{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-go.dev/schemas/dsh-package-v2.schema.json",
  "title": "DSH Package Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "type",
    "id",
    "version",
    "channel",
    "name",
    "description",
    "runtime",
    "entrypoints",
    "permissions",
    "dependencies",
    "compatibility",
    "publisher",
    "security",
    "metadata"
  ],
  "properties": {
    "manifest_version": { "const": 2 },
    "type": { "enum": ["plugin", "mcp", "skill", "agent"] },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$", "maxLength": 160 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["stable", "beta", "nightly", "dev"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "runtime": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["plugin", "mcp", "skill", "agent"] } },
      "additionalProperties": true
    },
    "entrypoints": { "type": "object", "additionalProperties": true },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "range", "channel"],
        "properties": {
          "type": { "enum": ["plugin", "mcp", "skill", "agent"] },
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$" },
          "range": { "type": "string", "minLength": 1 },
          "channel": { "enum": ["stable", "beta", "nightly", "dev"] },
          "registry": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "compatibility": { "type": "object", "additionalProperties": true },
    "publisher": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 128 },
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "identity": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "security": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true },
    "source": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "repo": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "release": { "type": "object", "additionalProperties": true },
    "permission_policy": { "type": "object", "additionalProperties": true },
    "localization": { "type": "object", "additionalProperties": true },
    "conflicts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "replaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "provides": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "plugin": { "type": "object", "additionalProperties": true },
    "mcp": { "type": "object", "additionalProperties": true },
    "skill": { "type": "object", "additionalProperties": true },
    "agent": { "type": "object", "additionalProperties": true }
  }
}
