{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-go.dev/schemas/dsh-package-release-v2.schema.json",
  "title": "DSH Package Release Descriptor V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_version",
    "protocol_version",
    "manifest_version",
    "id",
    "type",
    "version",
    "channel",
    "repository",
    "commit",
    "tag",
    "published_at",
    "manifest_file",
    "package_path",
    "manifest",
    "artifact"
  ],
  "properties": {
    "release_version": { "const": 2 },
    "protocol_version": { "const": 2 },
    "manifest_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$", "maxLength": 200 },
    "type": { "enum": ["plugin", "mcp", "skill", "agent"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["stable", "beta", "nightly", "dev"] },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "tag": { "type": "string", "minLength": 1, "maxLength": 255 },
    "published_at": { "type": "string", "format": "date-time" },
    "manifest_file": { "type": "string", "pattern": "^(?:[A-Za-z0-9_.-]+/)*dsh-package\\.json$" },
    "package_path": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$" }
      ]
    },
    "manifest": { "$ref": "dsh-package-v2.schema.json" },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "url", "digest", "format", "strip_components"],
      "properties": {
        "kind": { "const": "release-archive" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "digest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "format": { "const": "tgz" },
        "strip_components": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
