---
// Shared responsive presentation for the Marketplace homepage and /ecosystem alias.
// Discovery/data policy stays in UnifiedMarketplace; this component owns visual balance only.
---

<style is:global>
  /* Resource cards stay readable and visually stronger than surrounding policy chrome. */
  .market-card h2 {
    font-size: 19px !important;
    line-height: 1.34 !important;
    margin-top: 13px !important;
  }

  .market-card .repo {
    font-size: 12.75px !important;
    line-height: 1.5 !important;
  }

  .market-card .description {
    color: color-mix(in srgb, var(--fg) 82%, var(--muted)) !important;
    font-size: 15.75px !important;
    line-height: 1.68 !important;
    min-height: 106px !important;
    margin: 13px 0 15px !important;
    -webkit-line-clamp: 4 !important;
  }

  .market-card .kind,
  .market-card .source,
  .market-card .verified,
  .market-card .meta-row span,
  .market-card .caps span {
    font-size: 11.5px !important;
    line-height: 1.35 !important;
  }

  .market-card .stars {
    font-size: 13px !important;
  }

  .market-card .card-main {
    padding: 20px 20px 16px !important;
    text-decoration: none !important;
  }

  .market-card .card-main,
  .market-card .card-main * {
    text-decoration: none !important;
  }

  .market-card .card-actions {
    align-items: center !important;
    padding: 11px 14px !important;
  }

  .market-card .card-actions .ghost,
  .market-card .card-actions .install {
    font-size: 12.5px !important;
    min-height: 36px !important;
    padding: 8px 11px !important;
  }

  .market-card .card-actions .install {
    flex: 1 1 128px;
    font-weight: 850 !important;
    box-shadow: 0 7px 18px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  /* Category cards are real navigation, not decoration. */
  .category-card {
    min-height: 82px !important;
    padding: 15px 16px !important;
  }

  .category-card .category-icon {
    width: 42px !important;
    height: 42px !important;
    border-radius: 12px !important;
    font-size: 16px !important;
  }

  .category-card .category-copy strong {
    font-size: 15.5px !important;
    line-height: 1.3 !important;
  }

  .category-card .category-copy small {
    font-size: 12.25px !important;
    line-height: 1.48 !important;
    margin-top: 3px !important;
  }

  .category-card .category-count {
    min-width: 42px !important;
    padding: 5px 9px !important;
    font-size: 12px !important;
  }

  .market-facts strong {
    color: var(--fg) !important;
    font-size: 13px !important;
  }

  .market-facts span {
    font-size: 12px !important;
  }

  .result-line {
    font-size: 13px !important;
  }

  #market-count {
    color: color-mix(in srgb, var(--fg) 82%, var(--muted));
    font-weight: 720;
  }

  @media (min-width: 1100px) {
    .market-hero {
      padding: 27px 0 19px !important;
    }

    .market-hero.compact {
      padding-top: 22px !important;
    }

    .market-hero h1 {
      max-width: none !important;
      margin: 7px auto 8px !important;
      font-size: clamp(40px, 3.15vw, 52px) !important;
      line-height: 1.06 !important;
      letter-spacing: -.045em !important;
      white-space: nowrap !important;
    }

    .market-hero p {
      max-width: none !important;
      font-size: 15.75px !important;
      line-height: 1.5 !important;
      white-space: nowrap !important;
    }

    .market-hero .hero-actions {
      margin: 16px 0 !important;
    }

    .market-hero .metrics span {
      padding: 5px 10px !important;
    }

    .category-section {
      margin-top: 7px !important;
    }

    /* Keep search and core filters available while browsing long result sets. */
    .market-toolbar {
      position: sticky;
      top: 68px;
      z-index: 18;
      margin: 0 -10px 11px !important;
      padding: 10px !important;
      border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
      border-radius: 17px;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: blur(16px) saturate(1.25);
      -webkit-backdrop-filter: blur(16px) saturate(1.25);
      box-shadow: 0 10px 28px rgb(15 23 42 / .06);
    }

    html.dark .market-toolbar {
      box-shadow: 0 10px 28px rgb(0 0 0 / .22);
    }

    .market-toolbar .search-wrap {
      box-shadow: none !important;
    }
  }

  /* Four substantial resource cards are the desktop baseline. */
  @media (min-width: 1280px) {
    .market-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 18px !important;
    }

    .market-card {
      min-height: 360px !important;
    }
  }

  @media (min-width: 900px) and (max-width: 1279px) {
    .market-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      gap: 16px !important;
    }

    .market-card {
      min-height: 350px !important;
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  @media (min-width: 640px) and (max-width: 899px) {
    .market-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  @media (max-width: 1099px) {
    .market-hero h1 {
      max-width: 900px !important;
      font-size: clamp(36px, 7vw, 50px) !important;
      line-height: 1.08 !important;
      white-space: normal !important;
    }

    .market-hero p {
      white-space: normal !important;
    }
  }

  @media (max-width: 639px) {
    .market-grid,
    .category-grid {
      grid-template-columns: 1fr !important;
    }

    .market-card {
      min-height: 0 !important;
    }

    .market-card .description {
      min-height: 0 !important;
      font-size: 15px !important;
    }

    .market-card .card-actions .install {
      flex-basis: 100%;
      order: -1;
    }
  }
</style>
