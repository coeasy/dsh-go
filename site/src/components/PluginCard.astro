---
import { u } from '../lib/urls';
import { DETAIL_THRESHOLD } from '../lib/threshold';
import { fmtK } from '../lib/format';

interface Props {
  slug: string;
  name: string;
  description: string;
  stars: number;
  category: string;
  verified: boolean;
  trend: number;
  tags: string[];
  isNew: boolean;
  created?: string;
  updated?: string;
  full_name?: string;
  install_cmd?: string;
  language?: string;
  ecosystemType?: string;
  registryVersion?: string;
  registryManaged?: boolean;
}

const {
  slug, name, description, stars, category, verified, trend, tags, isNew,
  created, updated, full_name, install_cmd, language,
  ecosystemType = 'plugin', registryVersion = '', registryManaged = false,
} = Astro.props;

const hasDetail = stars >= DETAIL_THRESHOLD;
const detailHref = u(`/plugin/${slug}`);
const githubHref = `https://github.com/${full_name || slug}`;
const cardHref = hasDetail ? detailHref : githubHref;
const repoName = full_name?.split('/').pop() || '';
const showRepoIdentity = Boolean(full_name && repoName && name.trim().toLowerCase() !== repoName.toLowerCase());

const hash = [...name].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const hue = hash % 360;
const initial = (name || '?').trim().charAt(0).toUpperCase();

function relTime(iso?: string): string {
  if (!iso) return '';
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 864e5);
  if (days <= 0) return 'today';
  if (days === 1) return '1d';
  if (days < 30) return `${days}d`;
  if (days < 365) return `${Math.floor(days / 30)}mo`;
  return `${Math.floor(days / 365)}y`;
}
const age = relTime(updated);

const CATEGORY_ZH: Record<string, string> = {
  'web-ui': 'Web UI', desktop: '桌面端', mcp: 'MCP', skills: '技能', theme: '主题',
  terminal: '终端', coding: '编码', agent: 'Agent', vision: '视觉', memory: '记忆',
  security: '安全', integration: '集成', tool: '工具', other: '其他',
};
---

<article
  class="plugin-card"
  data-category={category}
  data-verified={verified ? 'true' : 'false'}
  data-is-new={isNew ? 'true' : 'false'}
  data-trend={trend}
  data-stars={stars}
  data-name={name}
  data-desc={description}
  data-tags={(tags || []).join(' ')}
  data-language={language || ''}
  data-created={created}
  data-updated={updated}
  data-cmd={install_cmd}
>
  <a class="card-main" href={cardHref} aria-label={`${name} 详情`}>
    <div class="row1">
      <span class="avatar" style={`--h:${hue}`}>{initial}</span>
      <span class="identity">
        <strong class="name" title={name}>{name}</strong>
        <small title={full_name || name}>{full_name || repoName || category}</small>
      </span>
      <span class="stars" title={`${stars} stars`}>★ {fmtK(stars)}</span>
    </div>

    {showRepoIdentity && <div class="repo-id">展示名与仓库身份已分离 · {full_name}</div>}

    <p class="desc">{description || '暂无描述'}</p>

    <div class="signals">
      <span class={`kind ${ecosystemType}`}>{ecosystemType.toUpperCase()}</span>
      <span class="badge gray" data-i18n-cat={category}>{CATEGORY_ZH[category] || category}</span>
      {verified && <span class="badge green">✓ Verified</span>}
      {registryManaged && <span class="badge registry">Registry V3</span>}
      {registryVersion && <span class="badge version">v{registryVersion}</span>}
      {isNew && <span class="badge amber">New</span>}
    </div>
  </a>

  <div class="card-footer">
    <span class="runtime-meta">{language || 'Unknown'}{age ? ` · ${age}` : ''}</span>
    <span class="actions">
      {hasDetail
        ? <a class="detail-btn" href={detailHref}>详情</a>
        : <a class="detail-btn" href={githubHref} target="_blank" rel="noreferrer">GitHub ↗</a>}
      {install_cmd && (
        <button class="install-btn copy-cmd" type="button" data-copy-cmd={install_cmd} title={install_cmd} aria-label="复制安装命令">Install</button>
      )}
    </span>
  </div>
</article>

<style>
  .plugin-card {
    display: flex; flex-direction: column; min-width: 0; min-height: 238px;
    border: 1px solid var(--border); border-radius: 18px; background: var(--card);
    color: var(--fg); box-shadow: var(--shadow-sm); overflow: hidden; position: relative;
    transition: transform .18s cubic-bezier(.2,.7,.3,1), box-shadow .18s, border-color .18s;
  }
  .plugin-card::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; z-index: 1;
    background: var(--grad-accent); opacity: 0; transition: opacity .18s;
  }
  .plugin-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: color-mix(in srgb, var(--accent) 42%, var(--border)); }
  .plugin-card:hover::before { opacity: 1; }
  .card-main { display: flex; flex: 1; flex-direction: column; padding: 17px 17px 12px; color: inherit; min-width: 0; }
  .card-main:hover { text-decoration: none; }
  .row1 { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .avatar {
    flex: none; width: 38px; height: 38px; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 850; color: #fff;
    background: linear-gradient(135deg, hsl(var(--h, 210) 70% 55%), hsl(calc(var(--h, 210) + 40) 70% 45%));
    box-shadow: 0 5px 16px hsl(var(--h, 210) 60% 50% / .22);
  }
  .identity { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .identity small { color: var(--muted); font-size: 10.5px; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .name { font-weight: 780; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stars { margin-left: auto; flex: none; font-size: 12.5px; font-weight: 760; color: var(--amber); white-space: nowrap; }
  .repo-id { margin: 8px 0 -2px 48px; color: var(--muted); font-size: 10.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .desc { margin: 13px 0 14px; color: var(--muted); font-size: 12.5px; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .signals { display: flex; gap: 6px; flex-wrap: wrap; margin-top: auto; }
  .kind, .badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 8px; font-size: 10.5px; font-weight: 750; line-height: 1.25; }
  .kind { color: var(--accent); background: var(--accent-soft); }
  .kind.mcp { color: #7c3aed; background: color-mix(in srgb, #7c3aed 12%, transparent); }
  .kind.skill, .kind.skills { color: #0891b2; background: color-mix(in srgb, #0891b2 12%, transparent); }
  .kind.agent { color: #db2777; background: color-mix(in srgb, #db2777 12%, transparent); }
  .badge.registry { color: var(--accent); background: color-mix(in srgb, var(--accent) 11%, transparent); }
  .badge.version { color: var(--muted); background: var(--bg-soft); }
  .card-footer {
    display: flex; align-items: center; gap: 10px; justify-content: space-between; min-height: 48px;
    border-top: 1px solid var(--border); padding: 9px 12px 9px 16px; background: color-mix(in srgb, var(--bg-soft) 55%, transparent);
  }
  .runtime-meta { min-width: 0; color: var(--muted); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .actions { display: inline-flex; flex: none; gap: 6px; }
  .detail-btn, .install-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 29px; border-radius: 9px; padding: 5px 10px;
    font-size: 11.5px; font-weight: 700; border: 1px solid var(--border); cursor: pointer; text-decoration: none;
  }
  .detail-btn { color: var(--muted); background: var(--card); }
  .detail-btn:hover { color: var(--fg); border-color: var(--border-strong); text-decoration: none; }
  .install-btn { color: #fff; border-color: var(--accent); background: var(--accent); }
  .install-btn:hover { filter: brightness(1.04); transform: translateY(-1px); }
  .install-btn.copied { background: var(--green); border-color: var(--green); }
  @media (max-width: 520px) { .plugin-card { min-height: 220px; } .repo-id { margin-left: 0; } }
</style>
