---
import { fmtK } from '../lib/format';

interface Props {
  name: string;
  description?: string;
  repo?: string;
  repoUrl?: string;
  type: 'plugin' | 'mcp' | 'skill' | 'agent';
  version: string;
  identity: string;
  category?: string;
  verified?: boolean;
  language?: string;
  stars?: number;
  commit?: string;
  installCommand: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  name,
  description = '',
  repo = '',
  repoUrl = '',
  type,
  version,
  identity,
  category = 'other',
  verified = false,
  language = '',
  stars = 0,
  commit = '',
  installCommand,
  primaryHref,
  primaryLabel = '一键安装',
  secondaryHref,
  secondaryLabel = '关联详情',
} = Astro.props;

const hash = [...name].reduce((value, char) => (value * 31 + char.charCodeAt(0)) >>> 0, 7);
const hue = hash % 360;
const initial = (name || '?').trim().charAt(0).toUpperCase();
const typeLabel = type === 'mcp' ? 'MCP' : type === 'skill' ? 'SKILL' : type === 'agent' ? 'AGENT' : 'PLUGIN';
---

<section class="marketplace-detail-hero" data-install-command={installCommand}>
  <div class="hero-main">
    <span class="avatar" style={`--h:${hue}`}>{initial}</span>
    <div class="title-col">
      <div class="badges">
        <span class={`badge kind ${type}`}>{typeLabel}</span>
        <span class="badge version">v{version}</span>
        <span class="badge gray">{category}</span>
        {verified && <span class="badge green">✓ verified</span>}
        {language && <span class="badge gray">{language}</span>}
      </div>
      <h1>{name}</h1>
      <div class="identity-line"><code>{identity}</code>{repo && <span>·</span>}{repo && <span>{repo}</span>}</div>
    </div>
    {repoUrl && <a class="repo-button" href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
  </div>

  <p class="description">{description || '暂无描述'}</p>

  <div class="facts">
    <span><b>★ {fmtK(stars)}</b><i>stars</i></span>
    <span><b>v{version}</b><i>Registry version</i></span>
    <span><b>{typeLabel}</b><i>runtime type</i></span>
    {commit && <span title={commit}><b>{commit.slice(0, 8)}</b><i>immutable commit</i></span>}
  </div>

  <div class="install-card">
    <div class="install-copy">
      <small>本地安装命令 · 安装后手动重启激活</small>
      <code>{installCommand}</code>
    </div>
    <div class="actions">
      {primaryHref && <a class="primary" href={primaryHref}>{primaryLabel}</a>}
      <button type="button" class="copy-install">复制命令</button>
      {secondaryHref && <a href={secondaryHref}>{secondaryLabel}</a>}
    </div>
  </div>
</section>

<script>
  for (const hero of document.querySelectorAll('.marketplace-detail-hero')) {
    if (!(hero instanceof HTMLElement)) continue;
    const button = hero.querySelector('.copy-install');
    if (!(button instanceof HTMLButtonElement)) continue;
    button.addEventListener('click', async () => {
      const command = hero.dataset.installCommand || '';
      try {
        await navigator.clipboard.writeText(command);
      } catch {
        window.prompt('复制本地安装命令', command);
      }
      const previous = button.textContent || '复制命令';
      button.textContent = '已复制 ✓';
      window.setTimeout(() => { button.textContent = previous; }, 1400);
    });
  }
</script>

<style>
  .marketplace-detail-hero {
    position: relative; overflow: hidden; border: 1px solid var(--border); border-radius: 20px;
    background: var(--card); padding: 24px; box-shadow: var(--shadow-sm);
  }
  .marketplace-detail-hero::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 3px; background: var(--grad-accent);
  }
  .hero-main { display: flex; align-items: center; gap: 16px; }
  .avatar {
    flex: none; width: 58px; height: 58px; border-radius: 17px; display: inline-flex;
    align-items: center; justify-content: center; color: #fff; font-size: 26px; font-weight: 850;
    background: linear-gradient(135deg, hsl(var(--h, 210) 70% 55%), hsl(calc(var(--h, 210) + 40) 70% 45%));
    box-shadow: 0 8px 22px hsl(var(--h, 210) 60% 45% / .23);
  }
  .title-col { min-width: 0; flex: 1; }
  .title-col h1 { margin: 8px 0 3px; font-size: clamp(25px, 4vw, 34px); line-height: 1.12; overflow-wrap: anywhere; }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 8px; font-size: 11px; font-weight: 750; }
  .badge.kind { font-weight: 850; letter-spacing: .03em; }
  .badge.plugin { color: var(--accent); background: var(--accent-soft); }
  .badge.mcp { color: #7c3aed; background: color-mix(in srgb, #7c3aed 12%, transparent); }
  .badge.skill { color: #0891b2; background: color-mix(in srgb, #0891b2 12%, transparent); }
  .badge.agent { color: #db2777; background: color-mix(in srgb, #db2777 12%, transparent); }
  .badge.version, .badge.gray { color: var(--muted); background: var(--bg-soft); border: 1px solid var(--border); }
  .badge.version { color: var(--fg); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .badge.green { color: var(--green); background: color-mix(in srgb, var(--green) 12%, transparent); }
  .identity-line { display: flex; gap: 6px; flex-wrap: wrap; color: var(--muted); font-size: 12px; }
  .identity-line code { color: var(--accent); }
  .repo-button { flex: none; border: 1px solid var(--border); border-radius: 10px; padding: 8px 12px; color: var(--fg); background: var(--bg-soft); font-size: 13px; font-weight: 700; }
  .repo-button:hover { text-decoration: none; border-color: var(--border-strong); transform: translateY(-1px); }
  .description { margin: 16px 0 14px; color: var(--muted); line-height: 1.65; max-width: 900px; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px; }
  .facts span { min-width: 112px; display: grid; gap: 1px; padding: 8px 11px; border: 1px solid var(--border); border-radius: 11px; background: var(--bg-soft); }
  .facts b { font-size: 13px; color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .facts i { color: var(--muted); font-style: normal; font-size: 10.5px; }
  .install-card { display: flex; align-items: center; gap: 14px; margin-top: 18px; padding: 13px; border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border)); border-radius: 13px; background: var(--accent-soft); }
  .install-copy { flex: 1; min-width: 0; display: grid; gap: 5px; }
  .install-copy small { color: var(--muted); }
  .install-copy code { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--fg); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .actions a, .actions button { border: 1px solid var(--border); border-radius: 9px; background: var(--card); color: var(--fg); padding: 8px 11px; font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }
  .actions .primary { color: #fff; background: var(--accent); border-color: var(--accent); }
  .actions a:hover { text-decoration: none; }
  @media (max-width: 720px) {
    .marketplace-detail-hero { padding: 18px; }
    .hero-main { align-items: flex-start; flex-wrap: wrap; }
    .repo-button { margin-left: 74px; }
    .install-card { align-items: stretch; flex-direction: column; }
    .actions { justify-content: flex-start; }
  }
</style>
