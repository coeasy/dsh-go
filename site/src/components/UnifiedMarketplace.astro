---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { apiUrl, u } from '../lib/urls';
import { fmtK } from '../lib/format';
import { DETAIL_THRESHOLD } from '../lib/threshold';
import {
  HOME_MAX_STARS,
  HOME_MIN_STARS,
  HOME_TOP_LIMIT,
  ecosystemType,
  isDiscoveryAggregator,
  marketplaceScore,
  normalizeRepo,
} from '../lib/marketplace';

interface Props { compactHero?: boolean; }
const { compactHero = false } = Astro.props;

let catalog: any = { meta: {}, plugins: [] };
let registry: any = { plugins: [] };
try { catalog = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf8')); } catch { /* optional in isolated builds */ }
try { registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf8')); } catch { /* optional in isolated builds */ }

const catalogPlugins = (catalog.plugins || []).filter((plugin: any) => !plugin.deprecated && !plugin.disabled);
const catalogByRepo = new Map<string, any>();
for (const plugin of catalogPlugins) {
  const repo = normalizeRepo(plugin.full_name || plugin.repo_url);
  if (repo) catalogByRepo.set(repo, plugin);
}

const latestRegistryByIdentity = new Map<string, any>();
for (const entry of registry.plugins || []) {
  const type = ecosystemType(entry);
  const key = `${type}:${String(entry.id || '')}`;
  const current = latestRegistryByIdentity.get(key);
  if (!current || String(entry.version || '').localeCompare(String(current.version || ''), undefined, { numeric: true }) > 0) {
    latestRegistryByIdentity.set(key, entry);
  }
}

const registryRepos = new Set<string>();
const registryItems = [...latestRegistryByIdentity.values()].map((entry: any) => {
  const repo = normalizeRepo(entry.source?.repo);
  if (repo) registryRepos.add(repo);
  const legacy = repo ? catalogByRepo.get(repo) : null;
  const type = ecosystemType(entry);
  const stars = Number(legacy?.stars ?? entry.metadata?.stars ?? 0);
  const version = String(entry.version || '0.1.0');
  const itemRepo = entry.source?.repo || legacy?.full_name || '';
  const detail = stars >= DETAIL_THRESHOLD ? `${u(`/ecosystem/${encodeURIComponent(entry.id)}`)}?type=${type}` : '';
  const sourceHref = itemRepo ? `https://github.com/${itemRepo}` : '';
  const deepLink = new URL('dsh://install');
  deepLink.searchParams.set('id', entry.id);
  deepLink.searchParams.set('version', version);
  deepLink.searchParams.set('type', type);
  const name = entry.metadata?.name || legacy?.name || entry.id;
  const description = entry.metadata?.description || legacy?.description || '';
  const capabilities = entry.capabilities || [];
  return {
    key: `registry:${type}:${entry.id}`, id: entry.id, type, name, description, version, repo: itemRepo, stars,
    verified: entry.metadata?.verified === true || legacy?.verified === true,
    language: legacy?.language || '', category: legacy?.category || type, updatedAt: legacy?.updated_at || '',
    trend: Number(legacy?.trend_score || 0), capabilities,
    dependencies: Array.isArray(entry.dependencies) ? entry.dependencies.length : 0,
    commit: entry.source?.commit || '', registryManaged: true, catalogLinked: Boolean(legacy),
    aggregator: isDiscoveryAggregator({ name, full_name: itemRepo, description, topics: capabilities, category: legacy?.category || type }),
    install: `dsh ${type} install ${entry.id}@${version}`, deepLink: deepLink.toString(), detail, sourceHref,
  };
});

const legacyOnlyItems = catalogPlugins
  .filter((plugin: any) => {
    const repo = normalizeRepo(plugin.full_name || plugin.repo_url);
    return repo && !registryRepos.has(repo);
  })
  .map((plugin: any) => {
    const stars = Number(plugin.stars || 0);
    const detail = stars >= DETAIL_THRESHOLD ? u(`/plugin/${plugin.slug}`) : '';
    const sourceHref = plugin.full_name ? `https://github.com/${plugin.full_name}` : plugin.repo_url || '';
    const id = plugin.slug || plugin.full_name;
    return {
      key: `catalog:plugin:${id}`, id, type: 'plugin' as const, name: plugin.name || plugin.full_name,
      description: plugin.description || '', version: '', repo: plugin.full_name || normalizeRepo(plugin.repo_url), stars,
      verified: plugin.verified === true, language: plugin.language || '', category: plugin.category || 'plugin',
      updatedAt: plugin.updated_at || '', trend: Number(plugin.trend_score || 0), capabilities: plugin.topics || [],
      dependencies: 0, commit: '', registryManaged: false, catalogLinked: true, aggregator: isDiscoveryAggregator(plugin),
      install: plugin.install_cmd || `dsh plugin install github:${plugin.full_name}`,
      deepLink: `dsh://install?id=${encodeURIComponent(plugin.full_name || id)}&version=*&type=plugin`, detail, sourceHref,
    };
  });

const items = [...registryItems, ...legacyOnlyItems];
const scoreOf = (item: any) => marketplaceScore({ name: item.name, stars: item.stars, trend_score: item.trend, verified: item.verified, updated_at: item.updatedAt });
const popularItems = items
  .filter((item: any) => !item.aggregator && item.stars >= HOME_MIN_STARS && item.stars <= HOME_MAX_STARS)
  .sort((left: any, right: any) => {
    if (left.registryManaged !== right.registryManaged) return left.registryManaged ? -1 : 1;
    return scoreOf(right) - scoreOf(left) || right.stars - left.stars || left.name.localeCompare(right.name);
  })
  .slice(0, HOME_TOP_LIMIT);

const typeCards = [
  { type: 'plugin', label: 'Plugins', code: 'P', description: 'Client extensions, UI, tools, and integrations.' },
  { type: 'mcp', label: 'MCP Servers', code: 'M', description: 'Standardized tools, data sources, and external service connectors.' },
  { type: 'skill', label: 'Skills', code: 'S', description: 'Reusable capabilities, prompts, and execution units.' },
  { type: 'agent', label: 'Agents', code: 'A', description: 'Task-oriented automation, collaboration, and workflows.' },
] as const;
const types = typeCards.map((item) => item.type);
const counts = Object.fromEntries(types.map((type) => [type, items.filter((item: any) => item.type === type).length]));
const registryCount = registryItems.length;
const aggregatorCount = items.filter((item: any) => item.aggregator).length;
const giantCount = items.filter((item: any) => item.stars > 10000).length;
const updatedAt = registry.generated?.at || catalog.meta?.updated_at;
const updatedLabel = updatedAt ? new Date(updatedAt).toISOString().slice(0, 10) : '—';
---

<section class:list={['market-hero', compactHero && 'compact']}>
  <span class="eyebrow">DSH Plugin Marketplace · Registry V3</span>
  <h1>Discover and install the <span class="grad-text">DSH Ecosystem</span></h1>
  <p>Discover Plugin, MCP, Skill, and Agent packages in one place with aligned versions and local installation.</p>
  <div class="hero-actions"><a class="primary" href="#market-grid">Explore Top {HOME_TOP_LIMIT}</a><button class="secondary" type="button" data-show-all>Browse all packages</button></div>
  <div class="metrics">
    <span><b>{items.length}</b><i>packages</i></span><span><b>{registryCount}</b><i>Registry V3</i></span><span><b>{popularItems.length}</b><i>recommended</i></span><span><b>{updatedLabel}</b><i>updated</i></span>
  </div>
</section>

<section class="category-section" aria-labelledby="ecosystem-categories">
  <div class="section-heading"><div><span class="section-kicker">Browse by ecosystem type</span><h2 id="ecosystem-categories">Discover resources by ecosystem type</h2></div><span class="section-note">The homepage recommends standalone resources only; aggregation lists are excluded.</span></div>
  <div class="category-grid">
    {typeCards.map((item) => <button class={`category-card ${item.type}`} type="button" data-category-filter={item.type}><span class="category-icon">{item.code}</span><span class="category-copy"><strong>{item.label}</strong><small>{item.description}</small></span><span class="category-count">{counts[item.type]}</span></button>)}
  </div>
</section>

<section class="market-facts" aria-label="marketplace discovery policy">
  <div><strong>Top100 · {HOME_MIN_STARS}–{fmtK(HOME_MAX_STARS)} stars</strong><span>Excludes {giantCount} repositories with 10k+ stars and {aggregatorCount} awesome / aggregation-list projects.</span></div>
  <div><strong>Registry V3 = install authority</strong><span>Registry is authoritative for type, version, commit, and capabilities.</span></div>
  <div><strong>Local installation</strong><span>Open in DSH or copy the exact CLI command; restart manually only when required.</span></div>
</section>

<section class="market-toolbar" aria-label="marketplace filters">
  <div class="search-wrap"><span aria-hidden="true">⌕</span><input id="market-search" type="search" placeholder="Search package, GitHub repo, capability…" autocomplete="off" /><kbd>/</kbd></div>
  <div class="filter-row"><button class="market-filter active" type="button" data-market-filter="popular">Recommended <small>{popularItems.length}</small></button><button class="market-filter" type="button" data-market-filter="all">All <small>{items.length}</small></button><label class="check-filter"><input id="market-verified" type="checkbox" /> Verified</label><label class="check-filter"><input id="market-registry" type="checkbox" /> Registry only</label></div>
</section>

<div class="result-line"><span id="market-count" data-count={popularItems.length}>{popularItems.length} recommended ecosystem resources</span><span class="result-links"><a href={u('/profiles')}>Profiles / Bundles</a><a href={u('/trending')}>Trending</a><a href={apiUrl('/api/v1/search')}>Search API ↗</a></span></div>

<section id="market-grid" class="market-grid" data-detail-threshold={DETAIL_THRESHOLD} data-market-index-url={u('/catalog/search-index-v2.json')} data-market-detail-base={u('/ecosystem/')}>
  {popularItems.map((item: any) => {
    const itemUpdated = item.updatedAt ? new Date(item.updatedAt).toISOString().slice(0, 10) : '';
    const browseHref = item.detail || item.sourceHref || item.deepLink;
    const external = !item.detail && Boolean(item.sourceHref);
    return (
      <article class="market-card" data-type={item.type} data-key={item.key} data-popular="true" data-verified={String(item.verified)} data-registry={String(item.registryManaged)} data-aggregator={String(item.aggregator)} data-search={`${item.type}:${item.id} ${item.name} ${item.repo} ${item.description} ${item.language} ${item.category} ${(item.capabilities || []).join(' ')}`.toLowerCase()}>
        <a class="card-main" href={browseHref} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
          <div class="card-top"><span class={`kind ${item.type}`}>{item.type.toUpperCase()}</span>{item.registryManaged ? <span class="source registry">Registry v{item.version}</span> : <span class="source catalog">Catalog only</span>}{item.verified && <span class="verified">✓</span>}<span class="stars">{item.stars > 0 ? `★ ${fmtK(item.stars)}` : 'New'}</span></div>
          <h2>{item.name}</h2><p class="repo">{item.repo || `${item.type}:${item.id}`}</p><p class="description">{item.description || 'No description available'}</p>
          <div class="meta-row">{item.language && <span>{item.language}</span>}{itemUpdated && <span data-i18n-kind="updated" data-i18n-value={itemUpdated}>Updated {itemUpdated}</span>}{item.dependencies > 0 && <span data-i18n-kind="deps" data-i18n-value={item.dependencies}>{item.dependencies} deps</span>}{item.commit && <span data-i18n-kind="commit" data-i18n-value={item.commit.slice(0, 8)} title={item.commit}>commit {item.commit.slice(0, 8)}</span>}{item.catalogLinked && item.registryManaged && <span data-i18n-kind="catalog-linked">Catalog linked</span>}</div>
          <div class="caps">{(item.capabilities || []).slice(0, 6).map((capability: string) => <span>{capability}</span>)}</div>
        </a>
        <div class="card-actions">{item.detail ? <a class="ghost" data-action="details" href={item.detail}>Details</a> : item.sourceHref ? <a class="ghost" href={item.sourceHref} target="_blank" rel="noopener noreferrer">GitHub ↗</a> : null}<a class="install" data-action="open-dsh" href={item.deepLink}>Open in DSH</a><button class="ghost" type="button" data-copy-command={item.install}>Copy CLI</button></div>
      </article>
    );
  })}
</section>
<div id="market-empty" class="empty" hidden>No matching ecosystem resources.</div>

<script>
  const grid = document.querySelector<HTMLElement>('#market-grid');
  const search = document.querySelector<HTMLInputElement>('#market-search');
  const verified = document.querySelector<HTMLInputElement>('#market-verified');
  const registryOnly = document.querySelector<HTMLInputElement>('#market-registry');
  const count = document.querySelector<HTMLElement>('#market-count');
  const empty = document.querySelector<HTMLElement>('#market-empty');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-market-filter]')];
  const categories = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  const showAll = document.querySelector<HTMLButtonElement>('[data-show-all]');
  const indexUrl = grid?.dataset.marketIndexUrl || '';
  const detailBase = grid?.dataset.marketDetailBase || '/ecosystem/';
  const detailThreshold = Number(grid?.dataset.detailThreshold || 200);
  const pageSize = 120;
  const initialCards = [...document.querySelectorAll<HTMLElement>('.market-card')];
  const initialPopularKeys = new Set(initialCards.map((card) => card.dataset.key).filter(Boolean));
  let cards = initialCards;
  let activeFilter = 'popular';
  let allItems: any[] | null = null;
  let allItemsPromise: Promise<any[]> | null = null;
  let renderLimit = pageSize;
  let refreshGeneration = 0;

  const runtimeText: Record<string, Record<string, string>> = {
    en:{ loading:'Loading full ecosystem index…', unavailable:'The full ecosystem index is temporarily unavailable', load:'Load more' },
    'zh-CN':{ loading:'正在加载完整生态索引…', unavailable:'完整生态索引暂时不可用', load:'加载更多' },
    ja:{ loading:'エコシステム全体のインデックスを読み込み中…', unavailable:'完全なエコシステムインデックスは一時的に利用できません', load:'さらに読み込む' },
    ko:{ loading:'전체 생태계 인덱스를 불러오는 중…', unavailable:'전체 생태계 인덱스를 일시적으로 사용할 수 없습니다', load:'더 보기' },
    es:{ loading:'Cargando el índice completo del ecosistema…', unavailable:'El índice completo del ecosistema no está disponible temporalmente', load:'Cargar más' },
  };
  function ui(key: string) { const lang = document.documentElement.lang || 'en'; return (runtimeText[lang] || runtimeText.en)[key] || runtimeText.en[key] || key; }
  function escapeHtml(value: unknown) { return String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[character] || character)); }
  function validType(value: unknown) { const type = String(value || '').toLowerCase(); return ['plugin','mcp','skill','agent'].includes(type) ? type : 'plugin'; }
  function isAggregator(item: any) { const text=[item.id,item.name,item.repo,item.description,...(Array.isArray(item.capabilities)?item.capabilities:[]),...(Array.isArray(item.tokens)?item.tokens:[])].filter(Boolean).join(' ').toLowerCase(); return /(?:^|[\s/_-])(?:awesome|curated(?:-list)?)(?:$|[\s/_-])/.test(text)||/\b(?:plugins?|mcp|skills?|agents?|tools?|resources?)[\s_-]*(?:list|directory|collection)\b/.test(text)||/\b(?:list|directory|collection)[\s_-]+of[\s_-]+(?:plugins?|tools?|resources?|agents?|skills?|mcp|servers?)\b/.test(text); }
  function normalizeIndexItem(raw: any) { const id=String(raw?.id||'').trim(); if(!id)return null; const type=validType(raw.type); return { key:`registry:${type}:${id}`, id, type, name:String(raw.name||id), description:String(raw.description||''), version:String(raw.version||'0.1.0'), repo:String(raw.repo||''), stars:Number.isFinite(Number(raw.stars))?Number(raw.stars):0, verified:raw.verified===true, language:String(raw.language||''), category:String(raw.category||type), updatedAt:String(raw.updated_at||raw.updatedAt||''), trend:Number.isFinite(Number(raw.trend_score))?Number(raw.trend_score):0, capabilities:Array.isArray(raw.capabilities)?raw.capabilities.map(String).slice(0,20):[], dependencies:Number.isFinite(Number(raw.dependencies))?Number(raw.dependencies):0, commit:String(raw.commit||''), registryManaged:true, aggregator:isAggregator(raw), tokens:Array.isArray(raw.tokens)?raw.tokens:[] }; }
  function isPopular(item:any){ return initialPopularKeys.has(item.key)||(!item.aggregator&&item.stars>=100&&item.stars<=5000); }
  function hasDetail(item:any){ return Number(item.stars||0)>=detailThreshold; }
  function detailHref(item:any){ const base=detailBase.endsWith('/')?detailBase:`${detailBase}/`; return `${base}${encodeURIComponent(item.id)}?type=${encodeURIComponent(item.type)}`; }
  function sourceHref(item:any){ return item.repo&&/^[\w.-]+\/[\w.-]+$/.test(item.repo)?`https://github.com/${item.repo}`:''; }
  function deepLink(item:any){ return `dsh://install?id=${encodeURIComponent(item.id)}&version=${encodeURIComponent(item.version)}&type=${encodeURIComponent(item.type)}`; }
  function searchText(item:any){ return [item.type,item.id,item.name,item.repo,item.description,item.language,item.category,...(item.capabilities||[])].join(' ').toLowerCase(); }
  function cardMarkup(item:any){
    const detail=hasDetail(item)?detailHref(item):''; const source=sourceHref(item); const browse=detail||source||deepLink(item); const external=!detail&&Boolean(source);
    const updated=item.updatedAt?new Date(item.updatedAt).toISOString().slice(0,10):'';
    const caps=(item.capabilities||[]).slice(0,6).map((cap:string)=>`<span>${escapeHtml(cap)}</span>`).join('');
    const meta=[item.language&&`<span>${escapeHtml(item.language)}</span>`,updated&&`<span data-i18n-kind="updated" data-i18n-value="${escapeHtml(updated)}">Updated ${escapeHtml(updated)}</span>`,item.dependencies>0&&`<span data-i18n-kind="deps" data-i18n-value="${item.dependencies}">${item.dependencies} deps</span>`,item.commit&&`<span data-i18n-kind="commit" data-i18n-value="${escapeHtml(item.commit.slice(0,8))}" title="${escapeHtml(item.commit)}">commit ${escapeHtml(item.commit.slice(0,8))}</span>`].filter(Boolean).join('');
    const action=detail?`<a class="ghost" data-action="details" href="${escapeHtml(detail)}">Details</a>`:source?`<a class="ghost" href="${escapeHtml(source)}" target="_blank" rel="noopener noreferrer">GitHub ↗</a>`:'';
    const install=`dsh ${item.type} install ${item.id}@${item.version}`;
    return `<article class="market-card" data-type="${escapeHtml(item.type)}" data-key="${escapeHtml(item.key)}" data-popular="${isPopular(item)}" data-verified="${item.verified}" data-registry="true" data-aggregator="${item.aggregator}" data-search="${escapeHtml(searchText(item))}"><a class="card-main" href="${escapeHtml(browse)}"${external?' target="_blank" rel="noopener noreferrer"':''}><div class="card-top"><span class="kind ${escapeHtml(item.type)}">${escapeHtml(item.type.toUpperCase())}</span><span class="source registry">Registry v${escapeHtml(item.version)}</span>${item.verified?'<span class="verified">✓</span>':''}<span class="stars">${item.stars>0?`★ ${Number(item.stars).toLocaleString()}`:'New'}</span></div><h2>${escapeHtml(item.name)}</h2><p class="repo">${escapeHtml(item.repo||`${item.type}:${item.id}`)}</p><p class="description">${escapeHtml(item.description||'No description available')}</p><div class="meta-row">${meta}</div><div class="caps">${caps}</div></a><div class="card-actions">${action}<a class="install" data-action="open-dsh" href="${escapeHtml(deepLink(item))}">Open in DSH</a><button class="ghost" type="button" data-copy-command="${escapeHtml(install)}">Copy CLI</button></div></article>`;
  }
  async function fetchAllItems(){ if(!indexUrl)throw new Error('Marketplace search index is not configured'); const response=await fetch(indexUrl,{headers:{accept:'application/json'}}); if(!response.ok)throw new Error(`Marketplace search index returned HTTP ${response.status}`); const payload=await response.json(); if(!Array.isArray(payload.items))throw new Error('Marketplace search index has an invalid shape'); return payload.items.map(normalizeIndexItem).filter(Boolean).sort((a:any,b:any)=>Number(isPopular(b))-Number(isPopular(a))||b.stars-a.stars||a.name.localeCompare(b.name)); }
  function ensureAllItems(){ if(allItems)return Promise.resolve(allItems); if(!allItemsPromise)allItemsPromise=fetchAllItems().then((value)=>{allItems=value;return value;}).catch((error)=>{allItemsPromise=null;throw error;}); return allItemsPromise; }
  function syncCount(value:number){ if(count){ count.dataset.count=String(value); count.textContent=String(value); } document.dispatchEvent(new CustomEvent('dsh:marketplacerender')); }
  function applyInitialFilters(){ const keyword=(search?.value||'').trim().toLowerCase(); const verifiedOnly=verified?.checked===true; const registryRequired=registryOnly?.checked===true; let visible=0; for(const card of cards){ const typeMatch=activeFilter==='all'||(activeFilter==='popular'?card.dataset.popular==='true':card.dataset.type===activeFilter); const show=typeMatch&&(!keyword||(card.dataset.search||'').includes(keyword))&&(!verifiedOnly||card.dataset.verified==='true')&&(!registryRequired||card.dataset.registry==='true'); card.hidden=!show; if(show)visible++; } syncCount(visible); if(empty)empty.hidden=visible!==0; }
  function applyDynamicFilters(){ if(!grid||!allItems)return; const keyword=(search?.value||'').trim().toLowerCase(); const filtered=allItems.filter((item)=>{ const typeMatch=activeFilter==='all'||(activeFilter==='popular'?isPopular(item):item.type===activeFilter); return typeMatch&&(!keyword||searchText(item).includes(keyword))&&(!verified?.checked||item.verified)&&(!registryOnly?.checked||item.registryManaged); }); const visible=filtered.slice(0,renderLimit); grid.innerHTML=visible.map(cardMarkup).join(''); if(filtered.length>visible.length){ const more=document.createElement('button'); more.className='load-more'; more.type='button'; more.textContent=`${ui('load')} (${visible.length} / ${filtered.length})`; more.addEventListener('click',()=>{renderLimit+=pageSize;applyDynamicFilters();}); grid.append(more); } cards=[...grid.querySelectorAll<HTMLElement>('.market-card')]; syncCount(filtered.length); if(empty)empty.hidden=filtered.length!==0; }
  function needsIndex(){ return Boolean((search?.value||'').trim())||activeFilter!=='popular'||verified?.checked===true||registryOnly?.checked===true; }
  async function refresh(){ const generation=++refreshGeneration; if(needsIndex()&&!allItems){ if(count)count.textContent=ui('loading'); try{await ensureAllItems();}catch(error){if(generation!==refreshGeneration)return;if(count)count.textContent=ui('unavailable');if(empty){empty.hidden=false;empty.textContent=error instanceof Error?error.message:ui('unavailable');}return;} } if(generation!==refreshGeneration)return; if(allItems)applyDynamicFilters(); else applyInitialFilters(); }
  function setFilter(filter:string){ activeFilter=filter; for(const button of filters)button.classList.toggle('active',button.dataset.marketFilter===filter); for(const button of categories)button.classList.toggle('active',button.dataset.categoryFilter===filter); renderLimit=pageSize; void refresh(); }
  search?.addEventListener('input',()=>{renderLimit=pageSize;void refresh();}); verified?.addEventListener('change',()=>{renderLimit=pageSize;void refresh();}); registryOnly?.addEventListener('change',()=>{renderLimit=pageSize;void refresh();}); for(const button of filters)button.addEventListener('click',()=>setFilter(button.dataset.marketFilter||'popular')); for(const button of categories)button.addEventListener('click',()=>{setFilter(button.dataset.categoryFilter||'all');document.querySelector('.market-toolbar')?.scrollIntoView({behavior:'smooth',block:'center'});}); showAll?.addEventListener('click',()=>{setFilter('all');grid?.scrollIntoView({behavior:'smooth',block:'start'});});
  grid?.addEventListener('click',async(event)=>{ const target=event.target; if(!(target instanceof Element))return; const button=target.closest<HTMLButtonElement>('[data-copy-command]'); if(!button)return; const command=button.dataset.copyCommand||''; try{await navigator.clipboard.writeText(command);}catch{window.prompt(grid?.dataset.copyPrompt||'Copy the local install command',command);} button.dataset.copyState='copied'; button.textContent=grid?.dataset.copiedLabel||'Copied'; window.setTimeout(()=>{button.dataset.copyState='';button.textContent=grid?.dataset.copyLabel||'Copy CLI';},1200); });
  document.addEventListener('keydown',(event)=>{if(event.key==='/'&&document.activeElement!==search){event.preventDefault();search?.focus();}});
</script>

<style>
