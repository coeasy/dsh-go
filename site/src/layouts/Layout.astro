---
import { u, apiUrl } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'DSH Go', description = 'DeepSeek Harness 插件市场导航站' } = Astro.props;
const SITE = import.meta.env.PUBLIC_SITE_URL || 'https://dsh-go.pages.dev';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="canonical" href={`${SITE}${Astro.url.pathname}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DSH Go" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${SITE}${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary" />

    <style>
      /* ---------- 设计系统 ---------- */
      :root {
        --bg: #f6f8fb; --bg-soft: #eef2f7; --card: #ffffff; --fg: #0f172a; --muted: #64748b;
        --border: #e2e8f0; --border-strong: #cbd5e1;
        --accent: #2563eb; --accent-2: #7c3aed; --accent-soft: #eff6ff;
        --green: #16a34a; --amber: #f59e0b; --red: #ef4444;
        --shadow-sm: 0 1px 2px rgb(15 23 42 / .05);
        --shadow-md: 0 4px 16px rgb(15 23 42 / .08);
        --shadow-lg: 0 12px 32px rgb(15 23 42 / .12);
        --grad-accent: linear-gradient(135deg, #2563eb, #7c3aed);
        --radius: 14px;
      }
      html.dark {
        --bg: #0b1120; --bg-soft: #111a2e; --card: #10192c; --fg: #f1f5f9; --muted: #94a3b8;
        --border: #1e293b; --border-strong: #334155;
        --accent: #60a5fa; --accent-2: #a78bfa; --accent-soft: #16233d;
        --green: #4ade80; --amber: #fbbf24; --red: #f87171;
        --shadow-sm: 0 1px 2px rgb(0 0 0 / .3);
        --shadow-md: 0 4px 16px rgb(0 0 0 / .35);
        --shadow-lg: 0 12px 32px rgb(0 0 0 / .45);
        --grad-accent: linear-gradient(135deg, #3b82f6, #8b5cf6);
      }
      html.light {
        --bg: #f6f8fb; --bg-soft: #eef2f7; --card: #ffffff; --fg: #0f172a; --muted: #64748b;
        --border: #e2e8f0; --border-strong: #cbd5e1;
        --accent: #2563eb; --accent-2: #7c3aed; --accent-soft: #eff6ff;
        --green: #16a34a; --amber: #f59e0b; --red: #ef4444;
      }
      @media (prefers-color-scheme: dark) {
        html:not(.light):not(.dark) {
          --bg: #0b1120; --bg-soft: #111a2e; --card: #10192c; --fg: #f1f5f9; --muted: #94a3b8;
          --border: #1e293b; --border-strong: #334155;
          --accent: #60a5fa; --accent-2: #a78bfa; --accent-soft: #16233d;
          --green: #4ade80; --amber: #fbbf24; --red: #f87171;
          --grad-accent: linear-gradient(135deg, #3b82f6, #8b5cf6);
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0; font-family: system-ui, -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
        background: var(--bg); color: var(--fg); line-height: 1.6;
        font-variant-numeric: tabular-nums;
        -webkit-font-smoothing: antialiased;
      }
      /* 顶部渐变光斑背景装饰 */
      body::before {
        content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
        background:
          radial-gradient(600px 300px at 15% -5%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%),
          radial-gradient(500px 260px at 85% -10%, color-mix(in srgb, var(--accent-2) 8%, transparent), transparent 70%);
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

      /* ---------- 导航 ---------- */
      header.nav {
        position: sticky; top: 0; z-index: 10;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
        border-bottom: 1px solid var(--border);
      }
      .nav-inner { max-width: 1120px; margin: 0 auto; padding: 12px 20px; display: flex; align-items: center; gap: 16px; }
      .brand { font-weight: 800; font-size: 17px; display: flex; align-items: center; gap: 9px; letter-spacing: -.01em; }
      .brand img { width: 24px; height: 24px; border-radius: 6px; }
      .brand:hover { text-decoration: none; color: var(--fg); }
      .brand:hover img { transform: rotate(12deg) scale(1.08); }
      .brand img { transition: transform .25s cubic-bezier(.34,1.56,.64,1); }
      .nav-links { display: flex; gap: 4px; margin-left: auto; font-size: 14px; color: var(--muted); align-items: center; }
      .nav-links a {
        color: var(--muted); padding: 6px 12px; border-radius: 999px;
        transition: color .15s, background .15s;
      }
      .nav-links a:hover { color: var(--fg); background: var(--bg-soft); text-decoration: none; }
      .nav-links a.active { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
      .nav-btn {
        border: 1px solid var(--border); background: var(--card); color: var(--muted);
        border-radius: 999px; padding: 5px 12px; font-size: 13px; font-weight: 600; cursor: pointer; min-width: 42px;
        transition: color .15s, border-color .15s, box-shadow .15s, transform .15s;
        box-shadow: var(--shadow-sm);
      }
      .nav-btn:hover { color: var(--fg); border-color: var(--border-strong); box-shadow: var(--shadow-md); transform: translateY(-1px); }
      main { max-width: 1120px; margin: 0 auto; padding: 24px 20px 64px; }
      footer {
        border-top: 1px solid var(--border); margin-top: 48px; padding: 24px 20px;
        text-align: center; color: var(--muted); font-size: 13px;
        background: var(--bg-soft);
      }
      .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11.5px; font-weight: 600; letter-spacing: .01em; }
      .badge.green { background: color-mix(in srgb, var(--green) 14%, transparent); color: var(--green); }
      .badge.amber { background: color-mix(in srgb, var(--amber) 15%, transparent); color: var(--amber); }
      .badge.gray { background: color-mix(in srgb, var(--muted) 13%, transparent); color: var(--muted); }
      .badge.grad { background: var(--grad-accent); color: #fff; }

      /* 通用标题渐变 */
      .grad-text {
        background: var(--grad-accent); -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent; color: transparent;
      }

      @media (max-width: 640px) {
        .nav-links { gap: 0; }
        .nav-links a { padding: 6px 8px; font-size: 13px; }
      }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={u('/')}><img src={u('/favicon.svg')} alt="logo" />DSH <span class="grad-text">Go</span></a>
        <nav class="nav-links" data-path={Astro.url.pathname.replace(/\/$/, '') || '/'}>
          <a href={u('/')} data-i18n="nav_home" data-nav="/">首页</a>
          <a href={u('/docs')} data-i18n="nav_docs" data-nav={u('/docs')}>API 文档</a>
          <a href={u('/stats')} data-i18n="nav_stats" data-nav={u('/stats')}>统计</a>
          <a href={u('/feed.xml')} target="_blank" data-i18n="nav_rss">RSS</a>
          <button id="lang-toggle" class="nav-btn" type="button" title="Switch language">EN</button>
          <button id="theme-toggle" class="nav-btn" type="button" aria-label="theme" title="Toggle theme">🌙</button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span data-i18n="footer" data-api={apiUrl('/api/v1/health')}>DSH Go · 数据每日自动同步自 GitHub topic:dsh-plugin · <a href="/api/v1/health">API 状态</a></span>
    </footer>

    <script>
      import { initI18n } from '../scripts/i18n';
      initI18n();
    </script>
  </body>
</html>
