---
import { u, apiUrl } from '../lib/urls';
import { LANGUAGE_LABELS, SUPPORTED_LANGS } from '../i18n/config';
import { message } from '../i18n/messages';

interface Props { title?: string; description?: string }
const { title = 'DSH Marketplace', description = 'DeepSeek Harness Plugin / MCP / Skill / Agent Marketplace' } = Astro.props;
const SITE = import.meta.env.PUBLIC_SITE_URL || 'https://dsh-go.pages.dev';
const CANONICAL_URL = new URL(Astro.url.pathname, SITE).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="manifest" href={u('/manifest.webmanifest')} />
    <meta name="theme-color" content="#2563eb" />
    <link rel="canonical" href={CANONICAL_URL} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DSH Marketplace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={CANONICAL_URL} />
    <style>
      :root{--bg:#f7f9fc;--bg-soft:#eef2f7;--card:#fff;--fg:#0f172a;--muted:#64748b;--border:#e2e8f0;--border-strong:#cbd5e1;--accent:#2563eb;--accent-2:#7c3aed;--accent-soft:#eff6ff;--green:#16a34a;--amber:#f59e0b;--red:#ef4444;--shadow-sm:0 1px 2px rgb(15 23 42/.05);--shadow-md:0 5px 18px rgb(15 23 42/.08);--shadow-lg:0 14px 36px rgb(15 23 42/.12);--content-max:1560px}html.dark{--bg:#0b1120;--bg-soft:#111a2e;--card:#10192c;--fg:#f1f5f9;--muted:#94a3b8;--border:#1e293b;--border-strong:#334155;--accent:#60a5fa;--accent-2:#a78bfa;--accent-soft:#16233d;--green:#4ade80;--amber:#fbbf24;--red:#f87171;--shadow-sm:0 1px 2px rgb(0 0 0/.3);--shadow-md:0 5px 18px rgb(0 0 0/.35);--shadow-lg:0 14px 36px rgb(0 0 0/.45)}@media(prefers-color-scheme:dark){html:not(.light):not(.dark){--bg:#0b1120;--bg-soft:#111a2e;--card:#10192c;--fg:#f1f5f9;--muted:#94a3b8;--border:#1e293b;--border-strong:#334155;--accent:#60a5fa;--accent-2:#a78bfa;--accent-soft:#16233d;--green:#4ade80;--amber:#fbbf24;--red:#f87171}}*{box-sizing:border-box}html{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--fg);scroll-behavior:smooth}body{margin:0;line-height:1.6;-webkit-font-smoothing:antialiased}a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.nav{position:sticky;top:0;z-index:50;border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(18px)}.nav-inner{max-width:var(--content-max);margin:auto;padding:12px 28px;display:flex;align-items:center;gap:16px}.brand{display:flex;align-items:center;gap:9px;color:var(--fg);font-weight:900}.brand img{width:28px;height:28px}.brand small{color:var(--muted);font-size:10px;letter-spacing:.1em}.nav-links{display:flex;align-items:center;gap:5px;margin-left:auto}.nav-links a{padding:7px 10px;border-radius:999px;color:var(--muted);font-size:12px;font-weight:700;white-space:nowrap}.nav-links a.active,.nav-links a:hover{background:var(--accent-soft);color:var(--accent);text-decoration:none}.nav-select,.nav-btn{min-height:34px;border:1px solid var(--border);border-radius:999px;background:var(--card);color:var(--fg);padding:0 10px;font:inherit;font-size:11px}.nav-btn{min-width:38px;cursor:pointer}main{max-width:var(--content-max);margin:auto;padding:22px 28px 78px}footer{border-top:1px solid var(--border);background:var(--bg-soft)}.footer-inner{max-width:var(--content-max);margin:auto;padding:24px 28px;display:flex;justify-content:space-between;gap:18px;color:var(--muted);font-size:12px}.footer-links{display:flex;gap:12px;flex-wrap:wrap}.badge{display:inline-block;padding:3px 8px;border-radius:999px;font-size:11px;font-weight:800}.badge.green{color:var(--green);background:color-mix(in srgb,var(--green) 14%,transparent)}.badge.amber{color:var(--amber);background:color-mix(in srgb,var(--amber) 14%,transparent)}@media(max-width:980px){.nav-inner{align-items:flex-start;flex-wrap:wrap;padding-inline:18px}.brand small{display:none}.nav-links{width:100%;margin-left:0;overflow-x:auto}main{padding:20px 18px 60px}.footer-inner{padding:22px 18px;flex-direction:column}}@media(max-width:520px){main{padding-inline:14px}.footer-inner{padding-inline:14px}}
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={u('/')}><img src={u('/favicon.svg')} alt="DSH" /><span>DSH Marketplace</span><small>Registry V4</small></a>
        <nav class="nav-links" data-path={Astro.url.pathname.replace(/\/$/, '') || '/'}>
          <a href={u('/')} data-nav="/" data-msg="marketplace">{message('marketplace')}</a>
          <a href={u('/trust')} data-nav={u('/trust')} data-msg="trust">{message('trust')}</a>
          <a href={u('/publishers/')} data-nav={u('/publishers')} data-msg="publishers">{message('publishers')}</a>
          <a href={u('/trending')} data-nav={u('/trending')} data-msg="trending">{message('trending')}</a>
          <a href={u('/stats')} data-nav={u('/stats')} data-msg="stats">{message('stats')}</a>
          <a href={u('/docs')} data-nav={u('/docs')} data-msg="docs">{message('docs')}</a>
          <select id="lang-select" class="nav-select" aria-label="Language">{SUPPORTED_LANGS.map((lang) => <option value={lang}>{LANGUAGE_LABELS[lang]}</option>)}</select>
          <button id="theme-toggle" class="nav-btn" type="button" aria-label="Toggle theme">◐</button>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-inner">
        <span data-msg="footer_summary">{message('footer_summary')}</span>
        <span class="footer-links"><a href={apiUrl('/api/v2/health')}>API V2</a><a href={apiUrl('/api/v2/capabilities')}>Capabilities</a><a href={u('/docs')} data-msg="docs">{message('docs')}</a></span>
      </div>
    </footer>
    <script>
      import { initI18n } from '../scripts/i18n';
      import { initTheme } from '../scripts/theme';
      initI18n(); initTheme();
    </script>
  </body>
</html>
