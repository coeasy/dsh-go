---
import { u, apiUrl } from '../lib/urls';
import '../styles/marketplace-polish.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'DSH Plugin Marketplace', description = 'DeepSeek Harness Plugin / MCP / Skill / Agent Marketplace' } = Astro.props;
const SITE = import.meta.env.PUBLIC_SITE_URL || 'https://dsh-go.pages.dev';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="manifest" href={u('/manifest.webmanifest')} />
    <meta name="theme-color" content="#2563eb" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="DSH Marketplace" />
    <link rel="apple-touch-icon" href={u('/favicon.svg')} />
    <link rel="canonical" href={`${SITE}${Astro.url.pathname}`} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DSH Plugin Marketplace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${SITE}${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary" />

    <style>
      :root {
        --bg:#f7f9fc;--bg-soft:#eef2f7;--card:#fff;--fg:#0f172a;--muted:#64748b;
        --border:#e2e8f0;--border-strong:#cbd5e1;--accent:#2563eb;--accent-2:#7c3aed;--accent-soft:#eff6ff;
        --green:#16a34a;--amber:#f59e0b;--red:#ef4444;--shadow-sm:0 1px 2px rgb(15 23 42 / .05);
        --shadow-md:0 5px 18px rgb(15 23 42 / .08);--shadow-lg:0 14px 36px rgb(15 23 42 / .12);
        --grad-accent:linear-gradient(135deg,#2563eb,#7c3aed);--radius:14px;--content-max:1560px;--reading-max:1080px;
      }
      html.dark {
        --bg:#0b1120;--bg-soft:#111a2e;--card:#10192c;--fg:#f1f5f9;--muted:#94a3b8;--border:#1e293b;
        --border-strong:#334155;--accent:#60a5fa;--accent-2:#a78bfa;--accent-soft:#16233d;--green:#4ade80;
        --amber:#fbbf24;--red:#f87171;--shadow-sm:0 1px 2px rgb(0 0 0 / .3);--shadow-md:0 5px 18px rgb(0 0 0 / .35);
        --shadow-lg:0 14px 36px rgb(0 0 0 / .45);--grad-accent:linear-gradient(135deg,#3b82f6,#8b5cf6);
      }
      html.light { --bg:#f7f9fc;--bg-soft:#eef2f7;--card:#fff;--fg:#0f172a;--muted:#64748b;--border:#e2e8f0;--border-strong:#cbd5e1;--accent:#2563eb;--accent-2:#7c3aed;--accent-soft:#eff6ff;--green:#16a34a;--amber:#f59e0b;--red:#ef4444; }
      @media (prefers-color-scheme:dark) {
        html:not(.light):not(.dark) { --bg:#0b1120;--bg-soft:#111a2e;--card:#10192c;--fg:#f1f5f9;--muted:#94a3b8;--border:#1e293b;--border-strong:#334155;--accent:#60a5fa;--accent-2:#a78bfa;--accent-soft:#16233d;--green:#4ade80;--amber:#fbbf24;--red:#f87171;--grad-accent:linear-gradient(135deg,#3b82f6,#8b5cf6); }
      }
      *{box-sizing:border-box}html{scroll-behavior:smooth;font-size:16px}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--fg);font-size:16px;line-height:1.65;font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
      body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(720px 340px at 12% -8%,color-mix(in srgb,var(--accent) 10%,transparent),transparent 72%),radial-gradient(620px 320px at 90% -10%,color-mix(in srgb,var(--accent-2) 9%,transparent),transparent 72%)}
      a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:5px}
      header.nav{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(18px) saturate(1.35);-webkit-backdrop-filter:blur(18px) saturate(1.35);border-bottom:1px solid var(--border)}
      .nav-inner{max-width:var(--content-max);margin:0 auto;padding:14px 28px;display:flex;align-items:center;gap:20px}.brand{display:flex;align-items:center;gap:10px;color:var(--fg);font-size:18px;font-weight:850;letter-spacing:-.02em}.brand:hover{text-decoration:none}.brand img{width:30px;height:30px;border-radius:8px}.brand small{color:var(--muted);font-size:11px;font-weight:750;letter-spacing:.06em;text-transform:uppercase;margin-left:3px}
      .nav-links{display:flex;align-items:center;gap:5px;margin-left:auto;font-size:14px}.nav-links a{color:var(--muted);padding:8px 12px;border-radius:999px;white-space:nowrap;font-weight:600}.nav-links a:hover{color:var(--fg);background:var(--bg-soft);text-decoration:none}.nav-links a.active{color:var(--accent);background:var(--accent-soft);font-weight:800}.nav-btn{border:1px solid var(--border);background:var(--card);color:var(--muted);border-radius:999px;padding:7px 11px;font-size:13px;font-weight:750;cursor:pointer;min-width:42px;min-height:36px;box-shadow:var(--shadow-sm)}.nav-btn:hover{color:var(--fg);border-color:var(--border-strong)}
      main{max-width:var(--content-max);margin:0 auto;padding:28px 28px 84px}.grad-text{background:var(--grad-accent);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}.badge{display:inline-block;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:750}.badge.green{background:color-mix(in srgb,var(--green) 14%,transparent);color:var(--green)}.badge.amber{background:color-mix(in srgb,var(--amber) 15%,transparent);color:var(--amber)}.badge.gray{background:color-mix(in srgb,var(--muted) 13%,transparent);color:var(--muted)}
      footer{border-top:1px solid var(--border);background:color-mix(in srgb,var(--bg-soft) 74%,transparent)}.footer-inner{max-width:var(--content-max);margin:0 auto;padding:28px;display:flex;justify-content:space-between;gap:24px;color:var(--muted);font-size:13px}.footer-links{display:flex;gap:14px;flex-wrap:wrap;justify-content:flex-end}
      @media(max-width:980px){.nav-inner{align-items:flex-start;flex-wrap:wrap;padding-inline:20px}.brand small{display:none}.nav-links{width:100%;margin-left:0;overflow-x:auto;padding-bottom:3px}.nav-links a{padding:7px 10px}main{padding:24px 20px 68px}.footer-inner{padding:24px 20px;flex-direction:column}.footer-links{justify-content:flex-start}}
      @media(max-width:520px){html{font-size:15px}body{font-size:15px}.nav-inner{padding-block:11px}.brand{font-size:17px}.brand img{width:28px;height:28px}main{padding:20px 16px 56px}.footer-inner{padding:22px 16px}}
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={u('/')}><img src={u('/favicon.svg')} alt="DSH" /><span>DSH <span class="grad-text">Marketplace</span></span><small>Ecosystem</small></a>
        <nav class="nav-links" data-path={Astro.url.pathname.replace(/\/$/, '') || '/'}>
          <a href={u('/')} data-nav="/">Marketplace</a>
          <a href={u('/profiles')} data-nav={u('/profiles')}>Profiles</a>
          <a href={u('/trending')} data-nav={u('/trending')}>Trending</a>
          <a href={u('/stats')} data-nav={u('/stats')}>Stats</a>
          <a href={u('/docs')} data-nav={u('/docs')}>API</a>
          <a href={u('/feed.xml')} target="_blank">RSS</a>
          <button id="lang-toggle" class="nav-btn" type="button" title="Switch language">EN</button>
          <button id="theme-toggle" class="nav-btn" type="button" aria-label="theme" title="Toggle theme">🌙</button>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-inner">
        <span>DSH Plugin Marketplace · Registry V3 + dsh-plugin Catalog · local install only</span>
        <span class="footer-links"><a href={apiUrl('/api/v1/health')}>API health</a><a href={u('/ecosystem')}>Ecosystem alias</a><a href={u('/docs')}>Docs</a></span>
      </div>
    </footer>
    <script>
      import { initI18n } from '../scripts/i18n';
      initI18n();
    </script>
  </body>
</html>