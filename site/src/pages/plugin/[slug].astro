---
import Layout from '../../layouts/Layout.astro';
import PluginCard from '../../components/PluginCard.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u } from '../../lib/urls';
import { DETAIL_THRESHOLD } from '../../lib/threshold';
import { fmtK } from '../../lib/format';
import { buildRegistryRepoIndex, ecosystemType, primaryRegistryMatch, registryMatchesForPlugin } from '../../lib/marketplace';
import { buildMarketplaceInstallPlan, normalizeMarketplacePackageType } from '../../lib/install-command';

export async function getStaticPaths() {
  let plugins: any[] = [];
  let registryEntries: any[] = [];
  try {
    const data = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf-8'));
    plugins = data.plugins || [];
  } catch { /* no catalog means no generated detail pages */ }
  try {
    const registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf-8'));
    registryEntries = registry.plugins || [];
  } catch { /* registry alignment is optional */ }

  const registryIndex = buildRegistryRepoIndex(registryEntries);
  const detailed = plugins.filter((plugin) => !plugin.deprecated && !plugin.disabled && Number(plugin.stars || 0) >= DETAIL_THRESHOLD);

  return detailed.map((plugin) => {
    const related = detailed
      .filter((candidate) => candidate.category === plugin.category && candidate.slug !== plugin.slug)
      .sort((left, right) => Number(right.stars || 0) - Number(left.stars || 0))
      .slice(0, 6)
      .map((candidate) => ({ ...candidate, _registry: registryMatchesForPlugin(candidate, registryIndex) }));
    return {
      params: { slug: plugin.slug },
      props: { plugin, related, registryEntries: registryMatchesForPlugin(plugin, registryIndex) },
    };
  });
}

const { plugin, related, registryEntries } = Astro.props as { plugin: any; related: any[]; registryEntries: any[] };
const primaryRegistry = primaryRegistryMatch(registryEntries);
const type = ecosystemType(primaryRegistry);
const registryVersions = [...new Set(registryEntries.map((entry: any) => String(entry.version || '')).filter(Boolean))];
const catalogVersion = String(plugin.version || plugin.plugin_version || plugin.latest_version || 'catalog');
const versionMismatch = registryVersions.length > 0 && catalogVersion !== 'catalog' && !registryVersions.includes(catalogVersion);
const ecosystemHref = primaryRegistry ? `${u(`/ecosystem/${encodeURIComponent(primaryRegistry.id || plugin.slug)}`)}?type=${type}` : u('/ecosystem');

const CATEGORY_ZH: Record<string, string> = {
  'web-ui': 'Web UI 组件', desktop: '桌面端', mcp: 'MCP 工具', skills: '技能 (Skills)',
  theme: '主题', terminal: '终端工具', coding: '编码辅助', agent: 'Agent 工作流',
  vision: '视觉 / 多模态', memory: '记忆 / 存储', security: '安全', integration: '集成', tool: '通用工具', other: '其他',
};
const listedAt = plugin.first_seen ? new Date(plugin.first_seen).toLocaleDateString('zh-CN') : '—';
const updatedAt = plugin.updated_at ? new Date(plugin.updated_at).toLocaleDateString('zh-CN') : '—';
const hash = [...String(plugin.name || plugin.slug)].reduce((value: number, char: string) => (value * 31 + char.charCodeAt(0)) >>> 0, 7);
const hue = hash % 360;
const initial = String(plugin.name || '?').trim().charAt(0).toUpperCase();
const installPlan = buildMarketplaceInstallPlan({
  type: normalizeMarketplacePackageType(type),
  id: primaryRegistry?.id || plugin.full_name || plugin.slug,
  version: primaryRegistry?.version || '*',
  channel: primaryRegistry?.channel || primaryRegistry?.release_channel || 'stable',
});
const installCommand = installPlan.command;
const installDeepLink = installPlan.deepLink;
const repoHref = plugin.repo_url || `https://github.com/${plugin.full_name}`;
const readmeHref = `${repoHref}#readme`;
const issuesHref = `${repoHref.replace(/\/$/, '')}/issues`;
---

<Layout title={`${plugin.name} · DSH Plugin Marketplace`} description={plugin.description}>
  <article class="detail-shell">
    <a class="back" href={u('/')}>← Marketplace</a>

    <header class="hero-card">
      <div class="identity-row">
        <span class="avatar" style={`--h:${hue}`}>{initial}</span>
        <div class="title-col">
          <div class="eyebrow-row">
            <span class={`kind ${type}`}>{type.toUpperCase()}</span>
            <span>dsh-plugin Catalog</span>
            {primaryRegistry && <span class="registry">Registry V3</span>}
            {plugin.verified && <span class="verified">✓ Verified</span>}
          </div>
          <h1>{plugin.name}</h1>
          <a class="repo-link" href={repoHref} target="_blank" rel="noopener noreferrer">{plugin.full_name} ↗</a>
        </div>
        <div class="hero-actions">
          {primaryRegistry && <a class="secondary" href={ecosystemHref}>Registry detail</a>}
          <a class="primary" href="#install">Install guide</a>
        </div>
      </div>

      <p class="description">{plugin.description || '暂无描述'}</p>

      <div class="stat-grid">
        <span><b>★ {fmtK(plugin.stars)}</b><i>stars</i></span>
        <span><b>{fmtK(plugin.forks || 0)}</b><i>forks</i></span>
        <span><b>{fmtK(plugin.open_issues || 0)}</b><i>issues</i></span>
        <span><b>{plugin.language || '—'}</b><i>language</i></span>
        <span><b>{registryVersions[0] ? `v${registryVersions[0]}` : 'Catalog only'}</b><i>registry version</i></span>
      </div>
    </header>

    <nav class="section-nav" aria-label="detail sections">
      <a href="#overview">Overview</a>
      <a href="#install">Install</a>
      <a href="#usage">Activate & use</a>
      <a href="#versions">Versions</a>
      <a href="#metadata">Metadata</a>
    </nav>

    <div class="detail-grid">
      <main class="main-col">
        <section id="overview" class="panel">
          <div class="section-title"><span>01</span><div><h2>Overview</h2><p>Catalog 展示信息与 Registry 运行时身份在同一页面对齐，安装前先看清项目来源和包身份。</p></div></div>
          <div class="overview-grid">
            <div><small>Category</small><strong>{CATEGORY_ZH[plugin.category] || plugin.category}</strong></div>
            <div><small>Catalog identity</small><strong>{plugin.full_name || plugin.slug}</strong></div>
            <div><small>Ecosystem type</small><strong>{type.toUpperCase()}</strong></div>
            <div><small>Status</small><strong>{plugin.verified ? 'Verified' : 'Community'}</strong></div>
          </div>
          {plugin.topics?.length > 0 && <div class="topics">{plugin.topics.slice(0, 16).map((topic: string) => <span>#{topic}</span>)}</div>}
        </section>

        <section id="install" class="panel install-panel">
          <div class="section-title"><span>02</span><div><h2>Install</h2><p>详情页同时提供本地 Deep Link、精确 CLI、跨平台脚本和源码复核入口。</p></div></div>
          <div class="command-row">
            <code id="cmd">{installCommand}</code>
            <button id="copy" data-cmd={installCommand}>Copy CLI</button>
          </div>
          <div class="install-actions">
            <button class="primary" id="open-dsh" data-link={installDeepLink} data-cmd={installCommand}>Open in DSH</button>
            <a class="secondary" href={u(`/install/${plugin.slug}.sh`)} download>Linux / macOS</a>
            <a class="secondary" href={u(`/install/${plugin.slug}.ps1`)} download>Windows</a>
            <a class="secondary" href={readmeHref} target="_blank" rel="noopener noreferrer">README ↗</a>
            <a class="secondary" href={repoHref} target="_blank" rel="noopener noreferrer">Review source ↗</a>
          </div>
          <div class="install-steps">
            <div><b>1</b><strong>确认来源</strong><span>核对 GitHub repository、Verified 状态，以及是否已接入 Registry V3。</span></div>
            <div><b>2</b><strong>执行安装</strong><span>优先使用 Open in DSH，也可复制命令或下载对应平台脚本。</span></div>
            <div><b>3</b><strong>完成校验</strong><span>Registry 管理包会以 Registry 版本与固定 commit 作为运行时安装权威。</span></div>
            <div><b>4</b><strong>按需重启</strong><span>安装成功后不会自动重启客户端；restart-required 时再手动重启。</span></div>
          </div>
        </section>

        <section id="usage" class="panel">
          <div class="section-title"><span>03</span><div><h2>Activate & use</h2><p>把安装后的激活方式、配置入口和项目文档直接放在详情页，减少来回查找。</p></div></div>
          <div class="usage-grid">
            <div><small>Activation</small><strong>Manual restart only when required</strong><p>默认安装完成后保持当前客户端运行；宿主提示 restart-required 时手动重启。</p></div>
            <div><small>Runtime source</small><strong>{primaryRegistry ? `Registry V3 · v${primaryRegistry.version}` : 'Catalog / GitHub source'}</strong><p>{primaryRegistry?.source?.commit ? `Pinned commit ${String(primaryRegistry.source.commit).slice(0, 12)}` : '安装前建议复核仓库 README 与发布说明。'}</p></div>
            <div><small>Documentation</small><strong>README & configuration</strong><p><a href={readmeHref} target="_blank" rel="noopener noreferrer">查看配置、用法、依赖和项目截图 ↗</a></p></div>
            <div><small>Support</small><strong>Issues & project links</strong><p><a href={issuesHref} target="_blank" rel="noopener noreferrer">查看 Issues ↗</a>{plugin.homepage ? <> · <a href={plugin.homepage} target="_blank" rel="noopener noreferrer">Homepage ↗</a></> : null}</p></div>
          </div>
        </section>

        <section id="versions" class="panel">
          <div class="section-title"><span>04</span><div><h2>Catalog ↔ Registry versions</h2><p>版本来源分开显示，避免把 GitHub 展示元数据误当成 Runtime 可安装版本。</p></div></div>
          <div class="version-table">
            <div class="version-row"><span>dsh-plugin Catalog</span><strong>{catalogVersion}</strong><em>Discovery metadata</em></div>
            <div class="version-row"><span>Registry V3</span><strong>{registryVersions.length ? registryVersions.map((version) => `v${version}`).join(' · ') : 'Not registered'}</strong><em>Runtime install authority</em></div>
            <div class={`version-row ${versionMismatch ? 'warn' : ''}`}><span>Alignment</span><strong>{versionMismatch ? 'Version differs' : registryVersions.length ? 'Aligned identity' : 'Catalog only'}</strong><em>{versionMismatch ? '以 Registry V3 安装版本为准' : 'Repository identity 已归一'}</em></div>
          </div>
        </section>
      </main>

      <aside class="side-col">
        <section id="metadata" class="panel sticky-panel">
          <h2>Package metadata</h2>
          <dl>
            <dt>Repository</dt><dd><a href={repoHref} target="_blank" rel="noopener noreferrer">{plugin.full_name}</a></dd>
            <dt>Language</dt><dd>{plugin.language || '—'}</dd>
            <dt>License</dt><dd>{plugin.license || '—'}</dd>
            <dt>Listed</dt><dd>{listedAt}</dd>
            <dt>Updated</dt><dd>{updatedAt}</dd>
            <dt>Registry</dt><dd>{primaryRegistry ? `${type}:${primaryRegistry.id}` : 'not registered'}</dd>
            <dt>Commit</dt><dd><code>{primaryRegistry?.source?.commit ? String(primaryRegistry.source.commit).slice(0, 12) : '—'}</code></dd>
          </dl>
          <div class="side-links">
            <a href={readmeHref} target="_blank" rel="noopener noreferrer">README / Usage ↗</a>
            <a href={repoHref} target="_blank" rel="noopener noreferrer">GitHub repository ↗</a>
            {plugin.homepage && <a href={plugin.homepage} target="_blank" rel="noopener noreferrer">Project homepage ↗</a>}
          </div>
        </section>
      </aside>
    </div>
  </article>

  {related?.length > 0 && (
    <section class="related">
      <div class="related-head"><div><span class="section-kicker">Discover more</span><h2>相关推荐</h2></div><a href={u('/')}>返回 Marketplace →</a></div>
      <div class="related-grid">
        {related.map((candidate: any) => {
          const registry = primaryRegistryMatch(candidate._registry || []);
          return <PluginCard
            slug={candidate.slug} name={candidate.name} description={candidate.description} stars={candidate.stars}
            category={candidate.category} verified={candidate.verified} trend={candidate.trend_score}
            tags={candidate.topics} isNew={candidate.first_seen && (Date.now() - new Date(candidate.first_seen).getTime()) < 7 * 864e5}
            created={candidate.created_at} updated={candidate.updated_at} full_name={candidate.full_name}
            install_cmd={candidate.install_cmd} language={candidate.language}
            ecosystemType={ecosystemType(registry)} registryVersion={registry?.version || ''} registryManaged={Boolean(registry)}
          />;
        })}
      </div>
    </section>
  )}

  <script>
    const copy = document.getElementById('copy');
    copy?.addEventListener('click', async () => {
      const command = copy.getAttribute('data-cmd') || '';
      try { await navigator.clipboard.writeText(command); } catch { window.prompt('复制安装命令', command); }
      const old = copy.textContent;
      copy.textContent = '已复制 ✓';
      window.setTimeout(() => { copy.textContent = old; }, 1400);
    });

    const open = document.getElementById('open-dsh');
    open?.addEventListener('click', () => {
      const link = open.getAttribute('data-link') || '';
      if (link) window.location.href = link;
      const command = open.getAttribute('data-cmd') || '';
      if (command && navigator.clipboard) navigator.clipboard.writeText(command).catch(() => {});
    });
  </script>
</Layout>

<style>
  .detail-shell{max-width:1400px;margin:0 auto}.back{display:inline-block;margin:5px 0 16px;color:var(--muted);font-size:13.5px;font-weight:650}.hero-card,.panel{border:1px solid var(--border);background:var(--card);border-radius:20px;box-shadow:var(--shadow-sm)}.hero-card{padding:32px;position:relative;overflow:hidden}.hero-card::before{content:'';position:absolute;inset:0 0 auto;height:4px;background:var(--grad-accent)}
  .identity-row{display:flex;align-items:center;gap:18px;min-width:0}.avatar{flex:none;width:66px;height:66px;border-radius:18px;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:28px;font-weight:850;background:linear-gradient(135deg,hsl(var(--h) 70% 55%),hsl(calc(var(--h) + 40) 70% 45%));box-shadow:0 8px 22px hsl(var(--h) 60% 50% / .25)}.title-col{min-width:0}.title-col h1{margin:8px 0 2px;font-size:clamp(32px,4.2vw,48px);line-height:1.08;letter-spacing:-.035em;overflow-wrap:anywhere}.repo-link{font:13px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}.eyebrow-row{display:flex;gap:7px;flex-wrap:wrap}.eyebrow-row span{border-radius:999px;padding:4px 9px;background:var(--bg-soft);color:var(--muted);font-size:11.5px;font-weight:750}.eyebrow-row .registry{color:var(--accent);background:var(--accent-soft)}.eyebrow-row .verified{color:var(--green);background:color-mix(in srgb,var(--green) 12%,transparent)}.kind.mcp{color:#7c3aed}.kind.skill{color:#0891b2}.kind.agent{color:#db2777}.hero-actions{margin-left:auto;display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--border);border-radius:11px;padding:10px 15px;font:750 13.5px/1.3 inherit;cursor:pointer;text-decoration:none;min-height:40px}.primary{background:var(--accent);border-color:var(--accent);color:#fff}.secondary{background:var(--card);color:var(--fg)}.primary:hover,.secondary:hover{text-decoration:none;transform:translateY(-1px)}.description{color:var(--muted);font-size:16px;line-height:1.7;max-width:1040px;margin:23px 0}.stat-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.stat-grid span{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:13px;background:var(--bg-soft);padding:11px 13px;min-width:0}.stat-grid b{font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.stat-grid i{font-style:normal;color:var(--muted);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em}
  .section-nav{display:flex;gap:22px;overflow:auto;border-bottom:1px solid var(--border);margin:20px 0;padding:0 5px 12px}.section-nav a{color:var(--muted);font-size:13.5px;font-weight:750;white-space:nowrap}.section-nav a:hover{color:var(--fg);text-decoration:none}.detail-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(320px,.78fr);gap:20px;align-items:start}.main-col{display:grid;gap:20px;min-width:0}.side-col{min-width:0}.panel{padding:27px;min-width:0;scroll-margin-top:96px}.section-title{display:flex;gap:13px;align-items:flex-start;margin-bottom:19px}.section-title>span{color:var(--accent);font-size:11.5px;font-weight:850;margin-top:3px}.section-title h2,.sticky-panel h2{font-size:20px;margin:0 0 3px}.section-title p{color:var(--muted);font-size:13.5px;line-height:1.55;margin:0}.overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.overview-grid div{border:1px solid var(--border);border-radius:12px;padding:13px;background:var(--bg-soft);min-width:0}.overview-grid small{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.overview-grid strong{display:block;margin-top:3px;font-size:14px;overflow-wrap:anywhere}.topics{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}.topics span{color:var(--muted);background:var(--bg-soft);border-radius:999px;padding:4px 9px;font-size:12px}.command-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px}.command-row code{display:block;min-width:0;overflow:auto;white-space:nowrap;background:var(--bg);border:1px solid var(--border);border-radius:11px;padding:13px;font-size:13px}.command-row button{border:1px solid var(--accent);background:var(--accent);color:#fff;border-radius:10px;padding:0 15px;font-size:12.5px;font-weight:750;cursor:pointer}.install-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.install-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:15px}.install-steps>div{display:flex;flex-direction:column;gap:4px;border:1px solid var(--border);border-radius:12px;background:var(--bg-soft);padding:12px}.install-steps b{color:var(--accent);font-size:11px}.install-steps strong{font-size:13px}.install-steps span{color:var(--muted);font-size:12px;line-height:1.5}.usage-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.usage-grid>div{border:1px solid var(--border);border-radius:12px;background:var(--bg-soft);padding:14px}.usage-grid small{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.usage-grid strong{display:block;margin-top:3px;font-size:14px;overflow-wrap:anywhere}.usage-grid p{color:var(--muted);font-size:12.5px;line-height:1.55;margin:7px 0 0}.version-table{display:grid;gap:8px}.version-row{display:grid;grid-template-columns:180px minmax(0,1fr) 210px;gap:12px;align-items:center;border:1px solid var(--border);border-radius:11px;padding:12px 14px;font-size:13px}.version-row span{color:var(--muted)}.version-row strong{overflow-wrap:anywhere}.version-row em{color:var(--muted);font-style:normal;font-size:12px;text-align:right}.version-row.warn{border-color:color-mix(in srgb,var(--amber) 55%,var(--border));background:color-mix(in srgb,var(--amber) 7%,transparent)}.sticky-panel{position:sticky;top:92px}.sticky-panel dl{display:grid;grid-template-columns:96px minmax(0,1fr);gap:10px;margin:18px 0 0;font-size:12.8px}.sticky-panel dt{color:var(--muted)}.sticky-panel dd{margin:0;min-width:0;overflow-wrap:anywhere}.sticky-panel code{font-size:12px}.side-links{display:grid;gap:8px;margin-top:18px;border-top:1px solid var(--border);padding-top:14px}.side-links a{font-size:12.5px;font-weight:700}.related{max-width:1400px;margin:38px auto 0}.related-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:14px}.section-kicker{color:var(--accent);font-size:11.5px;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.related-head h2{margin:4px 0 0;font-size:25px}.related-head>a{font-size:13px}.related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
  @media(max-width:1100px){.detail-grid{grid-template-columns:minmax(0,1fr) 300px}.install-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:820px){.identity-row{align-items:flex-start;flex-wrap:wrap}.hero-actions{width:100%;margin-left:84px;justify-content:flex-start}.stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-grid{grid-template-columns:1fr}.sticky-panel{position:static}.version-row{grid-template-columns:1fr}.version-row em{text-align:left}.overview-grid,.usage-grid{grid-template-columns:1fr}.install-steps{grid-template-columns:1fr}}
  @media(max-width:520px){.hero-card,.panel{padding:20px}.hero-actions{margin-left:0}.avatar{width:52px;height:52px}.title-col h1{font-size:31px}.stat-grid{grid-template-columns:1fr 1fr}.related-head{align-items:flex-start;flex-direction:column}.command-row{grid-template-columns:1fr}.command-row button{min-height:40px}}
</style>