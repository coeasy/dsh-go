---
import Layout from '../../layouts/Layout.astro';
import PluginCard from '../../components/PluginCard.astro';
import MarketplaceDetailHero from '../../components/MarketplaceDetailHero.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u } from '../../lib/urls';
import { DETAIL_THRESHOLD } from '../../lib/threshold';
import {
  DEFAULT_PACKAGE_VERSION,
  ecosystemType,
  findRegistryMatchForLegacy,
  isDefaultPopularStars,
} from '../../lib/marketplace';
import { fmtK } from '../../lib/format';

export async function getStaticPaths() {
  let plugins: any[] = [];
  let registryItems: any[] = [];
  try {
    const data = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf-8'));
    plugins = data.plugins || [];
  } catch { /* catalog optional during local bootstrap */ }
  try {
    const registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf-8'));
    registryItems = registry.plugins || [];
  } catch { /* registry optional during local bootstrap */ }

  const detailed = plugins.filter((plugin) => !plugin.deprecated && !plugin.disabled && Number(plugin.stars || 0) >= DETAIL_THRESHOLD);
  return detailed.map((plugin) => {
    const registryItem = findRegistryMatchForLegacy(plugin, registryItems);
    const related = detailed
      .filter((candidate) => candidate.category === plugin.category && candidate.slug !== plugin.slug && isDefaultPopularStars(Number(candidate.stars || 0)))
      .sort((left, right) => Number(right.stars || 0) - Number(left.stars || 0))
      .slice(0, 6)
      .map((candidate) => ({ plugin: candidate, registryItem: findRegistryMatchForLegacy(candidate, registryItems) }));
    return { params: { slug: plugin.slug }, props: { plugin, registryItem, related } };
  });
}

const { plugin, registryItem, related } = Astro.props as { plugin: any; registryItem: any | null; related: Array<{ plugin: any; registryItem: any | null }> };
const runtimeType = registryItem ? ecosystemType(registryItem) : 'plugin';
const runtimeVersion = String(registryItem?.version || plugin.version || DEFAULT_PACKAGE_VERSION);
const runtimeId = String(registryItem?.id || plugin.id || plugin.package_id || plugin.slug);
const runtimeIdentity = `${runtimeType}:${runtimeId}`;
const repository = String(plugin.full_name || registryItem?.source?.repo || '');
const repoUrl = String(plugin.repo_url || registryItem?.metadata?.repo_url || (repository ? `https://github.com/${repository}` : ''));
const commit = String(registryItem?.source?.commit || '');
const installCommand = registryItem
  ? `dsh ${runtimeType} install ${runtimeId}@${runtimeVersion}`
  : String(plugin.install_cmd || `dsh plugin add github:${repository}`);
const deepLink = registryItem
  ? `dsh://install?${new URLSearchParams({ id: runtimeId, version: runtimeVersion, type: runtimeType }).toString()}`
  : `dsh://install?plugin=${encodeURIComponent(repository)}`;
const ecosystemDetail = registryItem ? `${u(`/ecosystem/${encodeURIComponent(runtimeId)}`)}?type=${runtimeType}` : '';
const listedAt = plugin.first_seen ? new Date(plugin.first_seen).toLocaleDateString('zh-CN') : '—';
const updatedAt = plugin.updated_at ? new Date(plugin.updated_at).toLocaleDateString('zh-CN') : '—';
const installScriptsAvailable = Number(plugin.stars || 0) >= DETAIL_THRESHOLD;
---

<Layout title={`${plugin.name} · DSH Go`} description={plugin.description}>
  <main class="detail-shell">
    <nav class="breadcrumbs"><a href={u('/')}>dsh-plugin</a><span>／</span><span>{plugin.name}</span></nav>

    <MarketplaceDetailHero
      name={plugin.name}
      description={plugin.description}
      repo={repository}
      repoUrl={repoUrl}
      type={runtimeType}
      version={runtimeVersion}
      identity={runtimeIdentity}
      category={plugin.category || registryItem?.metadata?.category || 'other'}
      verified={plugin.verified === true || registryItem?.metadata?.verified === true}
      language={plugin.language || ''}
      stars={Number(plugin.stars || 0)}
      commit={commit}
      installCommand={installCommand}
      primaryHref={deepLink}
      primaryLabel="用 DSH 安装"
      secondaryHref={ecosystemDetail || undefined}
      secondaryLabel="Ecosystem 详情"
    />

    <section class="alignment-note">
      <b>身份已对齐：</b>
      <span>名称 / Star / 描述来自原 dsh-plugin catalog；版本 / runtime type / immutable commit 以 Registry V3 为准。</span>
      {!registryItem && <span class="warn">该条目暂未匹配 Registry V3，安装命令回退到 legacy catalog。</span>}
    </section>

    <div class="detail-grid">
      <section class="panel">
        <div class="panel-title"><h2>仓库信息</h2><span>Catalog</span></div>
        <dl>
          <dt>Repository</dt><dd>{repoUrl ? <a href={repoUrl} target="_blank" rel="noopener noreferrer">{repository}</a> : repository || '—'}</dd>
          <dt>Runtime identity</dt><dd><code>{runtimeIdentity}</code></dd>
          <dt>Version</dt><dd><code>{runtimeVersion}</code></dd>
          <dt>Commit</dt><dd>{commit ? <code title={commit}>{commit}</code> : 'legacy / unpinned'}</dd>
          <dt>Language</dt><dd>{plugin.language || '—'}</dd>
          <dt>License</dt><dd>{plugin.license || '—'}</dd>
          <dt>首次收录</dt><dd>{listedAt}</dd>
          <dt>最近更新</dt><dd>{updatedAt}</dd>
        </dl>
      </section>

      <section class="panel">
        <div class="panel-title"><h2>GitHub 活跃度</h2><span>Live catalog snapshot</span></div>
        <div class="metric-grid">
          <span><b>★ {fmtK(Number(plugin.stars || 0))}</b><i>Stars</i></span>
          <span><b>⑂ {fmtK(Number(plugin.forks || 0))}</b><i>Forks</i></span>
          <span><b>✦ {fmtK(Number(plugin.open_issues || 0))}</b><i>Issues</i></span>
          <span><b>◎ {fmtK(Number(plugin.watchers || 0))}</b><i>Watchers</i></span>
        </div>
        {Array.isArray(plugin.topics) && plugin.topics.length > 0 && (
          <div class="topics">{plugin.topics.slice(0, 12).map((topic: string) => <span>#{topic}</span>)}</div>
        )}
      </section>

      <section class="panel wide">
        <div class="panel-title"><h2>安装与激活</h2><span>Local runtime only</span></div>
        <p class="muted">安装不会自动重启客户端。完成后请手动重启，由 Startup Loader 再校验固定版本 / commit 后激活。</p>
        <div class="command-row"><code>{installCommand}</code></div>
        {installScriptsAvailable && (
          <div class="script-links">
            <a href={u(`/install/${plugin.slug}.sh`)} download>Linux / macOS 安装脚本</a>
            <a href={u(`/install/${plugin.slug}.ps1`)} download>Windows PowerShell 安装脚本</a>
            {ecosystemDetail && <a href={ecosystemDetail}>查看 Registry / 安全证据</a>}
          </div>
        )}
      </section>
    </div>
  </main>

  {related.length > 0 && (
    <section class="related-section">
      <div class="related-head"><div><span>CURATED</span><h2>同分类热门推荐</h2></div><small>仅展示 100–5000★，避免超大仓库垄断相关推荐</small></div>
      <div class="related-grid">
        {related.map(({ plugin: item, registryItem: relatedRegistry }) => {
          const type = relatedRegistry ? ecosystemType(relatedRegistry) : 'plugin';
          const version = String(relatedRegistry?.version || item.version || DEFAULT_PACKAGE_VERSION);
          const id = String(relatedRegistry?.id || item.id || item.package_id || item.slug);
          const command = relatedRegistry ? `dsh ${type} install ${id}@${version}` : item.install_cmd;
          return (
            <PluginCard
              slug={item.slug}
              name={item.name}
              description={item.description}
              stars={Number(item.stars || 0)}
              category={item.category}
              verified={item.verified === true || relatedRegistry?.metadata?.verified === true}
              trend={Number(item.trend_score || 0)}
              tags={item.topics || []}
              isNew={Boolean(item.first_seen && (Date.now() - new Date(item.first_seen).getTime()) < 7 * 864e5)}
              created={item.created_at}
              updated={item.updated_at}
              full_name={item.full_name}
              install_cmd={command}
              language={item.language}
              version={version}
              type={type}
              identity={`${type}:${id}`}
              capabilities={relatedRegistry?.capabilities || []}
            />
          );
        })}
      </div>
    </section>
  )}
</Layout>

<style>
  .detail-shell { max-width: 1120px; margin: 0 auto; padding: 22px 0 10px; }
  .breadcrumbs { display: flex; gap: 7px; align-items: center; color: var(--muted); font-size: 13px; margin-bottom: 13px; }
  .breadcrumbs span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .alignment-note { display: flex; gap: 7px; flex-wrap: wrap; margin: 14px 0 18px; padding: 11px 14px; border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border)); border-radius: 12px; background: var(--accent-soft); color: var(--muted); font-size: 12.5px; }
  .alignment-note b { color: var(--fg); }
  .alignment-note .warn { color: var(--amber); font-weight: 700; }
  .detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
  .panel { min-width: 0; border: 1px solid var(--border); border-radius: 16px; padding: 18px; background: var(--card); box-shadow: var(--shadow-sm); }
  .panel.wide { grid-column: 1 / -1; }
  .panel-title { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 13px; }
  .panel-title h2 { margin: 0; font-size: 16px; }
  .panel-title span { color: var(--muted); font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; }
  dl { display: grid; grid-template-columns: 126px minmax(0, 1fr); gap: 9px 12px; margin: 0; font-size: 12.5px; }
  dt { color: var(--muted); }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  dd code { font-size: 11px; overflow-wrap: anywhere; }
  .metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .metric-grid span { display: grid; gap: 2px; padding: 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-soft); }
  .metric-grid b { font-size: 14px; }
  .metric-grid i { color: var(--muted); font-size: 11px; font-style: normal; }
  .topics { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .topics span { padding: 3px 7px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 10.5px; }
  .muted { color: var(--muted); margin: 0 0 12px; font-size: 12.5px; }
  .command-row code { display: block; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-soft); overflow: auto; font-size: 11.5px; }
  .script-links { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 11px; }
  .script-links a { border: 1px solid var(--border); border-radius: 9px; padding: 7px 10px; background: var(--card); font-size: 12px; font-weight: 700; }
  .script-links a:hover { text-decoration: none; border-color: var(--border-strong); }
  .related-section { max-width: 1120px; margin: 24px auto 50px; }
  .related-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 15px; margin-bottom: 12px; }
  .related-head span { color: var(--accent); font-size: 10px; font-weight: 850; letter-spacing: .08em; }
  .related-head h2 { margin: 2px 0 0; font-size: 19px; }
  .related-head small { color: var(--muted); }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 14px; }
  @media (max-width: 720px) {
    .detail-grid { grid-template-columns: 1fr; }
    .panel.wide { grid-column: auto; }
    dl { grid-template-columns: 1fr; gap: 3px; }
    dd { margin-bottom: 7px; }
    .related-head { align-items: flex-start; flex-direction: column; }
  }
</style>
