---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { u } from '../lib/urls';

let registry: any = { packages: [], publishers: [], advisories: [] };
try { registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v4.json'), 'utf8')); } catch { /* generated before production build */ }
const publisherMap = new Map((registry.publishers || []).map((publisher: any) => [String(publisher.id), publisher]));
function latestSafe(pkg: any) {
  return [...(pkg.releases || [])].filter((release: any) => !release.revoked && !release.yanked).sort((a:any,b:any)=>String(b.version).localeCompare(String(a.version),undefined,{numeric:true}))[0] || null;
}
function trust(pkg: any, release: any) {
  const publisher = publisherMap.get(String(pkg.publisher_id)) as any;
  const security = release?.security || {};
  const publisherVerified = publisher?.verified === true || publisher?.repository_ownership === 'verified';
  const cryptoVerified = security.cryptographic_signature_verified === true || security.signature?.cryptographic_verified === true || security.signature?.verified === true && security.signature?.verification_method === 'cryptographic';
  const provenanceVerified = security.slsa_provenance_verified === true || security.provenance?.verified === true;
  const sbomVerified = security.sbom?.verified === true;
  const critical = (registry.advisories || []).some((advisory:any) => advisory.package?.type === pkg.type && advisory.package?.id === pkg.id && String(advisory.severity || '').toLowerCase() === 'critical');
  const blocked = !release || release.revoked === true || critical;
  const tier = blocked ? 'blocked' : publisherVerified && cryptoVerified ? 'trusted' : publisherVerified || cryptoVerified || provenanceVerified ? 'verified' : 'community';
  return { tier, publisherVerified, cryptoVerified, provenanceVerified, sbomVerified, critical, blocked };
}
const rows = (registry.packages || []).map((pkg:any) => { const release=latestSafe(pkg); return { pkg, release, trust: trust(pkg, release) }; });
const counts = rows.reduce((acc:any,row:any)=>{acc[row.trust.tier]=(acc[row.trust.tier]||0)+1;return acc;},{});
const notable = [...rows].filter((row:any)=>row.release).sort((a:any,b:any)=>{
  const weight=(row:any)=>row.trust.tier==='trusted'?3:row.trust.tier==='verified'?2:row.trust.tier==='community'?1:0;
  return weight(b)-weight(a)||Number(b.pkg.metadata?.stars||0)-Number(a.pkg.metadata?.stars||0);
}).slice(0,30);
---

<Layout title="Trust Center · DSH Marketplace" description="Cryptographic signer verification, publisher identity, immutable releases and security advisories for Registry V4 packages.">
  <section class="hero"><span>Registry V4 Trust</span><h1>Trust Center</h1><p>A package is never marked trusted because it is popular or merely declares a signature. <strong>Trusted</strong> requires verified publisher ownership and successful cryptographic signature verification.</p><div class="stats"><div><b>{rows.length}</b><small>packages</small></div><div><b>{counts.trusted || 0}</b><small>trusted</small></div><div><b>{counts.verified || 0}</b><small>partially verified</small></div><div><b>{counts.community || 0}</b><small>community</small></div><div><b>{counts.blocked || 0}</b><small>blocked</small></div></div></section>

  <section class="principles">
    <article><h2>Trusted means cryptographic</h2><p>Digest equality confirms bytes, not signer identity. Trusted requires successful cryptographic verification plus verified publisher ownership.</p></article>
    <article><h2>Immutable release identity</h2><p>Every installable Registry V4 release is pinned to a 40-character source commit and is resolved before the local transaction starts.</p></article>
    <article><h2>Fail closed</h2><p>Revoked releases and critical security advisories are blocked by Resolver V2. Yanked releases are not selected for new installs.</p></article>
    <article><h2>Local authority</h2><p>Marketplace, REST and MCP can return plans only. The local DSH Runtime owns permissions, filesystem writes, activation and rollback.</p></article>
  </section>

  <div class="section-head"><div><span>Evidence-backed packages</span><h2>Registry trust signals</h2></div><a href={u('/')}>Marketplace →</a></div>
  <section class="grid">
    {notable.map(({ pkg, release, trust }: any) => (
      <article class="card">
        <div class="top"><span class={`tier ${trust.tier}`}>{trust.tier}</span><span>{pkg.type.toUpperCase()}</span></div>
        <h3>{pkg.metadata?.name || pkg.id}</h3><code>{pkg.type}:{pkg.id}@{release.version}</code><p>{pkg.metadata?.description || pkg.source?.repo || ''}</p>
        <dl><div><dt>Publisher ownership</dt><dd>{trust.publisherVerified ? '✓ verified' : '—'}</dd></div><div><dt>Cryptographic signature</dt><dd>{trust.cryptoVerified ? '✓ verified' : '—'}</dd></div><div><dt>SLSA provenance</dt><dd>{trust.provenanceVerified ? '✓ verified' : '—'}</dd></div><div><dt>SBOM evidence</dt><dd>{trust.sbomVerified ? '✓ verified' : '—'}</dd></div></dl>
      </article>
    ))}
  </section>
</Layout>

<style>
  .hero{max-width:1080px;margin:28px auto 32px;text-align:center}.hero>span,.section-head span{font-size:10px;font-weight:900;letter-spacing:.1em;color:var(--accent);text-transform:uppercase}.hero h1{font-size:clamp(40px,6vw,62px);letter-spacing:-.05em;margin:6px 0}.hero p{max-width:820px;margin:auto;color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-top:24px}.stats div,.principles article,.card{border:1px solid var(--border);border-radius:15px;background:var(--card);box-shadow:var(--shadow-sm)}.stats div{padding:13px}.stats b,.stats small{display:block}.stats b{font-size:22px}.stats small{color:var(--muted);font-size:10px}.principles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:30px 0 40px}.principles article{padding:17px}.principles h2{margin:0 0 6px;font-size:15px}.principles p{margin:0;color:var(--muted);font-size:12px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px}.section-head h2{margin:3px 0 0}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}.card{padding:17px}.top{display:flex;justify-content:space-between;color:var(--muted);font-size:10px}.tier{font-weight:900;text-transform:uppercase;padding:3px 7px;border-radius:999px;background:var(--bg-soft)}.tier.trusted{color:var(--green)}.tier.verified{color:var(--accent)}.tier.blocked{color:var(--red)}.card h3{margin:11px 0 2px}.card>code{font-size:11px;color:var(--muted)}.card>p{min-height:40px;color:var(--muted);font-size:12px}.card dl{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:0}.card dl div{padding:8px;background:var(--bg-soft);border-radius:9px}.card dt{font-size:9px;color:var(--muted)}.card dd{margin:3px 0 0;font-size:10px}@media(max-width:900px){.principles{grid-template-columns:1fr 1fr}.stats{grid-template-columns:1fr 1fr}}@media(max-width:560px){.principles,.stats{grid-template-columns:1fr}}
</style>
