---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { u } from '../../lib/urls';

function publisherId(item: any) {
  return String(item.publisher?.id || item.publisher?.login || item.publisher?.name || item.source?.repo?.split('/')[0] || 'unknown');
}
function typeOf(item: any) { return item.type || item.runtime?.type || 'plugin'; }
function trust(item: any) {
  const security = item.security || {};
  const ownership = item.publisher?.repository_ownership || 'unverified';
  let score = 0;
  if (security.provenance) score += 20;
  if (security.signature) score += 25;
  if (security.sbom) score += 15;
  if (security.license) score += 10;
  if (ownership === 'verified' || item.publisher?.verified === true) score += 25;
  else if (ownership === 'declared' || ownership === 'required') score += 10;
  if (item.metadata?.verified === true) score += 10;
  const critical = (security.advisories || []).some((advisory: any) => String(advisory?.severity || '').toLowerCase() === 'critical');
  if (security.yanked) score -= 25;
  if (security.revoked) score -= 100;
  if (critical) score -= 50;
  score = Math.max(0, Math.min(100, score));
  return { score, tier: security.revoked || critical ? 'unverified' : score >= 80 ? 'trusted' : score >= 55 ? 'verified' : score >= 25 ? 'community' : 'unverified' };
}

export async function getStaticPaths() {
  const staticPublisherId = (item: any) => String(item.publisher?.id || item.publisher?.login || item.publisher?.name || item.source?.repo?.split('/')[0] || 'unknown');
  let packages: any[] = [];
  try { packages = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf8')).plugins || []; } catch { packages = []; }
  const ids = [...new Set(packages.map(staticPublisherId).filter((id) => id && id !== 'unknown'))].sort();
  return ids.map((id) => ({ params: { id }, props: { id, packages: packages.filter((item) => staticPublisherId(item) === id) } }));
}

const { id, packages } = Astro.props as { id: string; packages: any[] };
const latestByKey = new Map<string, any>();
for (const item of packages) {
  const key = `${typeOf(item)}:${item.id}`;
  const current = latestByKey.get(key);
  if (!current || String(item.version).localeCompare(String(current.version), undefined, { numeric: true }) > 0) latestByKey.set(key, item);
}
const latest = [...latestByKey.values()].sort((a, b) => Number(b.metadata?.stars || 0) - Number(a.metadata?.stars || 0));
const avgTrust = latest.length ? Math.round(latest.reduce((sum, item) => sum + trust(item).score, 0) / latest.length) : 0;
const ownershipVerified = latest.some((item) => item.publisher?.repository_ownership === 'verified' || item.publisher?.verified === true);
const repoOwner = latest[0]?.source?.repo?.split('/')[0] || id;
---

<Layout title={`${id} · DSH Publisher`} description={`DSH Marketplace publisher profile for ${id}.`}>
  <a class="back" href={u('/')}>← Marketplace</a>
  <section class="publisher-hero">
    <div>
      <span class="kicker">Publisher</span>
      <h1>{id}</h1>
      <p>Registry-backed publisher identity and package portfolio. Ownership and trust are independent from popularity.</p>
    </div>
    <div class="summary">
      <span><b>{latest.length}</b><small>packages</small></span>
      <span><b>{avgTrust}</b><small>avg trust</small></span>
      <span><b>{ownershipVerified ? 'Verified' : 'Unverified'}</b><small>repository ownership</small></span>
    </div>
  </section>

  <div class="notice">Publisher identity: <code>{repoOwner}</code> · Marketplace pages are read-only. Install commands execute only in the local DSH Runtime.</div>
  <section class="grid">
    {latest.map((item) => {
      const type = typeOf(item);
      const signal = trust(item);
      const command = `dsh ${type} install ${item.id}@${item.version}`;
      return (
        <article class="card">
          <div class="top"><span class={`tier ${signal.tier}`}>{signal.tier} · {signal.score}</span><span>★ {Number(item.metadata?.stars || 0).toLocaleString()}</span></div>
          <h2>{item.metadata?.name || item.id}</h2>
          <code>{type}:{item.id}@{item.version}</code>
          <p>{item.metadata?.description || item.source?.repo || ''}</p>
          <div class="cmd"><code>{command}</code></div>
          <div class="links"><a href={item.source?.repo ? `https://github.com/${item.source.repo}` : '#'} target="_blank" rel="noopener noreferrer">Source ↗</a><a href={u(`/ecosystem/${encodeURIComponent(item.id)}?type=${type}`)}>Registry detail →</a></div>
        </article>
      );
    })}
  </section>
</Layout>

<style>
  .back{display:inline-block;margin:4px 0 18px}.publisher-hero{display:flex;justify-content:space-between;gap:26px;align-items:end;padding:28px;border:1px solid var(--border);border-radius:20px;background:var(--card)}.kicker{color:var(--accent);font-weight:850;font-size:12px;text-transform:uppercase;letter-spacing:.08em}.publisher-hero h1{margin:5px 0;font-size:clamp(38px,6vw,58px);letter-spacing:-.04em}.publisher-hero p{color:var(--muted);margin:0;max-width:720px}.summary{display:flex;gap:9px;flex-wrap:wrap}.summary span{min-width:120px;padding:12px;border:1px solid var(--border);border-radius:13px;background:var(--bg-soft)}.summary b,.summary small{display:block}.summary small{color:var(--muted);font-size:11px}.notice{margin:18px 0;padding:13px 16px;border:1px solid var(--border);border-radius:13px;color:var(--muted);background:var(--bg-soft)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:15px}.card{border:1px solid var(--border);border-radius:17px;padding:18px;background:var(--card)}.top,.links{display:flex;justify-content:space-between;gap:10px;font-size:12px;color:var(--muted)}.tier{padding:3px 8px;border-radius:999px;background:var(--bg-soft);font-weight:800}.tier.trusted{color:var(--green)}.tier.verified{color:var(--accent)}.card h2{margin:12px 0 2px}.card>code{font-size:12px;color:var(--muted)}.card p{min-height:48px;color:var(--muted);font-size:13px}.cmd{padding:10px;border-radius:10px;background:var(--bg);overflow:auto;margin:12px 0}.cmd code{white-space:nowrap;font-size:12px}@media(max-width:780px){.publisher-hero{align-items:flex-start;flex-direction:column}}
</style>
