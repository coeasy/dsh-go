---
import Layout from '../../layouts/Layout.astro';
import { u } from '../../lib/urls';
import { DETAIL_THRESHOLD } from '../../lib/threshold';

const registryUrl = u('/catalog/registry-v3.json');
const ecosystemUrl = u('/ecosystem/');
---

<Layout title="Publishers · DSH Marketplace" description="Registry-backed DSH Marketplace publisher directory and package portfolios.">
  <section class="hero">
    <div><span class="kicker">Marketplace V4</span><h1 data-pub-i18n="title">Publisher directory</h1><p data-pub-i18n="intro">Explore registry-backed publisher identities and their package portfolios. Ownership, trust and popularity remain separate signals.</p></div>
    <div class="hero-actions"><a class="secondary" href={u('/')}>Marketplace</a><a class="secondary" href={u('/trust')} data-pub-i18n="trust">Trust Center</a></div>
  </section>

  <form id="publisher-search" class="search" role="search">
    <label for="publisher-query" data-pub-i18n="find">Find a publisher</label>
    <div class="search-row"><input id="publisher-query" name="q" type="search" placeholder="Search by publisher or repository owner" data-pub-placeholder autocomplete="off" /><button type="submit" data-pub-i18n="search">Search</button></div>
  </form>

  <p id="publisher-status" class="status" role="status" aria-live="polite" data-pub-i18n="loading">Loading the Registry V3 publisher directory…</p>
  <section id="publisher-grid" class="grid" aria-live="polite"></section>
  <p id="publisher-empty" class="empty" hidden data-pub-i18n="empty">No publisher matches this search.</p>
</Layout>

<script is:inline define:vars={{ registryUrl, ecosystemUrl, detailThreshold: DETAIL_THRESHOLD }}>
  const grid = document.querySelector('#publisher-grid');
  const empty = document.querySelector('#publisher-empty');
  const status = document.querySelector('#publisher-status');
  const form = document.querySelector('#publisher-search');
  const input = document.querySelector('#publisher-query');
  let publishers = [];

  const strings = {
    en:{title:'Publisher directory',intro:'Explore registry-backed publisher identities and their package portfolios. Ownership, trust and popularity remain separate signals.',trust:'Trust Center',find:'Find a publisher',placeholder:'Search by publisher or repository owner',search:'Search',loading:'Loading the Registry V3 publisher directory…',empty:'No publisher matches this search.',publisher:'Publisher',verified:'Verified',unverified:'Unverified',packages:'packages',avgTrust:'avg trust',stars:'stars',openPortfolio:'Open portfolio →',all:'← All publishers',portfolio:'Registry-backed package portfolio. Ownership and trust are independent from popularity.',ownership:'repository ownership',source:'Source ↗',detail:'Registry detail →',unavailable:'Publisher directory is temporarily unavailable. Open the Trust Center or try again later.',loadFailed:'Registry V3 could not be loaded'},
    'zh-CN':{title:'发布者目录',intro:'浏览 Registry 支持的发布者身份与包组合。所有权、信任和热度始终作为独立信号展示。',trust:'信任中心',find:'查找发布者',placeholder:'按发布者或仓库所有者搜索',search:'搜索',loading:'正在加载 Registry V3 发布者目录…',empty:'没有匹配的发布者。',publisher:'发布者',verified:'已验证',unverified:'未验证',packages:'包',avgTrust:'平均信任分',stars:'Stars',openPortfolio:'打开包组合 →',all:'← 所有发布者',portfolio:'Registry 支持的包组合。所有权与信任独立于热度。',ownership:'仓库所有权',source:'源码 ↗',detail:'Registry 详情 →',unavailable:'发布者目录暂时不可用，请打开信任中心或稍后重试。',loadFailed:'无法加载 Registry V3'},
    ja:{title:'公開者ディレクトリ',intro:'Registry に基づく公開者 ID とパッケージ一覧を確認できます。所有権、信頼、人気は独立した指標です。',trust:'トラストセンター',find:'公開者を検索',placeholder:'公開者またはリポジトリ所有者で検索',search:'検索',loading:'Registry V3 の公開者ディレクトリを読み込み中…',empty:'一致する公開者はありません。',publisher:'公開者',verified:'検証済み',unverified:'未検証',packages:'パッケージ',avgTrust:'平均信頼度',stars:'Stars',openPortfolio:'ポートフォリオを開く →',all:'← すべての公開者',portfolio:'Registry ベースのパッケージポートフォリオ。所有権と信頼は人気とは独立しています。',ownership:'リポジトリ所有権',source:'ソース ↗',detail:'Registry 詳細 →',unavailable:'公開者ディレクトリは一時的に利用できません。トラストセンターを開くか、後でもう一度お試しください。',loadFailed:'Registry V3 を読み込めませんでした'},
    ko:{title:'게시자 디렉터리',intro:'Registry 기반 게시자 ID와 패키지 포트폴리오를 살펴보세요. 소유권, 신뢰도, 인기도는 서로 독립된 신호입니다.',trust:'신뢰 센터',find:'게시자 찾기',placeholder:'게시자 또는 저장소 소유자로 검색',search:'검색',loading:'Registry V3 게시자 디렉터리를 불러오는 중…',empty:'일치하는 게시자가 없습니다.',publisher:'게시자',verified:'검증됨',unverified:'미검증',packages:'패키지',avgTrust:'평균 신뢰도',stars:'Stars',openPortfolio:'포트폴리오 열기 →',all:'← 모든 게시자',portfolio:'Registry 기반 패키지 포트폴리오입니다. 소유권과 신뢰도는 인기도와 독립적입니다.',ownership:'저장소 소유권',source:'소스 ↗',detail:'Registry 상세 →',unavailable:'게시자 디렉터리를 일시적으로 사용할 수 없습니다. 신뢰 센터를 열거나 나중에 다시 시도하세요.',loadFailed:'Registry V3를 불러올 수 없습니다'},
    es:{title:'Directorio de publicadores',intro:'Explora identidades de publicadores respaldadas por el Registry y sus portafolios de paquetes. Propiedad, confianza y popularidad son señales separadas.',trust:'Centro de confianza',find:'Buscar un publicador',placeholder:'Buscar por publicador o propietario del repositorio',search:'Buscar',loading:'Cargando el directorio de publicadores de Registry V3…',empty:'No hay publicadores que coincidan con la búsqueda.',publisher:'Publicador',verified:'Verificado',unverified:'No verificado',packages:'paquetes',avgTrust:'confianza media',stars:'Stars',openPortfolio:'Abrir portafolio →',all:'← Todos los publicadores',portfolio:'Portafolio de paquetes respaldado por Registry. La propiedad y la confianza son independientes de la popularidad.',ownership:'propiedad del repositorio',source:'Fuente ↗',detail:'Detalle de Registry →',unavailable:'El directorio de publicadores no está disponible temporalmente. Abre el Centro de confianza o inténtalo más tarde.',loadFailed:'No se pudo cargar Registry V3'},
  };
  function lang(){ return strings[document.documentElement.lang] ? document.documentElement.lang : 'en'; }
  function t(key){ return strings[lang()][key] || strings.en[key] || key; }
  function applyStatic(){ document.querySelectorAll('[data-pub-i18n]').forEach((node)=>{ const key=node.getAttribute('data-pub-i18n'); if(strings[lang()][key])node.textContent=t(key); }); if(input)input.placeholder=t('placeholder'); }

  const escapeMap = { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' };
  function escapeHtml(value){ return String(value == null ? '' : value).replace(/[&<>"']/g,(character)=>escapeMap[character]); }
  function publisherId(item){ return String(item.publisher && (item.publisher.id || item.publisher.login || item.publisher.name) || (item.source && item.source.repo && item.source.repo.split('/')[0]) || 'unknown').trim(); }
  function packageType(item){ return String(item.type || (item.runtime && item.runtime.type) || 'plugin'); }
  function trust(item){ const security=item.security||{};const publisher=item.publisher||{};const ownership=publisher.repository_ownership||'unverified';const advisories=security.advisories||[];let score=0;if(security.provenance)score+=20;if(security.signature)score+=25;if(security.sbom)score+=15;if(security.license)score+=10;if(ownership==='verified'||publisher.verified===true)score+=25;else if(ownership==='declared'||ownership==='required')score+=10;if(item.metadata&&item.metadata.verified===true)score+=10;if(security.yanked===true)score-=25;if(security.revoked===true)score-=100;const critical=advisories.some((a)=>String(a&&a.severity||'').toLowerCase()==='critical');if(critical)score-=50;score=Math.max(0,Math.min(100,score));return{score,tier:security.revoked||critical?'unverified':score>=80?'trusted':score>=55?'verified':score>=25?'community':'unverified'}; }
  function compareVersions(left,right){ return String(left||'').localeCompare(String(right||''),undefined,{numeric:true}); }
  function repoHref(item){ const repo=String(item.source&&item.source.repo||'').trim(); return /^[\w.-]+\/[\w.-]+$/.test(repo)?'https://github.com/'+repo:''; }
  function queryHref(values){ const url=new URL(window.location.href);url.search='';Object.entries(values).forEach(([key,value])=>{if(value)url.searchParams.set(key,value);});return url.pathname+url.search; }
  function groupedPublishers(entries){ const groups=new Map();entries.forEach((item)=>{const id=publisherId(item);if(!id||id==='unknown')return;const group=groups.get(id)||{id,packages:new Map()};const key=packageType(item)+':'+item.id;const current=group.packages.get(key);if(!current||compareVersions(item.version,current.version)>0)group.packages.set(key,item);groups.set(id,group);});return Array.from(groups.values()).map((group)=>{const items=Array.from(group.packages.values()).sort((a,b)=>Number(b.metadata&&b.metadata.stars||0)-Number(a.metadata&&a.metadata.stars||0));const signals=items.map(trust);const stars=items.reduce((sum,item)=>sum+Number(item.metadata&&item.metadata.stars||0),0);return{id:group.id,items,avgTrust:items.length?Math.round(signals.reduce((sum,signal)=>sum+signal.score,0)/items.length):0,verified:items.some((item)=>item.publisher&&(item.publisher.repository_ownership==='verified'||item.publisher.verified===true)),stars};}).sort((a,b)=>b.items.length-a.items.length||b.stars-a.stars||a.id.localeCompare(b.id)); }
  function packageCard(item){ const type=packageType(item);const signal=trust(item);const repo=repoHref(item);const metadata=item.metadata||{};const stars=Number(metadata.stars||0);const detail=stars>=detailThreshold?ecosystemUrl+encodeURIComponent(item.id)+'?type='+encodeURIComponent(type):'';const links=(repo?'<a href="'+repo+'" target="_blank" rel="noopener noreferrer">'+escapeHtml(t('source'))+'</a>':'')+(detail?'<a href="'+detail+'">'+escapeHtml(t('detail'))+'</a>':'');return '<article class="card package-card"><div class="top"><span class="tier '+escapeHtml(signal.tier)+'">'+escapeHtml(signal.tier)+' · '+signal.score+'</span><span>★ '+stars.toLocaleString()+'</span></div><h3>'+escapeHtml(metadata.name||item.id)+'</h3><code>'+escapeHtml(type)+':'+escapeHtml(item.id)+'@'+escapeHtml(item.version)+'</code><p>'+escapeHtml(metadata.description||(item.source&&item.source.repo)||'')+'</p><div class="links">'+links+'</div></article>'; }
  function renderDirectory(query){ const normalized=String(query||'').trim().toLowerCase();const visible=publishers.filter((publisher)=>publisher.id.toLowerCase().includes(normalized));empty.hidden=visible.length!==0;grid.className='grid';grid.innerHTML=visible.map((publisher)=>'<a class="card publisher-card" href="'+queryHref({id:publisher.id})+'"><div class="top"><span class="kicker">'+escapeHtml(t('publisher'))+'</span><span>'+(publisher.verified?'✓ '+escapeHtml(t('verified')):escapeHtml(t('unverified')))+'</span></div><h2>'+escapeHtml(publisher.id)+'</h2><div class="summary"><span><b>'+publisher.items.length+'</b><small>'+escapeHtml(t('packages'))+'</small></span><span><b>'+publisher.avgTrust+'</b><small>'+escapeHtml(t('avgTrust'))+'</small></span><span><b>★ '+publisher.stars.toLocaleString()+'</b><small>'+escapeHtml(t('stars'))+'</small></span></div><span class="profile-link">'+escapeHtml(t('openPortfolio'))+'</span></a>').join('');status.textContent=visible.length.toLocaleString()+' / '+publishers.length.toLocaleString()+' '+t('publisher')+' · Registry V3'; }
  function renderProfile(publisher){ empty.hidden=true;grid.className='profile-grid';grid.innerHTML='<a class="back-link" href="'+queryHref({})+'">'+escapeHtml(t('all'))+'</a><section class="profile-hero"><div><span class="kicker">'+escapeHtml(t('publisher'))+'</span><h2>'+escapeHtml(publisher.id)+'</h2><p>'+escapeHtml(t('portfolio'))+'</p></div><div class="summary"><span><b>'+publisher.items.length+'</b><small>'+escapeHtml(t('packages'))+'</small></span><span><b>'+publisher.avgTrust+'</b><small>'+escapeHtml(t('avgTrust'))+'</small></span><span><b>'+(publisher.verified?escapeHtml(t('verified')):escapeHtml(t('unverified')))+'</b><small>'+escapeHtml(t('ownership'))+'</small></span></div></section><section class="package-grid">'+publisher.items.map(packageCard).join('')+'</section>';status.textContent=publisher.id+' · '+publisher.items.length+' '+t('packages')+' · Registry V3'; }
  function render(){ const params=new URLSearchParams(window.location.search);const selected=params.get('id');const query=params.get('q')||'';input.value=query;const publisher=selected&&publishers.find((candidate)=>candidate.id.toLowerCase()===selected.toLowerCase());if(publisher)renderProfile(publisher);else renderDirectory(query); }
  form.addEventListener('submit',(event)=>{event.preventDefault();window.history.pushState({},'',queryHref({q:input.value.trim()}));render();});window.addEventListener('popstate',render);document.addEventListener('dsh:languagechange',()=>{applyStatic();if(publishers.length)render();});applyStatic();
  fetch(registryUrl,{headers:{accept:'application/json'}}).then((response)=>{if(!response.ok)throw new Error('Registry V3 returned HTTP '+response.status);return response.json();}).then((payload)=>{publishers=groupedPublishers(Array.isArray(payload.plugins)?payload.plugins:[]);render();}).catch((error)=>{grid.innerHTML='';empty.hidden=false;empty.textContent=t('unavailable');status.textContent=error instanceof Error?error.message:t('loadFailed');});
</script>

<style>
  .hero{display:flex;justify-content:space-between;gap:26px;align-items:end;margin:24px auto 30px;padding:30px;border:1px solid var(--border);border-radius:20px;background:var(--card);box-shadow:var(--shadow-sm)}.kicker{color:var(--accent);font-size:11px;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.hero h1{margin:7px 0;font-size:clamp(38px,6vw,60px);letter-spacing:-.045em}.hero p{max-width:760px;margin:0;color:var(--muted)}.hero-actions{display:flex;gap:8px;flex-wrap:wrap}.secondary{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--border);border-radius:11px;padding:10px 14px;background:var(--card);color:var(--fg);font-size:13px;font-weight:750}.search{max-width:760px;margin:0 auto 18px}.search label{display:block;margin-bottom:6px;font-size:12px;font-weight:800;color:var(--muted)}.search-row{display:flex;gap:8px}.search input{flex:1;min-width:0;border:1px solid var(--border-strong);border-radius:11px;background:var(--card);color:var(--fg);padding:12px 14px;font:inherit}.search button{border:0;border-radius:11px;background:var(--accent);color:white;padding:0 18px;font-weight:800;cursor:pointer}.status{text-align:center;color:var(--muted);font-size:12px;margin:12px 0 20px}.grid,.package-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:14px}.profile-grid{display:grid;gap:14px}.card{display:block;border:1px solid var(--border);border-radius:16px;background:var(--card);box-shadow:var(--shadow-sm);padding:18px;color:var(--fg)}a.card:hover{text-decoration:none;transform:translateY(-2px);box-shadow:var(--shadow-md)}.publisher-card .top,.package-card .top,.links{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:12px}.publisher-card h2{margin:12px 0 16px;font-size:24px;overflow-wrap:anywhere}.summary{display:flex;gap:8px;flex-wrap:wrap}.summary span{min-width:86px;padding:10px;border:1px solid var(--border);border-radius:11px;background:var(--bg-soft)}.summary b,.summary small{display:block}.summary small{color:var(--muted);font-size:10px}.profile-link{display:block;margin-top:16px;color:var(--accent);font-size:12px;font-weight:800}.tier{padding:3px 8px;border-radius:999px;background:var(--bg-soft);font-weight:800}.tier.trusted{color:var(--green)}.tier.verified{color:var(--accent)}.package-card h3{margin:12px 0 2px}.package-card>code{color:var(--muted);font-size:12px}.package-card p{min-height:45px;color:var(--muted);font-size:13px}.links a{font-weight:750}.empty{text-align:center;padding:35px;color:var(--muted)}.back-link{color:var(--muted);font-size:13px;font-weight:750}.profile-hero{display:flex;justify-content:space-between;gap:22px;align-items:end;padding:26px;border:1px solid var(--border);border-radius:18px;background:var(--card)}.profile-hero h2{margin:5px 0;font-size:clamp(30px,5vw,48px);letter-spacing:-.04em}.profile-hero p{margin:0;color:var(--muted)}@media(max-width:760px){.hero,.profile-hero{align-items:flex-start;flex-direction:column}.search-row{flex-direction:column}.search button{min-height:42px}}
</style>
