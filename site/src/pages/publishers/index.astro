---
import Layout from '../../layouts/Layout.astro';
import { MESSAGES } from '../../i18n/messages';
import { DETAIL_THRESHOLD } from '../../lib/threshold';
import { u } from '../../lib/urls';

const registryUrl = u('/catalog/registry-v4.json');
const packageBase = u('/package/');
---

<Layout title="Publishers · DSH Marketplace" description="Registry V4 publisher identities and package portfolios.">
  <section class="publisher-page" data-publishers data-registry-url={registryUrl} data-package-base={packageBase} data-detail-threshold={DETAIL_THRESHOLD}>
    <header class="hero"><div><span>Registry V4</span><h1 data-msg="publishers">Publishers</h1><p>Package ownership, verification and popularity remain independent signals.</p></div><a href={u('/trust')} data-msg="trust">Trust Center</a></header>
    <div class="search"><input type="search" data-search placeholder="Search publisher…" /><span data-status aria-live="polite"></span></div>
    <div class="grid" data-grid></div>
    <p class="empty" data-empty hidden>No publisher matches this search.</p>
  </section>
</Layout>

<script is:inline define:vars={{ messages: MESSAGES }}>
  (()=>{
    const root=document.querySelector('[data-publishers]');if(!root)return;
    const grid=root.querySelector('[data-grid]');const search=root.querySelector('[data-search]');const status=root.querySelector('[data-status]');const empty=root.querySelector('[data-empty]');
    const threshold=Number(root.dataset.detailThreshold||200);let publishers=[];let packages=[];
    const lang=()=>messages[document.documentElement.lang]?document.documentElement.lang:'en';const t=(key)=>messages[lang()][key]||messages.en[key]||key;
    const esc=(value)=>String(value==null?'':value).replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const href=(pkg)=>root.dataset.packageBase+encodeURIComponent(pkg.type)+'/'+String(pkg.id).split('/').map(encodeURIComponent).join('/');
    const latest=(pkg)=>[...(pkg.releases||[])].filter((r)=>!r.revoked&&!r.yanked).sort((a,b)=>String(b.version).localeCompare(String(a.version),undefined,{numeric:true}))[0]||null;
    function render(){const q=String(search.value||'').trim().toLowerCase();const visible=publishers.filter((p)=>!q||String(p.id||'').toLowerCase().includes(q)||String(p.display_name||'').toLowerCase().includes(q));empty.hidden=visible.length!==0;grid.innerHTML=visible.map((publisher)=>{const owned=packages.filter((pkg)=>pkg.publisher_id===publisher.id);const stars=owned.reduce((sum,pkg)=>sum+Number(pkg.metadata&&pkg.metadata.stars||0),0);const cards=owned.slice(0,8).map((pkg)=>{const release=latest(pkg);const source=pkg.source&&pkg.source.repo?`https://github.com/${pkg.source.repo}`:'';const detail=release&&Number(pkg.metadata&&pkg.metadata.stars||0)>=threshold?href(pkg):'';return `<article class="package"><strong>${esc(pkg.metadata&&pkg.metadata.name||pkg.id)}</strong><code>${esc(pkg.type)}:${esc(pkg.id)}</code><span>★ ${Number(pkg.metadata&&pkg.metadata.stars||0).toLocaleString()}</span><div>${detail?`<a href="${esc(detail)}">${esc(t('detail'))}</a>`:source?`<a href="${esc(source)}" target="_blank" rel="noopener noreferrer">${esc(t('source'))}</a>`:''}</div></article>`;}).join('');return `<section class="publisher"><div class="publisher-head"><div><span class="kicker">${esc(t('publisher'))}</span><h2>${esc(publisher.display_name||publisher.id)}</h2><code>${esc(publisher.id)}</code></div><div class="signals"><b>${owned.length}</b><small>packages</small><b>★ ${stars.toLocaleString()}</b><small>${esc(t('stars'))}</small><b>${publisher.verified?'✓':'—'}</b><small>${esc(t('verified'))}</small></div></div><div class="packages">${cards}</div></section>`;}).join('');status.textContent=`${visible.length.toLocaleString()} / ${publishers.length.toLocaleString()}`;}
    function apply(){root.querySelectorAll('[data-msg]').forEach((node)=>{const key=node.getAttribute('data-msg');if(key)node.textContent=t(key);});if(publishers.length)render();}
    search.addEventListener('input',render);document.addEventListener('dsh:languagechange',apply);apply();
    status.textContent=t('loading');fetch(root.dataset.registryUrl,{headers:{accept:'application/json'}}).then((response)=>{if(!response.ok)throw new Error(`HTTP ${response.status}`);return response.json();}).then((registry)=>{if(Number(registry.schema_version)!==4)throw new Error('invalid Registry V4');publishers=Array.isArray(registry.publishers)?registry.publishers:[];packages=Array.isArray(registry.packages)?registry.packages:[];render();}).catch((error)=>{status.textContent=`${t('load_failed')} ${error.message}`;});
  })();
</script>

<style>
  .publisher-page{max-width:1240px;margin:24px auto 80px}.hero{display:flex;justify-content:space-between;align-items:end;gap:20px;padding:28px;border:1px solid var(--border);border-radius:18px;background:var(--card)}.hero span,.kicker{font-size:10px;font-weight:900;letter-spacing:.1em;color:var(--accent);text-transform:uppercase}.hero h1{font-size:clamp(38px,6vw,58px);margin:6px 0;letter-spacing:-.045em}.hero p{margin:0;color:var(--muted)}.hero>a{font-size:12px;font-weight:800}.search{display:flex;gap:12px;align-items:center;margin:14px 0}.search input{flex:1;min-height:44px;border:1px solid var(--border-strong);border-radius:12px;background:var(--card);color:var(--fg);padding:0 14px;font:inherit}.search span{font-size:11px;color:var(--muted)}.grid{display:grid;gap:14px}.publisher{padding:20px;border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--shadow-sm)}.publisher-head{display:flex;justify-content:space-between;gap:20px}.publisher h2{margin:5px 0 2px;font-size:24px}.signals{display:grid;grid-template-columns:auto auto;gap:3px 7px;align-content:start;text-align:right}.signals small{color:var(--muted);font-size:10px}.packages{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;margin-top:16px}.package{display:grid;gap:5px;padding:11px;border:1px solid var(--border);border-radius:11px;background:var(--bg-soft);min-width:0}.package strong,.package code{overflow-wrap:anywhere}.package code,.package span,.package a{font-size:10px}.package span{color:var(--muted)}.empty{text-align:center;color:var(--muted);padding:30px}@media(max-width:700px){.hero,.publisher-head{align-items:flex-start;flex-direction:column}.signals{text-align:left}}
</style>
