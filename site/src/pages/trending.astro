---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u } from '../lib/urls';
import { DETAIL_THRESHOLD } from '../lib/threshold';

let items: any[] = [];
try {
  const index = JSON.parse(readFileSync(resolve('public', 'catalog', 'search-index-v3.json'), 'utf8'));
  items = Array.isArray(index.items) ? index.items : [];
} catch { /* generated at build time */ }

const ranked = [...items]
  .sort((a,b) => Number(b.rank || 0) - Number(a.rank || 0) || Number(b.stars || 0) - Number(a.stars || 0) || Date.parse(b.updated_at || '') - Date.parse(a.updated_at || ''))
  .slice(0, 100);
const hrefFor = (item: any) => item.has_safe_release && Number(item.stars || 0) >= DETAIL_THRESHOLD
  ? u(`/package/${item.type}/${item.id}`)
  : item.repo ? `https://github.com/${item.repo}` : u('/');
---

<Layout title="Trending · DSH Marketplace" description="Trending Registry V4 packages">
  <section class="head"><span>Search Index V3</span><h1>Trending</h1><p>Registry-backed package ranking across Plugin, MCP, Skill and Agent resources.</p></section>
  <ol class="list">
    {ranked.map((item, index) => (
      <li>
        <span class={`rank ${index < 3 ? 'top' : ''}`}>{index + 1}</span>
        <a class="main" href={hrefFor(item)} target={hrefFor(item).startsWith('https://github.com/') ? '_blank' : undefined} rel={hrefFor(item).startsWith('https://github.com/') ? 'noopener noreferrer' : undefined}>
          <div><strong>{item.name || item.id}</strong><span>{String(item.type).toUpperCase()}</span></div>
          <code>{item.type}:{item.id}</code>
          <p>{item.description || item.repo}</p>
        </a>
        <div class="metrics"><strong>★ {Number(item.stars || 0).toLocaleString()}</strong><small>{item.updated_at ? new Date(item.updated_at).toISOString().slice(0,10) : '—'}</small></div>
      </li>
    ))}
  </ol>
</Layout>

<style>
  .head{text-align:center;padding:32px 0 20px}.head>span{font-size:10px;font-weight:900;letter-spacing:.1em;color:var(--accent);text-transform:uppercase}.head h1{margin:5px 0;font-size:clamp(38px,5vw,52px);letter-spacing:-.045em}.head p{margin:0;color:var(--muted)}.list{max-width:1200px;margin:12px auto 0;padding:0;list-style:none;display:grid;gap:9px}.list li{display:flex;align-items:center;gap:14px;padding:13px 16px;border:1px solid var(--border);border-radius:14px;background:var(--card);box-shadow:var(--shadow-sm)}.rank{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:var(--bg-soft);font-weight:900;color:var(--muted)}.rank.top{background:var(--accent);color:white}.main{min-width:0;flex:1;color:var(--fg);text-decoration:none}.main>div{display:flex;gap:8px;align-items:center}.main strong{font-size:15px;overflow-wrap:anywhere}.main>div span{font-size:9px;font-weight:900;color:var(--accent);background:var(--accent-soft);border-radius:999px;padding:3px 6px}.main code{font-size:10px;color:var(--muted)}.main p{margin:4px 0 0;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.metrics{display:flex;flex-direction:column;align-items:flex-end;min-width:90px}.metrics strong{font-size:12px}.metrics small{font-size:10px;color:var(--muted)}@media(max-width:650px){.list li{align-items:flex-start}.metrics{min-width:65px}.main p{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}}
</style>
