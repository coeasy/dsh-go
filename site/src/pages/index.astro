---
import Layout from '../layouts/Layout.astro';
import PluginCard from '../components/PluginCard.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u } from '../lib/urls';
import { fmtK } from '../lib/format';
import {
  DEFAULT_PACKAGE_VERSION,
  HOME_TOP_LIMIT,
  POPULAR_STARS_MAX,
  POPULAR_STARS_MIN,
  ecosystemType,
  findRegistryMatchForLegacy,
  selectHomeTop100,
} from '../lib/marketplace';

let data: any = { meta: { count: 0, stats: {} }, plugins: [] };
let registry: any = { plugins: [] };
try {
  data = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf-8'));
} catch {
  // 本地未运行 sync 时降级为空数据（不影响构建）
}
try {
  registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf-8'));
} catch {
  // Registry 缺失时仍保留 legacy catalog 浏览能力
}

const { meta, plugins } = data;
const visiblePlugins = (plugins as any[]).filter((p: any) => !p.deprecated && !p.disabled);
const homePlugins = selectHomeTop100(visiblePlugins);
const recommended = homePlugins.map((plugin: any) => {
  const registryItem = findRegistryMatchForLegacy(plugin, registry.plugins || []);
  const type = registryItem ? ecosystemType(registryItem) : 'plugin';
  const version = String(registryItem?.version || plugin.version || DEFAULT_PACKAGE_VERSION);
  const id = String(registryItem?.id || plugin.id || plugin.package_id || plugin.slug || '');
  return {
    ...plugin,
    runtimeType: type,
    runtimeVersion: version,
    runtimeIdentity: `${type}:${id}`,
    runtimeInstall: registryItem ? `dsh ${type} install ${id}@${version}` : plugin.install_cmd,
    capabilities: Array.isArray(registryItem?.capabilities) ? registryItem.capabilities : [],
  };
});

const topStars = recommended.slice(0, 3);
const verifiedRate = recommended.length ? Math.round((recommended.filter((p: any) => p.verified).length / recommended.length) * 100) : 0;
const catCount = new Set(recommended.map((p: any) => p.category).filter(Boolean)).size;
const langCounts: Record<string, number> = {};
for (const p of recommended) {
  const language = p.language || 'Unknown';
  langCounts[language] = (langCounts[language] || 0) + 1;
}
const topLangs = Object.entries(langCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 9)
  .map(([lang]) => lang);
const updatedAt = meta.updated_at ? new Date(meta.updated_at).toISOString().slice(0, 10) : '—';
---

<Layout title="DSH Go · DeepSeek Harness 插件市场">
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <span class="curation-label">CURATED TOP {HOME_TOP_LIMIT} · {POPULAR_STARS_MIN}–{POPULAR_STARS_MAX} ★</span>
    <h1 data-i18n="hero_title" class="grad-text">DeepSeek Harness 插件市场</h1>
    <p class="sub">收录 {visiblePlugins.length} 个活跃 dsh-plugin；首页默认只推荐 {POPULAR_STARS_MIN}–{POPULAR_STARS_MAX} Star 的热门仓库，超过 1 万 Star 不参与 Top100。</p>
    <div class="hero-stats">
      <span class="pill"><b>{recommended.length}</b><i>首页 Top</i></span>
      <span class="pill"><b>{POPULAR_STARS_MIN}–{fmtK(POPULAR_STARS_MAX)}</b><i>推荐 Star 区间</i></span>
      <span class="pill"><b>{verifiedRate}%</b><i data-i18n="f_verified">已验证</i></span>
      <span class="pill"><b>{catCount}</b><i data-i18n="stats_cat">分类分布</i></span>
      <span class="pill"><b>{updatedAt}</b><i data-i18n="hero_synced">数据更新</i></span>
    </div>
    <div class="top3">
      {topStars.map((p: any, i: number) => (
        <a href={u(`/plugin/${p.slug}`)} class="top-item">
          <span class={`top-rank r${i + 1}`}>{i + 1}</span>
          <span class="top-name">{p.name}</span>
          <span class="top-star">★{fmtK(p.stars)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="controls">
    <SearchBar />
    <CategoryFilter />
  </section>

  {topLangs.length > 1 && (
    <div class="lang-line">
      <span class="lang-label" data-i18n="f_language">语言</span>
      <button class="chip lang-chip" data-lang="all" data-i18n="f_all_langs">全部语言</button>
      {topLangs.map((lang: string) => <button class="chip lang-chip" data-lang={lang}>{lang}</button>)}
    </div>
  )}

  <section class="guide" data-i18n="guide" aria-label="how to install">
    <div class="guide-step"><span class="g-num">1</span><b data-i18n="guide_s1_t">查找</b><i>从 100–5000★ 热门仓库中筛选</i></div>
    <div class="g-arrow" aria-hidden="true">→</div>
    <div class="guide-step"><span class="g-num">2</span><b data-i18n="guide_s2_t">复制命令</b><i>统一显示 Registry 版本</i></div>
    <div class="g-arrow" aria-hidden="true">→</div>
    <div class="guide-step"><span class="g-num">3</span><b data-i18n="guide_s3_t">终端运行</b><i>本地安装，重启后激活</i></div>
  </section>

  <div class="result-line">
    <span id="result-count" data-results={recommended.length}>首页 Top {recommended.length}</span>
    <a href={u('/ecosystem')}>查看完整 Ecosystem →</a>
  </div>

  <section id="grid" class="grid">
    {recommended.map((p: any) => (
      <PluginCard
        slug={p.slug} name={p.name} description={p.description} stars={p.stars}
        category={p.category} verified={p.verified} trend={p.trend_score}
        tags={p.topics} isNew={p.first_seen && (Date.now() - new Date(p.first_seen).getTime()) < 7 * 864e5}
        created={p.created_at} updated={p.updated_at} full_name={p.full_name}
        install_cmd={p.runtimeInstall} language={p.language}
        version={p.runtimeVersion} type={p.runtimeType} identity={p.runtimeIdentity}
        capabilities={p.capabilities}
      />
    ))}
  </section>
  <div id="empty" class="empty" hidden data-i18n="empty_msg">没有匹配的插件，换个关键词试试？</div>

  <script src={u('/scripts/app.js')} is:inline></script>
</Layout>

<style>
  .hero { text-align: center; padding: 34px 0 26px; position: relative; }
  .hero-glow {
    position: absolute; inset: -40px -10% 0; z-index: -1; pointer-events: none;
    background: radial-gradient(420px 200px at 50% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 75%);
  }
  .curation-label {
    display: inline-flex; margin-bottom: 10px; padding: 4px 11px; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); background: var(--accent-soft);
    color: var(--accent); font-size: 11px; font-weight: 800; letter-spacing: .06em;
  }
  .hero h1 { font-size: 34px; margin: 0 0 10px; letter-spacing: -.02em; font-weight: 800; }
  .sub { color: var(--muted); font-size: 15px; margin: 0 auto 16px; max-width: 820px; }
  .hero-stats { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 18px; }
  .pill {
    display: inline-flex; align-items: baseline; gap: 7px;
    border: 1px solid var(--border); border-radius: 999px; padding: 6px 16px;
    background: var(--card); box-shadow: var(--shadow-sm);
  }
  .pill b { font-size: 16px; font-weight: 800; color: var(--accent); }
  .pill i { font-style: normal; font-size: 12.5px; color: var(--muted); }
  .top3 { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .top-item {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--border); border-radius: 999px; padding: 5px 14px 5px 6px;
    font-size: 13px; background: var(--card); box-shadow: var(--shadow-sm);
    transition: transform .15s, box-shadow .15s, border-color .15s;
  }
  .top-item:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); text-decoration: none; }
  .top-rank {
    width: 22px; height: 22px; border-radius: 999px; font-size: 12px; font-weight: 800;
    display: inline-flex; align-items: center; justify-content: center; color: #fff;
  }
  .top-rank.r1 { background: linear-gradient(135deg, #f59e0b, #f97316); }
  .top-rank.r2 { background: linear-gradient(135deg, #94a3b8, #64748b); }
  .top-rank.r3 { background: linear-gradient(135deg, #d97706, #b45309); }
  .top-name { font-weight: 600; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .top-star { color: var(--amber); font-weight: 700; }
  .controls { margin: 10px 0 20px; }
  .lang-line { display: flex; gap: 7px; align-items: center; flex-wrap: wrap; margin: 0 0 14px; }
  .lang-label { font-size: 12.5px; color: var(--muted); font-weight: 600; margin-right: 2px; }
  .chip.lang-chip {
    border: 1px solid var(--border); background: var(--card); color: var(--muted);
    border-radius: 999px; padding: 3px 11px; font-size: 12px; cursor: pointer;
    transition: color .15s, border-color .15s, background .15s, box-shadow .15s, transform .15s;
    box-shadow: var(--shadow-sm);
  }
  .chip.lang-chip:hover { color: var(--fg); border-color: var(--border-strong); transform: translateY(-1px); }
  .chip.lang-chip.active {
    background: var(--accent-soft); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    font-weight: 600; box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .guide {
    display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;
    border: 1px solid var(--border); border-radius: 14px; background: var(--card);
    padding: 14px 22px; margin: 0 0 18px; box-shadow: var(--shadow-sm);
  }
  .guide-step { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .guide-step b { color: var(--fg); font-weight: 700; font-size: 13.5px; }
  .g-num {
    width: 22px; height: 22px; border-radius: 999px; flex: none;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--accent-soft); color: var(--accent); font-weight: 800; font-size: 12.5px;
  }
  .g-arrow { color: var(--border-strong); font-weight: 600; }
  .result-line {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    margin: 0 0 12px; font-size: 13px; color: var(--muted);
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 14px; }
  .empty { text-align: center; color: var(--muted); padding: 40px 0; }
  @media (max-width: 640px) {
    .hero h1 { font-size: 26px; }
    .hero { padding: 22px 0 18px; }
    .g-arrow { display: none; }
  }
</style>
