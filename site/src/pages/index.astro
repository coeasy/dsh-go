---
import Layout from '../layouts/Layout.astro';
import MarketplaceV2 from '../components/MarketplaceV2.astro';
import { LANGUAGE_LABELS, SUPPORTED_LANGS } from '../i18n/config';
import { u } from '../lib/urls';
---

<Layout title="DSH Marketplace · Registry V4" description="DSH Registry V4 Marketplace for Plugin, MCP, Skill and Agent packages.">
  <div class="platform-links" aria-label="DSH Marketplace platform navigation">
    <a href={u('/')}><strong>DSH Marketplace</strong><span>Registry V4</span></a>
    <a href={u('/trust')}><strong>Trust Center</strong><span>Security & publisher identity</span></a>
    <a href={u('/publishers/')}><strong>Publishers</strong><span>Verified package ownership</span></a>
    <div class="languages">
      {SUPPORTED_LANGS.map((lang) => <a href={u(`/${lang}/`)} hreflang={lang}>{LANGUAGE_LABELS[lang]}</a>)}
    </div>
  </div>
  <MarketplaceV2 />
</Layout>

<style>
  .platform-links{display:flex;align-items:center;gap:12px;margin:14px 0 0;padding:10px 14px;border:1px solid var(--border);border-radius:14px;background:var(--card);font-size:12px}.platform-links>a{display:flex;gap:7px;align-items:center;color:var(--fg);text-decoration:none}.platform-links span{color:var(--muted)}.languages{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap}.languages a{padding:4px 7px;border-radius:999px;color:var(--muted);text-decoration:none;font-size:11px}@media(max-width:760px){.platform-links{align-items:flex-start;flex-direction:column}.languages{margin-left:0}}
</style>
