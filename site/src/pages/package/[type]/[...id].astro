---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import { MESSAGES } from '../../../i18n/messages';
import { DETAIL_THRESHOLD } from '../../../lib/threshold';
import { u } from '../../../lib/urls';

type Release = {
  version: string;
  channel: string;
  commit: string;
  published_at?: string;
  dependencies?: Array<{ type?: string; id?: string; range?: string; optional?: boolean }>;
  compatibility?: Record<string, unknown>;
  permissions?: string[];
  artifact?: Record<string, unknown>;
  security?: Record<string, any>;
  capabilities?: string[];
  yanked?: boolean;
  revoked?: boolean;
};
type Package = {
  type: string;
  id: string;
  publisher_id?: string;
  source?: { repo?: string };
  metadata?: Record<string, any>;
  releases: Release[];
};
type Registry = { revision: string; packages: Package[] };

export function getStaticPaths() {
  let data: Registry;
  try {
    data = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v4.json'), 'utf8')) as Registry;
  } catch {
    data = { revision: '', packages: [] };
  }
  return data.packages
    .filter((pkg) => Number(pkg.metadata?.stars || 0) >= DETAIL_THRESHOLD)
    .filter((pkg) => pkg.releases.some((release) => !release.revoked && !release.yanked))
    .map((pkg) => ({
      params: { type: pkg.type, id: pkg.id },
      props: { pkg, registryRevision: data.revision },
    }));
}

const { pkg, registryRevision } = Astro.props as { pkg: Package; registryRevision: string };
const releases = [...pkg.releases].filter((release) => !release.revoked && !release.yanked);
const stable = releases.find((release) => release.channel === 'stable') || releases[0];
const coordinate = `${pkg.type}:${pkg.id}@${stable?.version || '*'}`;
const sourceHref = pkg.source?.repo ? `https://github.com/${pkg.source.repo}` : '';
const deepLink = `dsh://package/install?${new URLSearchParams({ spec: coordinate, channel: stable?.channel || 'stable' }).toString()}`;
const title = String(pkg.metadata?.name || pkg.id);
const description = String(pkg.metadata?.description || pkg.source?.repo || '');
const security = stable?.security || {};
const cryptoVerified = security.cryptographic_signature_verified === true || security.signature?.cryptographic_verified === true;
const publisherVerified = security.publisher_verified === true || pkg.metadata?.verified === true;
---

<Layout title={`${title} · DSH Marketplace`} description={description}>
  <article class="package-detail" data-package-detail>
    <a class="back" href={u('/')} data-msg="back_marketplace">← Marketplace</a>
    <header class="hero">
      <div>
        <div class="badges">
          <span>{pkg.type.toUpperCase()}</span>
          {pkg.metadata?.verified && <span>✓ <i data-msg="verified">Verified</i></span>}
        </div>
        <h1>{title}</h1>
        <code>{pkg.type}:{pkg.id}</code>
        <p>{description}</p>
      </div>
      <div class="hero-meta"><strong>★ {Number(pkg.metadata?.stars || 0).toLocaleString()}</strong><span>{stable?.version || '—'}</span></div>
    </header>

    <section class="install-panel">
      <div>
        <strong data-msg="latest_release">Latest safe release</strong>
        <code>{coordinate}</code>
        <p data-msg="local_install_notice">Installation is executed only by the local DSH runtime after explicit confirmation.</p>
      </div>
      <div class="actions">
        {sourceHref && <a class="secondary" href={sourceHref} target="_blank" rel="noopener noreferrer" data-msg="source">Source ↗</a>}
        <button class="secondary" type="button" data-copy={coordinate} data-msg="install">Copy install</button>
        <a class="primary" href={deepLink} data-msg="open_dsh">Open in DSH</a>
      </div>
    </section>

    <div class="detail-grid">
      <main>
        <section><h2 data-msg="package_overview">Package overview</h2><dl><div><dt data-msg="publisher">Publisher</dt><dd>{pkg.publisher_id || '—'}</dd></div><div><dt data-msg="repository">Repository</dt><dd>{pkg.source?.repo || '—'}</dd></div><div><dt>Registry</dt><dd><code>{registryRevision?.slice(0, 16) || '—'}</code></dd></div><div><dt>Commit</dt><dd><code>{stable?.commit || '—'}</code></dd></div></dl></section>
        <section><h2 data-msg="releases">Releases</h2><div class="release-list">{releases.map((release) => <div><strong>{release.version}</strong><span>{release.channel}</span><code>{release.commit.slice(0, 12)}</code></div>)}</div></section>
        <section><h2 data-msg="dependencies">Dependencies</h2>{stable?.dependencies?.length ? <ul>{stable.dependencies.map((dependency) => <li><code>{dependency.type}:{dependency.id}@{dependency.range || '*'}</code>{dependency.optional ? ' · optional' : ''}</li>)}</ul> : <p>—</p>}</section>
        <section><h2 data-msg="permissions">Permissions</h2>{stable?.permissions?.length ? <div class="chips">{stable.permissions.map((permission) => <code>{permission}</code>)}</div> : <p>—</p>}</section>
        <section><h2 data-msg="compatibility">Compatibility</h2><pre>{JSON.stringify(stable?.compatibility || {}, null, 2)}</pre></section>
      </main>
      <aside>
        <section><h2 data-msg="security">Security</h2><div class="security-row"><span>Immutable commit</span><strong class={stable?.commit ? 'ok' : 'bad'}>{stable?.commit ? '✓' : '×'}</strong></div><div class="security-row"><span>Publisher verified</span><strong class={publisherVerified ? 'ok' : ''}>{publisherVerified ? '✓' : '—'}</strong></div><div class="security-row"><span>Cryptographic signature verified</span><strong class={cryptoVerified ? 'ok' : ''}>{cryptoVerified ? '✓' : '—'}</strong></div><p class="security-note">A declared signature or digest is not treated as cryptographically trusted unless signer verification is explicitly successful.</p></section>
        <section><h2>Capabilities</h2><div class="chips">{(stable?.capabilities || []).map((capability) => <code>{capability}</code>)}</div></section>
      </aside>
    </div>
  </article>
</Layout>

<script is:inline define:vars={{ messages: MESSAGES }}>
  (() => {
    const root = document.querySelector('[data-package-detail]');
    if (!root) return;
    const lang = () => messages[document.documentElement.lang] ? document.documentElement.lang : 'en';
    const t = (key) => messages[lang()][key] || messages.en[key] || key;
    const apply = () => root.querySelectorAll('[data-msg]').forEach((node) => {
      const key = node.getAttribute('data-msg');
      if (key) node.textContent = t(key);
    });
    root.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-copy]');
      if (!button) return;
      await navigator.clipboard.writeText(`dsh package install ${button.dataset.copy}`);
      button.textContent = t('copied');
      setTimeout(() => { button.textContent = t('install'); }, 1400);
    });
    document.addEventListener('dsh:languagechange', apply);
    apply();
  })();
</script>

<style>
  .package-detail{max-width:1180px;margin:26px auto 80px}.back{display:inline-block;margin-bottom:12px;color:var(--muted);font-size:12px;font-weight:800}.hero,.install-panel,.detail-grid section{border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--shadow-sm)}.hero{display:flex;justify-content:space-between;gap:24px;padding:28px}.badges{display:flex;gap:6px}.badges span{font-size:10px;font-weight:900;color:var(--accent);background:var(--accent-soft);padding:4px 7px;border-radius:999px}.badges i{font-style:normal}.hero h1{margin:10px 0 3px;font-size:clamp(34px,5vw,54px);letter-spacing:-.045em}.hero p{max-width:760px;color:var(--muted);line-height:1.65}.hero-meta{text-align:right;display:flex;flex-direction:column;gap:8px;color:var(--muted)}.hero-meta strong{color:var(--fg);font-size:18px}.install-panel{display:flex;justify-content:space-between;gap:24px;align-items:center;margin:14px 0;padding:18px}.install-panel div>code{display:block;margin-top:6px}.install-panel p{margin:7px 0 0;color:var(--muted);font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions a,.actions button{display:inline-flex;align-items:center;min-height:38px;padding:0 12px;border-radius:10px;font:inherit;font-size:12px;font-weight:800;text-decoration:none;cursor:pointer}.secondary{border:1px solid var(--border-strong);background:var(--card);color:var(--fg)}.primary{border:1px solid var(--accent);background:var(--accent);color:white}.detail-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:14px}.detail-grid main,.detail-grid aside{display:grid;align-content:start;gap:14px}.detail-grid section{padding:20px}.detail-grid h2{margin:0 0 14px;font-size:17px}dl{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0}dl div{padding:10px;border:1px solid var(--border);border-radius:10px;background:var(--bg-soft)}dt{font-size:10px;color:var(--muted);text-transform:uppercase}dd{margin:5px 0 0;overflow-wrap:anywhere}.release-list{display:grid;gap:7px}.release-list>div{display:grid;grid-template-columns:1fr auto auto;gap:10px;padding:10px;border-bottom:1px solid var(--border);align-items:center}.chips{display:flex;flex-wrap:wrap;gap:6px}.chips code{padding:5px 7px;border-radius:8px;background:var(--bg-soft)}pre{overflow:auto;padding:12px;border-radius:10px;background:var(--bg-soft);font-size:11px}.security-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:12px}.security-row strong.ok{color:var(--green)}.security-row strong.bad{color:var(--red)}.security-note{color:var(--muted);font-size:11px;line-height:1.5}@media(max-width:800px){.hero,.install-panel{align-items:flex-start;flex-direction:column}.hero-meta{text-align:left}.detail-grid{grid-template-columns:1fr}dl{grid-template-columns:1fr}.release-list>div{grid-template-columns:1fr}}
</style>
