---
import Layout from '../../layouts/Layout.astro';
import MarketplaceDetailHero from '../../components/MarketplaceDetailHero.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u } from '../../lib/urls';
import { DETAIL_THRESHOLD } from '../../lib/threshold';
import { alignRegistryItem, buildLegacyRepoIndex } from '../../lib/marketplace';

function publisherVerified(item: any) {
  const owner = item?.source?.repo?.split('/')[0]?.toLowerCase();
  return item?.publisher?.provider === 'github' && item?.publisher?.id && owner === String(item.publisher.id).toLowerCase();
}

function evidence(item: any) {
  return [
    { label: 'Immutable commit', ok: /^[a-f0-9]{40}$/i.test(item?.source?.commit || '') },
    { label: 'Registry verified', ok: item?.metadata?.verified === true },
    { label: 'Publisher owner match', ok: publisherVerified(item) },
    { label: 'Provenance declared', ok: Boolean(item?.security?.provenance) },
    { label: 'Signature declared', ok: Boolean(item?.security?.signature) },
    { label: 'SBOM declared', ok: Boolean(item?.security?.sbom) },
    { label: 'License declared', ok: Boolean(item?.security?.license) },
  ];
}

function preferVariant(current: any | undefined, candidate: any) {
  if (!current) return candidate;
  const currentStable = (current.registry?.channel || current.registry?.release_channel || 'stable') === 'stable';
  const candidateStable = (candidate.registry?.channel || candidate.registry?.release_channel || 'stable') === 'stable';
  if (currentStable !== candidateStable) return candidateStable ? candidate : current;
  return String(candidate.version).localeCompare(String(current.version), undefined, { numeric: true, sensitivity: 'base' }) > 0 ? candidate : current;
}

export async function getStaticPaths() {
  let registryItems: any[] = [];
  let legacyPlugins: any[] = [];
  try {
    const registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf8'));
    registryItems = registry.plugins || [];
  } catch { /* keep build resilient */ }
  try {
    const legacy = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf8'));
    legacyPlugins = legacy.plugins || [];
  } catch { /* legacy catalog is optional */ }

  const legacyIndex = buildLegacyRepoIndex(legacyPlugins);
  const byIdentity = new Map<string, any>();
  for (const raw of registryItems) {
    const aligned = alignRegistryItem(raw, legacyIndex);
    const key = `${aligned.type}:${aligned.id}`;
    byIdentity.set(key, preferVariant(byIdentity.get(key), aligned));
  }

  const groups = new Map<string, any[]>();
  for (const aligned of byIdentity.values()) {
    const group = groups.get(aligned.id) || [];
    group.push(aligned);
    groups.set(aligned.id, group);
  }
  const typeOrder: Record<string, number> = { plugin: 0, mcp: 1, skill: 2, agent: 3 };
  return [...groups.entries()].map(([id, variants]) => ({
    params: { id },
    props: { variants: variants.sort((left, right) => typeOrder[left.type] - typeOrder[right.type]) },
  }));
}

const { variants } = Astro.props as { variants: any[] };
const packageId = String(variants[0]?.id || 'unknown');
const ecosystemHref = u('/ecosystem');
---

<Layout title={`${packageId} · Ecosystem · DSH Go`} description={`DSH Ecosystem package ${packageId}`}>
  <main class="detail-shell">
    <nav class="breadcrumbs"><a href={ecosystemHref}>Ecosystem</a><span>／</span><span>{packageId}</span></nav>

    {variants.length > 1 && (
      <section class="variant-switcher">
        <div><span class="label">PACKAGE VARIANTS</span><strong>同一 ID 的不同 Runtime 类型</strong></div>
        <div class="variant-tabs" role="tablist" aria-label="package types">
          {variants.map((variant) => <a href={`?type=${variant.type}`} data-type-tab={variant.type}>{variant.type.toUpperCase()}</a>)}
        </div>
      </section>
    )}

    {variants.map((display) => {
      const item = display.registry;
      const permissions = Array.isArray(item?.permissions) ? item.permissions : [];
      const compatibility = item?.compatibility || {};
      const dependencies = Array.isArray(item?.dependencies) ? item.dependencies : [];
      const checks = evidence(item);
      const highRisk = permissions.filter((permission: string) => ['filesystem.write', 'network.unrestricted', 'shell', 'secrets.read', 'process.spawn'].includes(permission));
      const installLink = `dsh://install?${new URLSearchParams({ id: display.id, version: display.version, type: display.type }).toString()}`;
      const legacyDetail = display.legacy?.slug && Number(display.stars || 0) >= DETAIL_THRESHOLD ? u(`/plugin/${display.legacy.slug}`) : '';
      const apiHref = `${u(`/api/v1/ecosystem/${encodeURIComponent(display.id)}`)}?type=${display.type}`;
      return (
        <section class="variant-panel" data-variant-type={display.type}>
          <MarketplaceDetailHero
            name={display.name}
            description={display.description}
            repo={display.repo}
            repoUrl={display.repoUrl}
            type={display.type}
            version={display.version}
            identity={display.key}
            category={display.category}
            verified={display.verified}
            language={display.language}
            stars={display.stars}
            commit={display.commit}
            installCommand={display.installCommand}
            primaryHref={installLink}
            primaryLabel="用 DSH 安装"
            secondaryHref={legacyDetail || undefined}
            secondaryLabel="dsh-plugin 详情"
          />

          <section class="alignment-note">
            <b>展示来源：</b>
            <span>Runtime / Version / Commit 来自 Registry V3；名称 / Star / 描述 / 语言按 GitHub repository 与原 dsh-plugin catalog 对齐。</span>
            <a href={apiHref}>API v1 ↗</a>
          </section>

          <div class="detail-grid">
            <section class="panel">
              <div class="panel-title"><h2>来源与版本</h2><span>Immutable identity</span></div>
              <dl>
                <dt>Identity</dt><dd><code>{display.key}</code></dd>
                <dt>Repository</dt><dd>{display.repoUrl ? <a href={display.repoUrl} target="_blank" rel="noreferrer">{display.repo}</a> : display.repo || '—'}</dd>
                <dt>Version</dt><dd><code>{display.version}</code></dd>
                <dt>Commit</dt><dd><code title={display.commit}>{display.commit || 'not pinned'}</code></dd>
                <dt>Channel</dt><dd>{item?.channel || item?.release_channel || 'stable'}</dd>
                <dt>Manifest</dt><dd>{item?.metadata?.manifest_file || 'legacy catalog'}</dd>
              </dl>
            </section>

            <section class="panel">
              <div class="panel-title"><h2>权限</h2><span>{highRisk.length ? `${highRisk.length} high risk` : 'least privilege'}</span></div>
              {permissions.length ? (
                <ul class="permissions">{permissions.map((permission: string) => <li class={highRisk.includes(permission) ? 'risk' : ''}>{permission}{highRisk.includes(permission) ? ' · 需确认' : ''}</li>)}</ul>
              ) : <p class="muted">未声明高风险权限。</p>}
            </section>

            <section class="panel">
              <div class="panel-title"><h2>兼容性</h2><span>Runtime gate</span></div>
              <dl>
                <dt>OS</dt><dd>{(compatibility.os || ['any']).join(', ')}</dd>
                <dt>Arch</dt><dd>{(compatibility.arch || ['any']).join(', ')}</dd>
                <dt>Node</dt><dd>{compatibility.node || 'unspecified'}</dd>
                <dt>Runtime</dt><dd>{compatibility.runtime || compatibility.dsh_runtime || 'unspecified'}</dd>
                <dt>Client</dt><dd>{compatibility.client || compatibility.dsh_client || 'unspecified'}</dd>
              </dl>
            </section>

            <section class="panel">
              <div class="panel-title"><h2>供应链证据</h2><span>{checks.filter((check) => check.ok).length}/{checks.length}</span></div>
              <ul class="checks">{checks.map((check) => <li class={check.ok ? 'ok' : 'missing'}>{check.ok ? '✓' : '○'} {check.label}</li>)}</ul>
              <p class="muted">“declared” 只表示 Registry 中存在证据引用，不等于已完成密码学验证。</p>
            </section>

            <section class="panel">
              <div class="panel-title"><h2>Publisher</h2><span>Ownership</span></div>
              <dl>
                <dt>Publisher</dt><dd>{item?.publisher?.id || 'not declared'} {publisherVerified(item) ? '✓ owner match' : ''}</dd>
                <dt>Provenance</dt><dd>{item?.security?.provenance ? 'declared' : 'not declared'}</dd>
                <dt>Signature</dt><dd>{item?.security?.signature ? 'declared' : 'not declared'}</dd>
                <dt>SBOM</dt><dd>{item?.security?.sbom ? 'declared' : 'not declared'}</dd>
                <dt>License</dt><dd>{item?.security?.license || display.legacy?.license || 'not declared'}</dd>
              </dl>
            </section>

            <section class="panel">
              <div class="panel-title"><h2>Catalog 对齐</h2><span>{display.legacy ? 'matched by repository' : 'registry only'}</span></div>
              <dl>
                <dt>Stars</dt><dd>★ {display.stars}</dd>
                <dt>Language</dt><dd>{display.language || '—'}</dd>
                <dt>Category</dt><dd>{display.category || 'other'}</dd>
                <dt>Legacy slug</dt><dd>{display.legacy?.slug || '—'}</dd>
              </dl>
            </section>

            <section class="panel wide">
              <div class="panel-title"><h2>依赖与能力</h2><span>{dependencies.length} dependencies</span></div>
              <div class="chips">{(display.capabilities || []).map((capability: string) => <span>{capability}</span>)}</div>
              <p><strong>Dependencies:</strong> {dependencies.length ? dependencies.map((dependency: any) => typeof dependency === 'string' ? dependency : `${dependency.type ? `${dependency.type}:` : ''}${dependency.id}@${dependency.range || dependency.version || '*'}`).join(', ') : 'none'}</p>
              {Array.isArray(item?.conflicts) && item.conflicts.length > 0 && <p><strong>Conflicts:</strong> {item.conflicts.join(', ')}</p>}
              {Array.isArray(item?.replaces) && item.replaces.length > 0 && <p><strong>Replaces:</strong> {item.replaces.join(', ')}</p>}
              {Array.isArray(item?.provides) && item.provides.length > 0 && <p><strong>Provides:</strong> {item.provides.join(', ')}</p>}
            </section>
          </div>
        </section>
      );
    })}
  </main>

  <script>
    const panels = [...document.querySelectorAll('[data-variant-type]')];
    const tabs = [...document.querySelectorAll('[data-type-tab]')];
    const requested = new URLSearchParams(window.location.search).get('type');
    const available = panels
      .filter((panel) => panel instanceof HTMLElement)
      .map((panel) => panel.dataset.variantType || '');
    const active = requested && available.includes(requested) ? requested : available[0];
    for (const panel of panels) {
      if (!(panel instanceof HTMLElement)) continue;
      panel.hidden = panel.dataset.variantType !== active;
    }
    for (const tab of tabs) {
      if (!(tab instanceof HTMLElement)) continue;
      tab.classList.toggle('active', tab.dataset.typeTab === active);
    }
  </script>
</Layout>

<style>
  .detail-shell { max-width: 1120px; margin: 0 auto; padding: 22px 0 58px; }
  .breadcrumbs { display: flex; gap: 7px; align-items: center; color: var(--muted); font-size: 13px; margin-bottom: 13px; }
  .variant-switcher { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 13px 15px; margin-bottom: 14px; border: 1px solid var(--border); border-radius: 13px; background: var(--card); }
  .variant-switcher>div:first-child { display: grid; gap: 2px; }
  .variant-switcher .label { color: var(--accent); font-size: 10px; font-weight: 850; letter-spacing: .08em; }
  .variant-switcher strong { font-size: 13px; }
  .variant-tabs { display: flex; gap: 7px; flex-wrap: wrap; }
  .variant-tabs a { padding: 5px 9px; border: 1px solid var(--border); border-radius: 999px; background: var(--bg-soft); color: var(--muted); font-size: 11px; font-weight: 800; }
  .variant-tabs a.active { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .variant-tabs a:hover { text-decoration: none; }
  .alignment-note { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; margin: 14px 0 18px; padding: 11px 14px; border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border)); border-radius: 12px; background: var(--accent-soft); color: var(--muted); font-size: 12.5px; }
  .alignment-note b { color: var(--fg); }
  .alignment-note a { margin-left: auto; font-weight: 700; }
  .detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
  .panel { min-width: 0; border: 1px solid var(--border); border-radius: 16px; padding: 18px; background: var(--card); box-shadow: var(--shadow-sm); }
  .panel.wide { grid-column: 1 / -1; }
  .panel-title { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 13px; }
  .panel-title h2 { margin: 0; font-size: 16px; }
  .panel-title span { color: var(--muted); font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; }
  dl { display: grid; grid-template-columns: 126px minmax(0, 1fr); gap: 9px 12px; margin: 0; font-size: 12.5px; }
  dt { color: var(--muted); }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  dd code { font-size: 11px; overflow-wrap: anywhere; }
  .permissions, .checks { margin: 0; padding-left: 19px; font-size: 12.5px; }
  .permissions li, .checks li { margin: 6px 0; }
  .permissions .risk { color: var(--amber); font-weight: 800; }
  .checks { list-style: none; padding-left: 0; }
  .checks .ok { color: var(--green); font-weight: 700; }
  .checks .missing { color: var(--muted); }
  .muted { color: var(--muted); font-size: 12px; line-height: 1.55; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .chips span { padding: 3px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 11px; }
  .panel p { overflow-wrap: anywhere; font-size: 12.5px; }
  .variant-panel[hidden] { display: none; }
  @media (max-width: 720px) {
    .variant-switcher { align-items: flex-start; flex-direction: column; }
    .detail-grid { grid-template-columns: 1fr; }
    .panel.wide { grid-column: auto; }
    dl { grid-template-columns: 1fr; gap: 3px; }
    dd { margin-bottom: 7px; }
    .alignment-note a { margin-left: 0; width: 100%; }
  }
</style>
