---
import Layout from '../../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u } from '../../lib/urls';
import { fmtK } from '../../lib/format';
import { ecosystemType, normalizeRepo } from '../../lib/marketplace';

export async function getStaticPaths() {
  let entries: any[] = [];
  let catalogPlugins: any[] = [];
  try {
    const registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf8'));
    entries = registry.plugins || [];
  } catch { /* no registry => no ecosystem details */ }
  try {
    const catalog = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf8'));
    catalogPlugins = catalog.plugins || [];
  } catch { /* legacy enrichment is optional */ }

  const catalogByRepo = new Map<string, any>();
  for (const plugin of catalogPlugins) {
    const repo = normalizeRepo(plugin.full_name || plugin.repo_url);
    if (repo) catalogByRepo.set(repo, plugin);
  }

  const groups = new Map<string, any[]>();
  for (const entry of entries) {
    const group = groups.get(String(entry.id)) || [];
    group.push(entry);
    groups.set(String(entry.id), group);
  }

  return [...groups.entries()].map(([id, allEntries]) => {
    const byType = new Map<string, any[]>();
    for (const entry of allEntries) {
      const type = ecosystemType(entry);
      const group = byType.get(type) || [];
      group.push(entry);
      byType.set(type, group);
    }
    const variants = [...byType.entries()].map(([type, typeEntries]) => {
      const sorted = [...typeEntries].sort((left, right) => String(right.version || '').localeCompare(String(left.version || '')));
      const current = sorted[0];
      const repo = normalizeRepo(current.source?.repo);
      return {
        ...current,
        _type: type,
        _versions: sorted.map((entry) => String(entry.version || '')).filter(Boolean),
        _catalog: repo ? catalogByRepo.get(repo) || null : null,
      };
    });
    return { params: { id }, props: { variants } };
  });
}

const { variants } = Astro.props as { variants: any[] };
const packageId = variants[0]?.id || 'unknown';

function publisherVerified(item: any) {
  const owner = item.source?.repo?.split('/')[0]?.toLowerCase();
  return item.publisher?.provider === 'github' && item.publisher?.id && owner === String(item.publisher.id).toLowerCase();
}
function evidence(item: any) {
  return [
    { label: 'Immutable commit', ok: /^[a-f0-9]{40}$/i.test(item.source?.commit || '') },
    { label: 'Registry verified', ok: item.metadata?.verified === true },
    { label: 'Publisher owner match', ok: Boolean(publisherVerified(item)) },
    { label: 'Provenance', ok: Boolean(item.security?.provenance) },
    { label: 'Signature', ok: Boolean(item.security?.signature) },
    { label: 'SBOM', ok: Boolean(item.security?.sbom) },
    { label: 'License', ok: Boolean(item.security?.license) },
  ];
}
---

<Layout title={`${packageId} · DSH Plugin Marketplace`} description={`DSH ecosystem package ${packageId}`}>
  <article class="detail-shell">
    <a class="back" href={u('/')}>← Marketplace</a>

    {variants.length > 1 && (
      <nav class="variant-tabs" aria-label="ecosystem package types">
        {variants.map((item: any) => <a href={`?type=${item._type}`} data-type-tab={item._type}>{String(item._type).toUpperCase()}</a>)}
      </nav>
    )}

    {variants.map((item: any) => {
      const type = item._type || ecosystemType(item);
      const legacy = item._catalog;
      const name = item.metadata?.name || legacy?.name || item.id;
      const description = item.metadata?.description || legacy?.description || '暂无描述';
      const stars = Number(legacy?.stars ?? item.metadata?.stars ?? 0);
      const verified = item.metadata?.verified === true || legacy?.verified === true;
      const permissions = item.permissions || [];
      const compatibility = item.compatibility || {};
      const dependencies = item.dependencies || [];
      const capabilities = item.capabilities || [];
      const checks = evidence(item);
      const installCommand = `dsh ${type} install ${item.id}@${item.version}`;
      const query = new URLSearchParams({ id: item.id, version: String(item.version), type });
      const deepLink = `dsh://install?${query.toString()}`;
      const highRisk = permissions.filter((permission: string) => ['filesystem.write', 'network.unrestricted', 'shell', 'secrets.read', 'process.spawn'].includes(permission));
      return (
        <section class="variant-panel" data-variant-type={type}>
          <header class="hero-card">
            <div class="hero-top">
              <div class="identity">
                <div class="eyebrow-row">
                  <span class={`kind ${type}`}>{String(type).toUpperCase()}</span>
                  <span class="registry">Registry v{item.version}</span>
                  {legacy && <span>Catalog linked</span>}
                  {verified && <span class="verified">✓ Verified</span>}
                </div>
                <h1>{name}</h1>
                <a class="repo-link" href={`https://github.com/${item.source?.repo}`} target="_blank" rel="noreferrer">{item.source?.repo || item.id} ↗</a>
              </div>
              <div class="hero-actions">
                <a class="primary" href={deepLink}>Install</a>
                <a class="secondary" href="#versions">Versions</a>
              </div>
            </div>
            <p class="description">{description}</p>
            <div class="stat-grid">
              <span><b>{stars > 0 ? `★ ${fmtK(stars)}` : '—'}</b><i>stars</i></span>
              <span><b>v{item.version}</b><i>install version</i></span>
              <span><b>{legacy?.language || '—'}</b><i>language</i></span>
              <span><b>{dependencies.length}</b><i>dependencies</i></span>
              <span><b>{checks.filter((check) => check.ok).length}/{checks.length}</b><i>evidence</i></span>
            </div>
          </header>

          <nav class="section-nav" aria-label="package detail sections">
            <a href="#overview">Overview</a>
            <a href="#install">Install</a>
            <a href="#versions">Versions</a>
            <a href="#security">Security</a>
            <a href="#metadata">Metadata</a>
          </nav>

          <div class="detail-grid">
            <main class="main-col">
              <section id="overview" class="panel">
                <div class="section-title"><span>01</span><div><h2>Overview</h2><p>Registry 运行时身份与原始 dsh-plugin 展示信息已归一到同一页面。</p></div></div>
                <div class="overview-grid">
                  <div><small>Identity</small><strong>{type}:{item.id}</strong></div>
                  <div><small>Repository</small><strong>{item.source?.repo || '—'}</strong></div>
                  <div><small>Catalog</small><strong>{legacy ? 'Linked' : 'Registry only'}</strong></div>
                  <div><small>Channel</small><strong>{item.channel || item.release_channel || 'stable'}</strong></div>
                </div>
                {capabilities.length > 0 && <div class="chips">{capabilities.slice(0, 12).map((capability: string) => <span>{capability}</span>)}</div>}
              </section>

              <section id="install" class="panel install-panel">
                <div class="section-title"><span>02</span><div><h2>Install</h2><p>网页只发起本地安装；完成后不会自动重启客户端。</p></div></div>
                <div class="command-row"><code>{installCommand}</code><button class="copy-install" data-command={installCommand}>Copy</button></div>
                <div class="install-note">安装后请按需要手动重启。Startup Loader 会在启动时按 Registry 固定版本与 commit 再校验。</div>
              </section>

              <section id="versions" class="panel">
                <div class="section-title"><span>03</span><div><h2>Versions</h2><p>同一 type 只展示最新版本，历史版本单独列出，避免详情 panel 重复错乱。</p></div></div>
                <div class="version-table">
                  <div><span>Current</span><strong>v{item.version}</strong><em>Registry install authority</em></div>
                  <div><span>Available</span><strong>{(item._versions || [item.version]).map((version: string) => `v${version}`).join(' · ')}</strong><em>{(item._versions || []).length || 1} version(s)</em></div>
                  <div><span>Catalog version</span><strong>{legacy?.version || legacy?.plugin_version || legacy?.latest_version || 'Discovery only'}</strong><em>不会覆盖 Registry 安装版本</em></div>
                </div>
              </section>

              <section id="security" class="panel">
                <div class="section-title"><span>04</span><div><h2>Security & permissions</h2><p>权限与供应链证据分开呈现，不把“已声明”误写成“已验证”。</p></div></div>
                <div class="security-grid">
                  <div><h3>Permissions</h3>{permissions.length ? <ul>{permissions.map((permission: string) => <li class={highRisk.includes(permission) ? 'risk' : ''}>{permission}{highRisk.includes(permission) ? ' · confirm' : ''}</li>)}</ul> : <p>未声明高风险权限。</p>}</div>
                  <div><h3>Evidence</h3><ul class="checks">{checks.map((check) => <li class={check.ok ? 'ok' : 'missing'}>{check.ok ? '✓' : '○'} {check.label}</li>)}</ul></div>
                </div>
              </section>
            </main>

            <aside class="side-col">
              <section id="metadata" class="panel sticky-panel">
                <h2>Package metadata</h2>
                <dl>
                  <dt>Type</dt><dd>{String(type).toUpperCase()}</dd>
                  <dt>Registry</dt><dd>v{item.version}</dd>
                  <dt>Commit</dt><dd><code>{item.source?.commit ? String(item.source.commit).slice(0, 12) : '—'}</code></dd>
                  <dt>Manifest</dt><dd>{item.metadata?.manifest_file || 'legacy registry entry'}</dd>
                  <dt>Language</dt><dd>{legacy?.language || '—'}</dd>
                  <dt>License</dt><dd>{item.security?.license || legacy?.license || '—'}</dd>
                  <dt>OS</dt><dd>{(compatibility.os || ['any']).join(', ')}</dd>
                  <dt>Arch</dt><dd>{(compatibility.arch || ['any']).join(', ')}</dd>
                  <dt>Runtime</dt><dd>{compatibility.runtime || compatibility.dsh_runtime || 'unspecified'}</dd>
                  <dt>Publisher</dt><dd>{item.publisher?.id || 'not declared'} {publisherVerified(item) ? '✓' : ''}</dd>
                </dl>
                <a class="full-link" href={`https://github.com/${item.source?.repo}`} target="_blank" rel="noreferrer">Open GitHub repository ↗</a>
              </section>
            </aside>
          </div>
        </section>
      );
    })}
  </article>

  <script>
    const panels = [...document.querySelectorAll<HTMLElement>('[data-variant-type]')];
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-type-tab]')];
    const requested = new URLSearchParams(window.location.search).get('type');
    const available = panels.map((panel) => panel.dataset.variantType).filter(Boolean);
    const active = requested && available.includes(requested) ? requested : available[0];
    for (const panel of panels) panel.hidden = panel.dataset.variantType !== active;
    for (const tab of tabs) tab.classList.toggle('active', tab.dataset.typeTab === active);
    for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-install')) {
      button.addEventListener('click', async () => {
        const command = button.dataset.command || '';
        try { await navigator.clipboard.writeText(command); }
        catch { window.prompt('复制安装命令', command); }
        const old = button.textContent;
        button.textContent = 'Copied ✓';
        setTimeout(() => { button.textContent = old; }, 1200);
      });
    }
  </script>
</Layout>

<style>
  .detail-shell{max-width:1160px;margin:0 auto}.back{display:inline-block;margin:4px 0 14px;color:var(--muted);font-size:12px}.variant-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px}.variant-tabs a{border:1px solid var(--border);border-radius:999px;background:var(--card);color:var(--muted);padding:5px 10px;font-size:10.5px;font-weight:750}.variant-tabs a.active{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 45%,var(--border));background:var(--accent-soft)}.variant-panel[hidden]{display:none}
  .hero-card,.panel{border:1px solid var(--border);background:var(--card);border-radius:20px;box-shadow:var(--shadow-sm)}.hero-card{padding:26px;position:relative;overflow:hidden}.hero-card::before{content:'';position:absolute;inset:0 0 auto;height:3px;background:var(--grad-accent)}.hero-top{display:flex;align-items:flex-start;gap:18px}.identity{min-width:0}.eyebrow-row{display:flex;gap:6px;flex-wrap:wrap}.eyebrow-row span{border-radius:999px;padding:3px 8px;background:var(--bg-soft);color:var(--muted);font-size:10px;font-weight:750}.eyebrow-row .registry{color:var(--accent);background:var(--accent-soft)}.eyebrow-row .verified{color:var(--green);background:color-mix(in srgb,var(--green) 12%,transparent)}.kind.mcp{color:#7c3aed}.kind.skill{color:#0891b2}.kind.agent{color:#db2777}.hero-card h1{margin:7px 0 1px;font-size:clamp(28px,4vw,40px);line-height:1.08;letter-spacing:-.04em;overflow-wrap:anywhere}.repo-link{color:var(--muted);font:11px ui-monospace,SFMono-Regular,Menlo,monospace}.hero-actions{margin-left:auto;display:flex;gap:7px;flex-wrap:wrap}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--border);border-radius:10px;padding:8px 12px;font:700 11.5px/1.25 inherit;text-decoration:none}.primary{background:var(--accent);border-color:var(--accent);color:#fff}.secondary{background:var(--card);color:var(--fg)}.primary:hover,.secondary:hover{text-decoration:none;transform:translateY(-1px)}.description{color:var(--muted);font-size:13.5px;max-width:850px;margin:20px 0}.stat-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.stat-grid span{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:12px;background:var(--bg-soft);padding:9px 11px;min-width:0}.stat-grid b{font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.stat-grid i{font-style:normal;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.05em}
  .section-nav{display:flex;gap:18px;overflow:auto;border-bottom:1px solid var(--border);margin:18px 0;padding:0 4px 10px}.section-nav a{color:var(--muted);font-size:11.5px;font-weight:700;white-space:nowrap}.section-nav a:hover{color:var(--fg);text-decoration:none}.detail-grid{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(270px,.8fr);gap:16px;align-items:start}.main-col{display:grid;gap:16px;min-width:0}.panel{padding:22px;min-width:0;scroll-margin-top:88px}.section-title{display:flex;gap:11px;align-items:flex-start;margin-bottom:17px}.section-title>span{color:var(--accent);font-size:10px;font-weight:850}.section-title h2{margin:-2px 0 2px;font-size:17px}.section-title p{margin:0;color:var(--muted);font-size:11.5px}.overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.overview-grid div{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:11px;background:var(--bg-soft);padding:10px}.overview-grid small{color:var(--muted);font-size:9.5px}.overview-grid strong{font-size:11.5px;overflow-wrap:anywhere}.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.chips span{border-radius:999px;background:var(--bg-soft);color:var(--muted);padding:3px 8px;font-size:10px}.command-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px}.command-row code{overflow:auto;border:1px solid var(--border);border-radius:10px;background:var(--bg-soft);padding:10px;font-size:10.5px}.command-row button{border:0;border-radius:10px;background:var(--accent);color:#fff;padding:0 13px;font-weight:750;cursor:pointer}.install-note{margin-top:10px;color:var(--muted);font-size:10.8px}.version-table{display:grid;gap:1px;overflow:hidden;border:1px solid var(--border);border-radius:12px;background:var(--border)}.version-table>div{display:grid;grid-template-columns:120px minmax(0,1fr) minmax(150px,.8fr);gap:10px;background:var(--card);padding:10px 12px;align-items:center}.version-table span,.version-table em{color:var(--muted);font-size:10px;font-style:normal}.version-table strong{font-size:11px;overflow-wrap:anywhere}.security-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.security-grid h3{margin:0 0 8px;font-size:12px}.security-grid p,.security-grid li{color:var(--muted);font-size:10.8px}.risk{color:var(--amber)!important;font-weight:750}.checks{list-style:none;padding:0}.checks .ok{color:var(--green)}.checks .missing{color:var(--muted)}.sticky-panel{position:sticky;top:86px}.sticky-panel h2{margin-top:0;font-size:15px}dl{display:grid;grid-template-columns:86px minmax(0,1fr);gap:8px;margin:0}dt{color:var(--muted);font-size:10px}dd{margin:0;font-size:10.8px;overflow-wrap:anywhere}.full-link{display:block;margin-top:16px;border-top:1px solid var(--border);padding-top:12px;font-size:11px;font-weight:700}
  @media(max-width:780px){.hero-top{flex-direction:column}.hero-actions{margin-left:0}.stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-grid{grid-template-columns:1fr}.sticky-panel{position:static}.overview-grid,.security-grid{grid-template-columns:1fr}.version-table>div{grid-template-columns:1fr;gap:2px}}
</style>
