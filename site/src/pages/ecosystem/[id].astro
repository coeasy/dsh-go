---
import Layout from '../../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u } from '../../lib/urls';
import { fmtK } from '../../lib/format';
import { ecosystemType, normalizeRepo } from '../../lib/marketplace';

export async function getStaticPaths() {
  let entries: any[] = [];
  let catalogPlugins: any[] = [];
  try {
    const registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf8'));
    entries = registry.plugins || [];
  } catch { /* no registry => no ecosystem details */ }
  try {
    const catalog = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf8'));
    catalogPlugins = catalog.plugins || [];
  } catch { /* legacy enrichment is optional */ }

  const catalogByRepo = new Map<string, any>();
  for (const plugin of catalogPlugins) {
    const repo = normalizeRepo(plugin.full_name || plugin.repo_url);
    if (repo) catalogByRepo.set(repo, plugin);
  }

  const groups = new Map<string, any[]>();
  for (const entry of entries) {
    const group = groups.get(String(entry.id)) || [];
    group.push(entry);
    groups.set(String(entry.id), group);
  }

  return [...groups.entries()].map(([id, allEntries]) => {
    const byType = new Map<string, any[]>();
    for (const entry of allEntries) {
      const type = ecosystemType(entry);
      const group = byType.get(type) || [];
      group.push(entry);
      byType.set(type, group);
    }
    const variants = [...byType.entries()].map(([type, typeEntries]) => {
      const sorted = [...typeEntries].sort((left, right) => String(right.version || '').localeCompare(String(left.version || '')));
      const current = sorted[0];
      const repo = normalizeRepo(current.source?.repo);
      return {
        ...current,
        _type: type,
        _versions: sorted.map((entry) => String(entry.version || '')).filter(Boolean),
        _catalog: repo ? catalogByRepo.get(repo) || null : null,
      };
    });
    return { params: { id }, props: { variants } };
  });
}

const { variants } = Astro.props as { variants: any[] };
const packageId = variants[0]?.id || 'unknown';

function publisherVerified(item: any) {
  const owner = item.source?.repo?.split('/')[0]?.toLowerCase();
  return item.publisher?.provider === 'github' && item.publisher?.id && owner === String(item.publisher.id).toLowerCase();
}
function evidence(item: any) {
  return [
    { label: 'Immutable commit', ok: /^[a-f0-9]{40}$/i.test(item.source?.commit || '') },
    { label: 'Registry verified', ok: item.metadata?.verified === true },
    { label: 'Publisher owner match', ok: Boolean(publisherVerified(item)) },
    { label: 'Provenance', ok: Boolean(item.security?.provenance) },
    { label: 'Signature', ok: Boolean(item.security?.signature) },
    { label: 'SBOM', ok: Boolean(item.security?.sbom) },
    { label: 'License', ok: Boolean(item.security?.license) },
  ];
}
---

<Layout title={`${packageId} · DSH Plugin Marketplace`} description={`DSH ecosystem package ${packageId}`}>
  <article class="detail-shell">
    <a class="back" href={u('/')}>← Marketplace</a>

    {variants.length > 1 && (
      <nav class="variant-tabs" aria-label="ecosystem package types">
        {variants.map((item: any) => <a href={`?type=${item._type}`} data-type-tab={item._type}>{String(item._type).toUpperCase()}</a>)}
      </nav>
    )}

    {variants.map((item: any) => {
      const type = item._type || ecosystemType(item);
      const legacy = item._catalog;
      const name = item.metadata?.name || legacy?.name || item.id;
      const description = item.metadata?.description || legacy?.description || '暂无描述';
      const stars = Number(legacy?.stars ?? item.metadata?.stars ?? 0);
      const verified = item.metadata?.verified === true || legacy?.verified === true;
      const permissions = item.permissions || [];
      const compatibility = item.compatibility || {};
      const dependencies = item.dependencies || [];
      const capabilities = item.capabilities || [];
      const checks = evidence(item);
      const installCommand = `dsh ${type} install ${item.id}@${item.version}`;
      const query = new URLSearchParams({ id: item.id, version: String(item.version), type });
      const deepLink = `dsh://install?${query.toString()}`;
      const highRisk = permissions.filter((permission: string) => ['filesystem.write', 'network.unrestricted', 'shell', 'secrets.read', 'process.spawn'].includes(permission));
      const publisherName = item.publisher?.id || item.source?.repo?.split('/')[0] || '';
      const publisherHref = publisherName ? u('/publishers/?id=' + encodeURIComponent(publisherName)) : '';
      const repoHref = item.source?.repo ? `https://github.com/${item.source.repo}` : '';
      const readmeHref = repoHref ? `${repoHref}#readme` : '';
      return (
        <section class="variant-panel" data-variant-type={type}>
          <header class="hero-card">
            <div class="hero-top">
              <div class="identity">
                <div class="eyebrow-row">
                  <span class={`kind ${type}`}>{String(type).toUpperCase()}</span>
                  <span class="registry">Registry v{item.version}</span>
                  {legacy && <span>Catalog linked</span>}
                  {verified && <span class="verified">✓ Verified</span>}
                </div>
                <h1>{name}</h1>
                {repoHref ? <a class="repo-link" href={repoHref} target="_blank" rel="noreferrer">{item.source?.repo} ↗</a> : <span class="repo-link">{item.id}</span>}
              </div>
              <div class="hero-actions">
                <a class="primary" href={deepLink}>Open in DSH</a>
                <a class="secondary" href="#install">Install guide</a>
              </div>
            </div>
            <p class="description">{description}</p>
            <div class="stat-grid">
              <span><b>{stars > 0 ? `★ ${fmtK(stars)}` : '—'}</b><i>stars</i></span>
              <span><b>v{item.version}</b><i>install version</i></span>
              <span><b>{legacy?.language || '—'}</b><i>language</i></span>
              <span><b>{dependencies.length}</b><i>dependencies</i></span>
              <span><b>{checks.filter((check) => check.ok).length}/{checks.length}</b><i>evidence</i></span>
            </div>
          </header>

          <nav class="section-nav" aria-label="package detail sections">
            <a href="#overview">Overview</a>
            <a href="#install">Install</a>
            <a href="#usage">Activate & use</a>
            <a href="#versions">Versions</a>
            <a href="#security">Security</a>
            <a href="#metadata">Metadata</a>
          </nav>

          <div class="detail-grid">
            <main class="main-col">
              <section id="overview" class="panel">
                <div class="section-title"><span>01</span><div><h2>Overview</h2><p>Registry 运行时身份与原始 dsh-plugin 展示信息归一到同一页面，安装前即可看清来源与能力。</p></div></div>
                <div class="overview-grid">
                  <div><small>Identity</small><strong>{type}:{item.id}</strong></div>
                  <div><small>Repository</small><strong>{item.source?.repo || '—'}</strong></div>
                  <div><small>Catalog</small><strong>{legacy ? 'Linked' : 'Registry only'}</strong></div>
                  <div><small>Release channel</small><strong>{item.channel || item.release_channel || 'stable'}</strong></div>
                </div>
                {capabilities.length > 0 && <div class="chips">{capabilities.slice(0, 16).map((capability: string) => <span>{capability}</span>)}</div>}
              </section>

              <section id="install" class="panel install-panel">
                <div class="section-title"><span>02</span><div><h2>Install</h2><p>支持 Deep Link 与精确 CLI 两种入口；网页只发起本地安装，不在远端替你修改 Runtime。</p></div></div>
                <div class="command-row"><code>{installCommand}</code><button class="copy-install" data-command={installCommand}>Copy CLI</button></div>
                <div class="install-actions">
                  <a class="primary" href={deepLink}>Open in DSH</a>
                  {repoHref && <a class="secondary" href={repoHref} target="_blank" rel="noreferrer">Review source ↗</a>}
                  {readmeHref && <a class="secondary" href={readmeHref} target="_blank" rel="noreferrer">README ↗</a>}
                </div>
                <div class="install-steps">
                  <div><b>1</b><strong>确认来源</strong><span>优先核对 Registry version、固定 commit、publisher 与权限声明。</span></div>
                  <div><b>2</b><strong>执行安装</strong><span>Open in DSH 或复制当前页面生成的精确版本命令。</span></div>
                  <div><b>3</b><strong>等待校验</strong><span>Runtime Installer 下载、校验并写入本地 Runtime Registry。</span></div>
                  <div><b>4</b><strong>手动激活</strong><span>安装成功不会自动重启；仅在 restart-required 时手动重启 DSH。</span></div>
                </div>
                <div class="install-note">Startup Loader 会在启动时再次按 Registry 固定版本与 commit 校验，避免安装展示信息与本地运行版本断链。</div>
              </section>

              <section id="usage" class="panel">
                <div class="section-title"><span>03</span><div><h2>Activate & use</h2><p>把安装后的使用入口、兼容性和项目文档放到详情页，而不是只留下一个 Install 按钮。</p></div></div>
                <div class="usage-grid">
                  <div><small>Activation</small><strong>Manual restart only when required</strong><p>默认不自动重启客户端；宿主提示 restart-required 时再手动重启。</p></div>
                  <div><small>Compatibility</small><strong>{(compatibility.os || ['any']).join(', ')} · {(compatibility.arch || ['any']).join(', ')}</strong><p>Runtime: {compatibility.runtime || compatibility.dsh_runtime || 'unspecified'}。</p></div>
                  <div><small>Package source</small><strong>{item.source?.repo || 'Registry entry'}</strong><p>{item.source?.commit ? `Pinned commit ${String(item.source.commit).slice(0, 12)}` : 'No immutable commit declared'}。</p></div>
                  <div><small>Documentation</small><strong>{readmeHref ? 'Project README available' : 'Repository documentation'}</strong><p>{readmeHref ? <a href={readmeHref} target="_blank" rel="noreferrer">查看配置、用法与项目截图 ↗</a> : '请在发布者文档中确认配置与使用方式。'}</p></div>
                </div>
              </section>

              <section id="versions" class="panel">
                <div class="section-title"><span>04</span><div><h2>Versions</h2><p>同一 type 只展示最新版本，历史版本单独列出，避免详情 panel 重复错乱。</p></div></div>
                <div class="version-table">
                  <div><span>Current</span><strong>v{item.version}</strong><em>Registry install authority</em></div>
                  <div><span>Available</span><strong>{(item._versions || [item.version]).map((version: string) => `v${version}`).join(' · ')}</strong><em>{(item._versions || []).length || 1} version(s)</em></div>
                  <div><span>Catalog version</span><strong>{legacy?.version || legacy?.plugin_version || legacy?.latest_version || 'Discovery only'}</strong><em>不会覆盖 Registry 安装版本</em></div>
                </div>
              </section>

              <section id="security" class="panel">
                <div class="section-title"><span>05</span><div><h2>Security & permissions</h2><p>权限与供应链证据分开呈现，不把“已声明”误写成“已验证”。</p></div></div>
                <div class="security-grid">
                  <div><h3>Permissions</h3>{permissions.length ? <ul>{permissions.map((permission: string) => <li class={highRisk.includes(permission) ? 'risk' : ''}>{permission}{highRisk.includes(permission) ? ' · confirm' : ''}</li>)}</ul> : <p>未声明高风险权限。</p>}</div>
                  <div><h3>Evidence</h3><ul class="checks">{checks.map((check) => <li class={check.ok ? 'ok' : 'missing'}>{check.ok ? '✓' : '○'} {check.label}</li>)}</ul></div>
                </div>
              </section>
            </main>

            <aside class="side-col">
              <section id="metadata" class="panel sticky-panel">
                <h2>Package metadata</h2>
                <dl>
                  <dt>Type</dt><dd>{String(type).toUpperCase()}</dd>
                  <dt>Registry</dt><dd>v{item.version}</dd>
                  <dt>Commit</dt><dd><code>{item.source?.commit ? String(item.source.commit).slice(0, 12) : '—'}</code></dd>
                  <dt>Manifest</dt><dd>{item.metadata?.manifest_file || 'legacy registry entry'}</dd>
                  <dt>Language</dt><dd>{legacy?.language || '—'}</dd>
                  <dt>License</dt><dd>{item.security?.license || legacy?.license || '—'}</dd>
                  <dt>OS</dt><dd>{(compatibility.os || ['any']).join(', ')}</dd>
                  <dt>Arch</dt><dd>{(compatibility.arch || ['any']).join(', ')}</dd>
                  <dt>Runtime</dt><dd>{compatibility.runtime || compatibility.dsh_runtime || 'unspecified'}</dd>
                  <dt>Publisher</dt><dd>{publisherHref ? <a href={publisherHref}>{publisherName} {publisherVerified(item) ? '✓' : ''}</a> : 'not declared'}</dd>
                </dl>
                <div class="side-links">
                  {readmeHref && <a href={readmeHref} target="_blank" rel="noreferrer">README / Usage ↗</a>}
                  {repoHref && <a href={repoHref} target="_blank" rel="noreferrer">GitHub repository ↗</a>}
                </div>
              </section>
            </aside>
          </div>
        </section>
      );
    })}
  </article>

  <script>
    const panels = [...document.querySelectorAll<HTMLElement>('[data-variant-type]')];
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-type-tab]')];
    const requested = new URLSearchParams(window.location.search).get('type');
    const available = panels.map((panel) => panel.dataset.variantType).filter(Boolean);
    const active = requested && available.includes(requested) ? requested : available[0];
    for (const panel of panels) panel.hidden = panel.dataset.variantType !== active;
    for (const tab of tabs) tab.classList.toggle('active', tab.dataset.typeTab === active);
    for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-install')) {
      button.addEventListener('click', async () => {
        const command = button.dataset.command || '';
        try { await navigator.clipboard.writeText(command); }
        catch { window.prompt('复制安装命令', command); }
        const old = button.textContent;
        button.textContent = 'Copied ✓';
        setTimeout(() => { button.textContent = old; }, 1200);
      });
    }
  </script>
</Layout>

<style>
  .detail-shell{max-width:1400px;margin:0 auto}.back{display:inline-block;margin:5px 0 16px;color:var(--muted);font-size:13.5px;font-weight:650}.variant-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.variant-tabs a{border:1px solid var(--border);border-radius:999px;background:var(--card);color:var(--muted);padding:7px 12px;font-size:12.5px;font-weight:750}.variant-tabs a.active{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 45%,var(--border));background:var(--accent-soft)}.variant-panel[hidden]{display:none}
  .hero-card,.panel{border:1px solid var(--border);background:var(--card);border-radius:20px;box-shadow:var(--shadow-sm)}.hero-card{padding:32px;position:relative;overflow:hidden}.hero-card::before{content:'';position:absolute;inset:0 0 auto;height:4px;background:var(--grad-accent)}.hero-top{display:flex;align-items:flex-start;gap:22px}.identity{min-width:0}.eyebrow-row{display:flex;gap:7px;flex-wrap:wrap}.eyebrow-row span{border-radius:999px;padding:4px 9px;background:var(--bg-soft);color:var(--muted);font-size:11.5px;font-weight:750}.eyebrow-row .registry{color:var(--accent);background:var(--accent-soft)}.eyebrow-row .verified{color:var(--green);background:color-mix(in srgb,var(--green) 12%,transparent)}.kind.mcp{color:#7c3aed}.kind.skill{color:#0891b2}.kind.agent{color:#db2777}.hero-card h1{margin:9px 0 3px;font-size:clamp(34px,4.2vw,50px);line-height:1.06;letter-spacing:-.04em;overflow-wrap:anywhere}.repo-link{color:var(--muted);font:13px ui-monospace,SFMono-Regular,Menlo,monospace}.hero-actions{margin-left:auto;display:flex;gap:9px;flex-wrap:wrap}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--border);border-radius:11px;padding:10px 15px;font:750 13.5px/1.3 inherit;text-decoration:none;min-height:40px}.primary{background:var(--accent);border-color:var(--accent);color:#fff}.secondary{background:var(--card);color:var(--fg)}.primary:hover,.secondary:hover{text-decoration:none;transform:translateY(-1px)}.description{color:var(--muted);font-size:16px;line-height:1.7;max-width:1040px;margin:23px 0}.stat-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.stat-grid span{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:13px;background:var(--bg-soft);padding:11px 13px;min-width:0}.stat-grid b{font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.stat-grid i{font-style:normal;color:var(--muted);font-size:10.5px;text-transform:uppercase;letter-spacing:.055em}
  .section-nav{display:flex;gap:22px;overflow:auto;border-bottom:1px solid var(--border);margin:20px 0;padding:0 5px 12px}.section-nav a{color:var(--muted);font-size:13.5px;font-weight:750;white-space:nowrap}.section-nav a:hover{color:var(--fg);text-decoration:none}.detail-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(320px,.78fr);gap:20px;align-items:start}.main-col{display:grid;gap:20px;min-width:0}.side-col{min-width:0}.panel{padding:27px;min-width:0;scroll-margin-top:96px}.section-title{display:flex;gap:13px;align-items:flex-start;margin-bottom:19px}.section-title>span{color:var(--accent);font-size:11.5px;font-weight:850;margin-top:3px}.section-title h2{margin:-2px 0 3px;font-size:20px}.section-title p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.55}.overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.overview-grid div{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:12px;background:var(--bg-soft);padding:13px}.overview-grid small{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.overview-grid strong{font-size:14px;margin-top:3px;overflow-wrap:anywhere}.chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}.chips span{border-radius:999px;background:var(--bg-soft);color:var(--muted);padding:4px 9px;font-size:12px}.command-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px}.command-row code{overflow:auto;white-space:nowrap;border:1px solid var(--border);border-radius:11px;background:var(--bg-soft);padding:13px;font-size:13px}.command-row button{border:0;border-radius:10px;background:var(--accent);color:#fff;padding:0 15px;font-size:12.5px;font-weight:750;cursor:pointer}.install-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.install-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:15px}.install-steps>div{display:flex;flex-direction:column;gap:4px;border:1px solid var(--border);border-radius:12px;background:var(--bg-soft);padding:12px}.install-steps b{color:var(--accent);font-size:11px}.install-steps strong{font-size:13px}.install-steps span{color:var(--muted);font-size:12px;line-height:1.5}.install-note{margin-top:12px;color:var(--muted);font-size:12.5px;line-height:1.55}.usage-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.usage-grid>div{border:1px solid var(--border);border-radius:12px;background:var(--bg-soft);padding:14px}.usage-grid small{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.usage-grid strong{display:block;margin-top:3px;font-size:14px;overflow-wrap:anywhere}.usage-grid p{color:var(--muted);font-size:12.5px;line-height:1.55;margin:7px 0 0}.version-table{display:grid;gap:1px;overflow:hidden;border:1px solid var(--border);border-radius:12px;background:var(--border)}.version-table>div{display:grid;grid-template-columns:150px minmax(0,1fr) minmax(180px,.8fr);gap:12px;background:var(--card);padding:12px 14px;align-items:center}.version-table span,.version-table em{color:var(--muted);font-size:12px;font-style:normal}.version-table strong{font-size:13.5px;overflow-wrap:anywhere}.security-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.security-grid h3{margin:0 0 9px;font-size:14px}.security-grid p,.security-grid li{color:var(--muted);font-size:12.5px;line-height:1.55}.risk{color:var(--amber)!important;font-weight:750}.checks{list-style:none;padding:0}.checks .ok{color:var(--green)}.checks .missing{color:var(--muted)}.sticky-panel{position:sticky;top:92px}.sticky-panel h2{margin-top:0;font-size:18px}dl{display:grid;grid-template-columns:96px minmax(0,1fr);gap:10px;margin:0}dt{color:var(--muted);font-size:12px}dd{margin:0;font-size:12.8px;overflow-wrap:anywhere}.side-links{display:grid;gap:8px;margin-top:18px;border-top:1px solid var(--border);padding-top:14px}.side-links a{font-size:12.5px;font-weight:700}
  @media(max-width:1100px){.detail-grid{grid-template-columns:minmax(0,1fr) 300px}.install-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:820px){.hero-top{flex-direction:column}.hero-actions{margin-left:0}.stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-grid{grid-template-columns:1fr}.sticky-panel{position:static}.overview-grid,.security-grid,.usage-grid{grid-template-columns:1fr}.version-table>div{grid-template-columns:1fr;gap:3px}.install-steps{grid-template-columns:1fr}}
  @media(max-width:520px){.hero-card,.panel{padding:20px}.hero-card h1{font-size:32px}.stat-grid{grid-template-columns:1fr 1fr}.command-row{grid-template-columns:1fr}.command-row button{min-height:40px}}
</style>
