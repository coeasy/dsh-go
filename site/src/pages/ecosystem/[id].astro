---
import Layout from '../../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u } from '../../lib/urls';
import { fmtK } from '../../lib/format';
import { DETAIL_THRESHOLD } from '../../lib/threshold';
import { ecosystemType, normalizeRepo } from '../../lib/marketplace';

export async function getStaticPaths() {
  let entries: any[] = [];
  let catalogPlugins: any[] = [];
  try { entries = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf8')).plugins || []; } catch { /* no registry */ }
  try { catalogPlugins = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf8')).plugins || []; } catch { /* optional enrichment */ }

  const catalogByRepo = new Map<string, any>();
  for (const plugin of catalogPlugins) {
    const repo = normalizeRepo(plugin.full_name || plugin.repo_url);
    if (repo) catalogByRepo.set(repo, plugin);
  }

  const groups = new Map<string, any[]>();
  for (const entry of entries) {
    const group = groups.get(String(entry.id)) || [];
    group.push(entry);
    groups.set(String(entry.id), group);
  }

  const paths: any[] = [];
  for (const [id, allEntries] of groups.entries()) {
    const byType = new Map<string, any[]>();
    for (const entry of allEntries) {
      const type = ecosystemType(entry);
      const group = byType.get(type) || [];
      group.push(entry);
      byType.set(type, group);
    }
    const variants = [...byType.entries()].map(([type, typeEntries]) => {
      const sorted = [...typeEntries].sort((left, right) => String(right.version || '').localeCompare(String(left.version || ''), undefined, { numeric: true }));
      const current = sorted[0];
      const repo = normalizeRepo(current.source?.repo);
      const legacy = repo ? catalogByRepo.get(repo) || null : null;
      return {
        ...current,
        _type: type,
        _versions: sorted.map((entry) => String(entry.version || '')).filter(Boolean),
        _catalog: legacy,
        _stars: Number(legacy?.stars ?? current.metadata?.stars ?? 0),
      };
    }).filter((variant) => variant._stars >= DETAIL_THRESHOLD);
    if (variants.length) paths.push({ params: { id }, props: { variants } });
  }
  return paths;
}

const { variants } = Astro.props as { variants: any[] };
const packageId = variants[0]?.id || 'unknown';
function publisherVerified(item: any) {
  const owner = item.source?.repo?.split('/')[0]?.toLowerCase();
  return item.publisher?.provider === 'github' && item.publisher?.id && owner === String(item.publisher.id).toLowerCase();
}
function evidence(item: any) {
  return [
    ['Immutable commit', /^[a-f0-9]{40}$/i.test(item.source?.commit || '')],
    ['Registry verified', item.metadata?.verified === true],
    ['Publisher owner match', Boolean(publisherVerified(item))],
    ['Provenance', Boolean(item.security?.provenance)],
    ['Signature', Boolean(item.security?.signature)],
    ['SBOM', Boolean(item.security?.sbom)],
    ['License', Boolean(item.security?.license)],
  ] as const;
}
---

<Layout title={`${packageId} · DSH Marketplace`} description={`DSH ecosystem package ${packageId}`}>
  <article class="detail-shell compact-detail">
    <a class="back" href={u('/')} data-detail-i18n="back">← Marketplace</a>

    {variants.length > 1 && <nav class="variant-tabs" aria-label="ecosystem package types">{variants.map((item: any) => <a href={`?type=${item._type}`} data-type-tab={item._type}>{String(item._type).toUpperCase()}</a>)}</nav>}

    {variants.map((item: any) => {
      const type = item._type || ecosystemType(item);
      const legacy = item._catalog;
      const name = item.metadata?.name || legacy?.name || item.id;
      const description = item.metadata?.description || legacy?.description || '';
      const stars = Number(item._stars || 0);
      const verified = item.metadata?.verified === true || legacy?.verified === true;
      const permissions = Array.isArray(item.permissions) ? item.permissions : [];
      const dependencies = Array.isArray(item.dependencies) ? item.dependencies : [];
      const capabilities = Array.isArray(item.capabilities) ? item.capabilities : [];
      const checks = evidence(item);
      const installCommand = `dsh ${type} install ${item.id}@${item.version}`;
      const deepLink = `dsh://install?id=${encodeURIComponent(item.id)}&version=${encodeURIComponent(String(item.version))}&type=${encodeURIComponent(type)}`;
      const repoHref = item.source?.repo ? `https://github.com/${item.source.repo}` : '';
      return (
        <section class="variant-panel" data-variant-type={type}>
          <header class="hero-card">
            <div class="hero-top">
              <div class="identity">
                <div class="eyebrow-row"><span class={`kind ${type}`}>{String(type).toUpperCase()}</span><span class="registry">Registry v{item.version}</span>{verified && <span class="verified">✓ Verified</span>}</div>
                <h1>{name}</h1>
                {repoHref ? <a class="repo-link" href={repoHref} target="_blank" rel="noreferrer">{item.source.repo} ↗</a> : <span class="repo-link">{item.id}</span>}
              </div>
              <div class="hero-actions"><a class="primary" href={deepLink} data-detail-i18n="open">Open in DSH</a><button class="secondary copy-install" type="button" data-command={installCommand} data-detail-i18n="copy">Copy CLI</button></div>
            </div>
            <p class="description">{description}</p>
            <div class="stat-grid"><span><b>★ {fmtK(stars)}</b><i>stars</i></span><span><b>v{item.version}</b><i data-detail-i18n="version">install version</i></span><span><b>{legacy?.language || '—'}</b><i data-detail-i18n="language">language</i></span><span><b>{dependencies.length}</b><i data-detail-i18n="dependencies">dependencies</i></span><span><b>{checks.filter(([, ok]) => ok).length}/{checks.length}</b><i data-detail-i18n="evidence">evidence</i></span></div>
          </header>

          <div class="detail-grid">
            <main class="main-col">
              <section class="panel"><h2 data-detail-i18n="overview">Overview</h2><p data-detail-i18n="overviewText">Registry identity, source, capabilities and install authority are kept together on this page.</p><div class="facts"><div><small data-detail-i18n="type">Type</small><strong>{type.toUpperCase()}</strong></div><div><small data-detail-i18n="publisher">Publisher</small><strong>{item.publisher?.id || item.source?.repo?.split('/')[0] || '—'}</strong></div><div><small data-detail-i18n="commit">Commit</small><strong><code>{item.source?.commit ? String(item.source.commit).slice(0, 12) : '—'}</code></strong></div><div><small data-detail-i18n="stars">Stars</small><strong>{stars.toLocaleString()}</strong></div></div>{capabilities.length > 0 && <div class="chips">{capabilities.slice(0, 18).map((cap: string) => <span>{cap}</span>)}</div>}</section>

              <section class="panel install-panel"><h2 data-detail-i18n="install">Install</h2><p data-detail-i18n="installText">Installation is executed locally. Registry version and immutable source remain authoritative.</p><div class="command-row"><code>{installCommand}</code><button type="button" class="copy-install" data-command={installCommand} data-detail-i18n="copy">Copy CLI</button></div><div class="install-actions"><a class="primary" href={deepLink} data-detail-i18n="open">Open in DSH</a>{repoHref && <a class="secondary" href={repoHref} target="_blank" rel="noreferrer">GitHub ↗</a>}</div></section>

              <section class="panel"><h2 data-detail-i18n="security">Trust & security</h2><p data-detail-i18n="securityText">Popularity does not grant trust. Review publisher ownership, immutable source and supply-chain evidence before installation.</p><div class="evidence-grid">{checks.map(([label, ok]) => <div><span class={ok ? 'ok' : 'miss'}>{ok ? '✓' : '–'}</span><strong>{label}</strong></div>)}</div></section>
            </main>
            <aside class="side-col"><section class="panel sticky-panel"><h2 data-detail-i18n="metadata">Package metadata</h2><dl><dt data-detail-i18n="id">Package ID</dt><dd>{item.id}</dd><dt data-detail-i18n="type">Type</dt><dd>{type}</dd><dt data-detail-i18n="version">Version</dt><dd>{item.version}</dd><dt data-detail-i18n="permissions">Permissions</dt><dd>{permissions.length}</dd><dt data-detail-i18n="dependencies">Dependencies</dt><dd>{dependencies.length}</dd><dt data-detail-i18n="detailPolicy">Detail policy</dt><dd>≥ {DETAIL_THRESHOLD} stars</dd></dl></section></aside>
          </div>
        </section>
      );
    })}
  </article>

  <script>
    const dictionaries: Record<string, Record<string,string>> = {
      en:{back:'← Marketplace',open:'Open in DSH',copy:'Copy CLI',copied:'Copied',version:'install version',language:'language',dependencies:'dependencies',evidence:'evidence',overview:'Overview',overviewText:'Registry identity, source, capabilities and install authority are kept together on this page.',type:'Type',publisher:'Publisher',commit:'Commit',stars:'Stars',install:'Install',installText:'Installation is executed locally. Registry version and immutable source remain authoritative.',security:'Trust & security',securityText:'Popularity does not grant trust. Review publisher ownership, immutable source and supply-chain evidence before installation.',metadata:'Package metadata',id:'Package ID',permissions:'Permissions',detailPolicy:'Detail policy'},
      'zh-CN':{back:'← 返回市场',open:'用 DSH 打开',copy:'复制 CLI',copied:'已复制',version:'安装版本',language:'语言',dependencies:'依赖',evidence:'证据',overview:'概览',overviewText:'在同一页面对齐 Registry 身份、来源、能力和安装权威信息。',type:'类型',publisher:'发布者',commit:'提交',stars:'Stars',install:'安装',installText:'安装始终在本地执行，Registry 版本和不可变来源为权威依据。',security:'信任与安全',securityText:'热度不等于可信。安装前应检查发布者所有权、不可变来源和供应链证据。',metadata:'包元数据',id:'包 ID',permissions:'权限',detailPolicy:'详情页门槛'},
      ja:{back:'← マーケット',open:'DSH で開く',copy:'CLI をコピー',copied:'コピー済み',version:'インストール版',language:'言語',dependencies:'依存関係',evidence:'証拠',overview:'概要',overviewText:'Registry の識別子、ソース、能力、インストール権威を同じページで確認できます。',type:'種別',publisher:'公開者',commit:'コミット',stars:'Stars',install:'インストール',installText:'インストールはローカルで実行され、Registry のバージョンと不変ソースが正本です。',security:'信頼とセキュリティ',securityText:'人気は信頼を保証しません。公開者所有権、不変ソース、サプライチェーン証拠を確認してください。',metadata:'パッケージ情報',id:'パッケージ ID',permissions:'権限',detailPolicy:'詳細ページ基準'},
      ko:{back:'← 마켓플레이스',open:'DSH로 열기',copy:'CLI 복사',copied:'복사됨',version:'설치 버전',language:'언어',dependencies:'의존성',evidence:'증거',overview:'개요',overviewText:'Registry ID, 소스, 기능, 설치 기준을 한 페이지에서 확인합니다.',type:'유형',publisher:'게시자',commit:'커밋',stars:'Stars',install:'설치',installText:'설치는 로컬에서 실행되며 Registry 버전과 불변 소스가 기준입니다.',security:'신뢰 및 보안',securityText:'인기도는 신뢰를 보장하지 않습니다. 게시자 소유권, 불변 소스, 공급망 증거를 확인하세요.',metadata:'패키지 메타데이터',id:'패키지 ID',permissions:'권한',detailPolicy:'상세 페이지 기준'},
      es:{back:'← Marketplace',open:'Abrir con DSH',copy:'Copiar CLI',copied:'Copiado',version:'versión de instalación',language:'idioma',dependencies:'dependencias',evidence:'evidencias',overview:'Resumen',overviewText:'La identidad del Registry, el origen, las capacidades y la autoridad de instalación se muestran juntos.',type:'Tipo',publisher:'Publicador',commit:'Commit',stars:'Stars',install:'Instalar',installText:'La instalación se ejecuta localmente; la versión del Registry y el origen inmutable son la autoridad.',security:'Confianza y seguridad',securityText:'La popularidad no implica confianza. Revisa la propiedad del publicador, el origen inmutable y las evidencias de la cadena de suministro.',metadata:'Metadatos del paquete',id:'ID del paquete',permissions:'Permisos',detailPolicy:'Umbral de detalle'},
    };
    function applyDetailLocale(){ const lang=document.documentElement.lang||'en'; const dict=dictionaries[lang]||dictionaries.en; document.querySelectorAll<HTMLElement>('[data-detail-i18n]').forEach((node)=>{ const key=node.dataset.detailI18n||''; if(dict[key])node.textContent=dict[key]; }); }
    applyDetailLocale();
    new MutationObserver(applyDetailLocale).observe(document.documentElement,{attributes:true,attributeFilter:['lang']});
    document.addEventListener('click',async(event)=>{ const target=event.target; if(!(target instanceof Element))return; const button=target.closest<HTMLButtonElement>('.copy-install[data-command]'); if(!button)return; const command=button.dataset.command||''; try{await navigator.clipboard.writeText(command);}catch{window.prompt(command,command);} const lang=document.documentElement.lang||'en'; const dict=dictionaries[lang]||dictionaries.en; button.textContent=dict.copied||'Copied'; setTimeout(()=>{button.textContent=dict.copy||'Copy CLI';},1200); });
    const requested=new URLSearchParams(location.search).get('type'); const panels=[...document.querySelectorAll<HTMLElement>('[data-variant-type]')]; const tabs=[...document.querySelectorAll<HTMLAnchorElement>('[data-type-tab]')]; if(requested&&panels.some((panel)=>panel.dataset.variantType===requested)){panels.forEach((panel)=>panel.hidden=panel.dataset.variantType!==requested);tabs.forEach((tab)=>tab.classList.toggle('active',tab.dataset.typeTab===requested));}else if(panels.length>1){panels.forEach((panel,index)=>panel.hidden=index>0);tabs[0]?.classList.add('active');}
  </script>
</Layout>

<style>
  .compact-detail{max-width:1260px;margin:0 auto;padding:26px 0 70px}.back{display:inline-block;margin-bottom:14px;color:var(--muted);font-size:13px;font-weight:700}.variant-tabs{display:flex;gap:8px;margin-bottom:12px}.variant-tabs a{padding:6px 11px;border:1px solid var(--border);border-radius:999px;text-decoration:none}.variant-tabs a.active{color:var(--accent);border-color:var(--accent);background:var(--accent-soft)}.variant-panel[hidden]{display:none}.hero-card,.panel{border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--shadow-sm)}.hero-card{padding:25px;margin-bottom:16px}.hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.eyebrow-row{display:flex;gap:7px;flex-wrap:wrap}.eyebrow-row span{font-size:11px;padding:4px 8px;border-radius:999px;background:var(--bg-soft)}.kind{color:#fff;background:var(--accent)!important;font-weight:850}.verified{color:var(--green)}h1{margin:10px 0 4px;font-size:clamp(32px,4vw,48px);letter-spacing:-.04em}.repo-link{color:var(--muted);font-size:13px}.hero-actions,.install-actions{display:flex;gap:8px;flex-wrap:wrap}.primary,.secondary,.copy-install{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:8px 13px;border:1px solid var(--border);border-radius:10px;font:750 13px/1.2 inherit;text-decoration:none;cursor:pointer}.primary{color:#fff;background:var(--accent);border-color:var(--accent)}.secondary,.copy-install{color:var(--fg);background:var(--card)}.description{color:var(--muted);font-size:15px;line-height:1.65}.stat-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:18px}.stat-grid span{padding:10px;border:1px solid var(--border);border-radius:11px;background:var(--bg-soft)}.stat-grid b,.stat-grid i{display:block}.stat-grid i{margin-top:2px;color:var(--muted);font-size:10px;font-style:normal}.detail-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px}.main-col{display:grid;gap:16px}.panel{padding:20px}.panel h2{margin:0 0 6px;font-size:20px}.panel>p{margin:0 0 14px;color:var(--muted);font-size:13.5px;line-height:1.6}.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.facts>div{padding:11px;border:1px solid var(--border);border-radius:10px;background:var(--bg-soft);min-width:0}.facts small,.facts strong{display:block}.facts small{color:var(--muted);font-size:10px}.facts strong{margin-top:3px;font-size:13px;overflow-wrap:anywhere}.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.chips span{padding:4px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-size:11px}.command-row{display:flex;gap:8px;align-items:stretch;margin:12px 0}.command-row code{flex:1;min-width:0;padding:11px;border-radius:10px;background:#0f172a;color:#e2e8f0;overflow:auto}.evidence-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.evidence-grid>div{display:flex;align-items:center;gap:8px;padding:9px;border:1px solid var(--border);border-radius:9px}.evidence-grid span{display:inline-flex;width:22px;height:22px;align-items:center;justify-content:center;border-radius:50%;background:var(--bg-soft)}.evidence-grid .ok{color:var(--green)}.evidence-grid .miss{color:var(--muted)}.evidence-grid strong{font-size:12px}.sticky-panel{position:sticky;top:84px}.sticky-panel dl{display:grid;grid-template-columns:110px minmax(0,1fr);gap:9px 10px;margin:14px 0 0}.sticky-panel dt{color:var(--muted);font-size:11px}.sticky-panel dd{margin:0;font-size:12px;overflow-wrap:anywhere}@media(max-width:850px){.detail-grid{grid-template-columns:1fr}.sticky-panel{position:static}.stat-grid,.facts{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.hero-top{flex-direction:column}.stat-grid,.facts,.evidence-grid{grid-template-columns:1fr}.command-row{flex-direction:column}}
</style>
