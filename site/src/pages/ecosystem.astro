---
import Layout from '../layouts/Layout.astro';
import PluginCard from '../components/PluginCard.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u, apiUrl } from '../lib/urls';
import {
  POPULAR_STARS_MAX,
  POPULAR_STARS_MIN,
  alignRegistryItem,
  buildLegacyRepoIndex,
  compareMarketplacePopularity,
  isDefaultPopularStars,
} from '../lib/marketplace';

let registry: any = { plugins: [] };
let legacyCatalog: any = { plugins: [] };
try {
  registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf8'));
} catch {
  registry = { plugins: [] };
}
try {
  legacyCatalog = JSON.parse(readFileSync(resolve('..', 'catalog', 'plugins.json'), 'utf8'));
} catch {
  legacyCatalog = { plugins: [] };
}

const legacyIndex = buildLegacyRepoIndex(legacyCatalog.plugins || []);
const items = (registry.plugins || [])
  .map((item: any) => alignRegistryItem(item, legacyIndex))
  .sort(compareMarketplacePopularity);
const popularItems = items.filter((item: any) => isDefaultPopularStars(item.stars));
const counts = Object.fromEntries(['plugin', 'mcp', 'skill', 'agent'].map((type) => [type, items.filter((item: any) => item.type === type).length]));
const popularCounts = Object.fromEntries(['plugin', 'mcp', 'skill', 'agent'].map((type) => [type, popularItems.filter((item: any) => item.type === type).length]));
const updatedAt = registry.generated?.at ? new Date(registry.generated.at).toISOString().slice(0, 10) : '—';
---

<Layout title="DSH Go · Ecosystem Marketplace" description="与 dsh-plugin 目录统一视觉与身份语义的 Registry V3 生态市场">
  <section class="hero">
    <span class="eyebrow">DSH 0.1.0 · Registry V3 · Catalog aligned</span>
    <h1 class="grad-text">DSH Ecosystem</h1>
    <p>Plugin、MCP、Skill、Agent 使用同一套仓库身份、Star、版本和卡片视觉。默认优先展示 {POPULAR_STARS_MIN}–{POPULAR_STARS_MAX} Star 的热门 GitHub 仓库。</p>
    <div class="metrics">
      <span><b>{popularItems.length}</b><i>默认热门</i></span>
      <span><b>{items.length}</b><i>全部生态</i></span>
      <span><b>{popularCounts.plugin}</b><i>热门 Plugin</i></span>
      <span><b>{popularCounts.mcp}</b><i>热门 MCP</i></span>
      <span><b>{popularCounts.skill}</b><i>热门 Skill</i></span>
      <span><b>{popularCounts.agent}</b><i>热门 Agent</i></span>
      <span><b>{updatedAt}</b><i>Registry 更新</i></span>
    </div>
  </section>

  <section class="notice">
    <div><b>版本对齐：</b>展示版本以 Registry V3 为准，当前默认版本为 <code>0.1.0</code>；名称、Star、语言、描述优先与原 dsh-plugin catalog 对齐。</div>
    <div><b>安装闭环：</b>网页只生成本地 DSH 安装命令；安装后不会自动重启，需手动重启后激活。</div>
  </section>

  <section class="filters" aria-label="ecosystem filters">
    <input id="eco-search" type="search" placeholder="搜索名称、仓库、type:id、capability…" autocomplete="off" />
    <div class="scope-filters" aria-label="recommendation scope">
      <button class="scope-filter active" type="button" data-scope="popular">热门 {POPULAR_STARS_MIN}–{POPULAR_STARS_MAX}★ <small>{popularItems.length}</small></button>
      <button class="scope-filter" type="button" data-scope="all">全部生态 <small>{items.length}</small></button>
    </div>
    <div class="type-filters">
      <button class="type-filter active" type="button" data-type-filter="all">All <small>{items.length}</small></button>
      <button class="type-filter" type="button" data-type-filter="plugin">Plugin <small>{counts.plugin}</small></button>
      <button class="type-filter" type="button" data-type-filter="mcp">MCP <small>{counts.mcp}</small></button>
      <button class="type-filter" type="button" data-type-filter="skill">Skill <small>{counts.skill}</small></button>
      <button class="type-filter" type="button" data-type-filter="agent">Agent <small>{counts.agent}</small></button>
      <label class="verified-only"><input id="eco-verified" type="checkbox" /> Verified only</label>
    </div>
  </section>

  <div class="result-line">
    <span id="eco-count">{popularItems.length} 个热门生态条目</span>
    <span class="result-links"><a href={u('/')}>dsh-plugin 首页</a><a href={u('/profiles')}>Profiles / Bundles</a><a href={apiUrl('/api/v1/search')}>Search API v1 ↗</a></span>
  </div>

  <section id="eco-grid" class="grid">
    {items.map((item: any) => {
      const detail = `${u(`/ecosystem/${encodeURIComponent(item.id)}`)}?type=${item.type}`;
      const legacy = item.legacy || {};
      return (
        <PluginCard
          slug={item.slug}
          name={item.name}
          description={item.description}
          stars={item.stars}
          category={item.category}
          verified={item.verified}
          trend={Number(legacy.trend_score || 0)}
          tags={item.topics}
          isNew={Boolean(legacy.first_seen && (Date.now() - new Date(legacy.first_seen).getTime()) < 7 * 864e5)}
          created={legacy.created_at}
          updated={item.updatedAt}
          full_name={item.repo}
          install_cmd={item.installCommand}
          language={item.language}
          href={detail}
          version={item.version}
          type={item.type}
          identity={item.key}
          capabilities={item.capabilities}
          variant="ecosystem"
        />
      );
    })}
  </section>
  <div id="eco-empty" class="empty" hidden>没有匹配的生态条目。</div>

  <script define:vars={{ minStars: POPULAR_STARS_MIN, maxStars: POPULAR_STARS_MAX }}>
    const searchNode = document.querySelector('#eco-search');
    const verifiedNode = document.querySelector('#eco-verified');
    const countNode = document.querySelector('#eco-count');
    const emptyNode = document.querySelector('#eco-empty');
    const cards = [...document.querySelectorAll('.ecosystem-card')];
    const typeFilters = [...document.querySelectorAll('[data-type-filter]')];
    const scopeFilters = [...document.querySelectorAll('[data-scope]')];
    let activeType = 'all';
    let activeScope = 'popular';

    function applyFilters() {
      const keyword = searchNode instanceof HTMLInputElement ? searchNode.value.trim().toLowerCase() : '';
      const verifiedOnly = verifiedNode instanceof HTMLInputElement && verifiedNode.checked;
      let visible = 0;
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const stars = Number(card.dataset.stars || 0);
        const popular = stars >= minStars && stars <= maxStars;
        const scopeMatch = activeScope === 'all' || popular;
        const typeMatch = activeType === 'all' || card.dataset.type === activeType;
        const searchText = `${card.dataset.identity || ''} ${card.dataset.name || ''} ${card.dataset.desc || ''} ${card.dataset.tags || ''}`.toLowerCase();
        const searchMatch = !keyword || searchText.includes(keyword);
        const verifiedMatch = !verifiedOnly || card.dataset.verified === 'true';
        const show = scopeMatch && typeMatch && searchMatch && verifiedMatch;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (countNode instanceof HTMLElement) countNode.textContent = `${visible} 个${activeScope === 'popular' ? '热门' : ''}生态条目`;
      if (emptyNode instanceof HTMLElement) emptyNode.hidden = visible !== 0;
    }

    if (searchNode instanceof HTMLInputElement) searchNode.addEventListener('input', applyFilters);
    if (verifiedNode instanceof HTMLInputElement) verifiedNode.addEventListener('change', applyFilters);
    for (const button of typeFilters) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.addEventListener('click', () => {
        activeType = button.dataset.typeFilter || 'all';
        for (const candidate of typeFilters) {
          if (candidate instanceof HTMLElement) candidate.classList.toggle('active', candidate === button);
        }
        applyFilters();
      });
    }
    for (const button of scopeFilters) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.addEventListener('click', () => {
        activeScope = button.dataset.scope || 'popular';
        for (const candidate of scopeFilters) {
          if (candidate instanceof HTMLElement) candidate.classList.toggle('active', candidate === button);
        }
        applyFilters();
      });
    }

    for (const button of document.querySelectorAll('.ecosystem-card [data-copy-cmd]')) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.addEventListener('click', async (event) => {
        event.preventDefault();
        event.stopPropagation();
        const command = button.dataset.copyCmd || '';
        try {
          await navigator.clipboard.writeText(command);
        } catch {
          window.prompt('复制本地安装命令', command);
        }
        const previous = button.innerHTML;
        button.innerHTML = '✓';
        window.setTimeout(() => { button.innerHTML = previous; }, 1400);
      });
    }

    applyFilters();
  </script>
</Layout>

<style>
  .hero { padding: 30px 0 22px; text-align: center; }
  .eyebrow { display: inline-block; color: var(--accent); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border)); border-radius: 999px; padding: 4px 12px; font-size: 12px; font-weight: 800; }
  .hero h1 { margin: 10px 0 6px; font-size: 36px; line-height: 1.15; }
  .hero p { max-width: 820px; margin: 0 auto; color: var(--muted); }
  .metrics { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }
  .metrics span { display: inline-flex; align-items: baseline; gap: 6px; padding: 6px 12px; border: 1px solid var(--border); background: var(--card); border-radius: 999px; box-shadow: var(--shadow-sm); }
  .metrics b { color: var(--accent); }
  .metrics i { color: var(--muted); font-size: 12px; font-style: normal; }
  .notice { display: grid; gap: 7px; border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border)); background: var(--accent-soft); border-radius: 14px; padding: 13px 16px; color: var(--muted); font-size: 13px; margin-bottom: 16px; }
  .notice b { color: var(--fg); }
  .notice code { color: var(--accent); font-weight: 700; }
  .filters { display: grid; gap: 10px; margin-bottom: 14px; }
  #eco-search { width: 100%; border: 1px solid var(--border); border-radius: 12px; background: var(--card); color: var(--fg); padding: 11px 14px; font: inherit; box-shadow: var(--shadow-sm); }
  .scope-filters, .type-filters { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; }
  .scope-filter, .type-filter { border: 1px solid var(--border); border-radius: 999px; background: var(--card); color: var(--muted); padding: 6px 11px; cursor: pointer; }
  .scope-filter small, .type-filter small { margin-left: 3px; color: inherit; }
  .scope-filter.active, .type-filter.active { background: var(--accent-soft); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); font-weight: 700; }
  .verified-only { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 13px; margin-left: auto; }
  .result-line { display: flex; justify-content: space-between; align-items: center; color: var(--muted); font-size: 13px; margin: 10px 0 12px; gap: 12px; }
  .result-links { display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-end; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 14px; }
  .empty { text-align: center; color: var(--muted); padding: 50px 0; }
  @media (max-width: 680px) {
    .hero h1 { font-size: 29px; }
    .verified-only { margin-left: 0; width: 100%; }
    .result-line { align-items: flex-start; flex-direction: column; }
    .result-links { justify-content: flex-start; }
  }
</style>
