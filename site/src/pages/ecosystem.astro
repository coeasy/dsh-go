---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { u, apiUrl } from '../lib/urls';

interface RegistryPlugin {
  id: string;
  type?: string;
  version: string;
  source?: { repo?: string; commit?: string };
  runtime?: { type?: string };
  capabilities?: string[];
  dependencies?: unknown[];
  metadata?: {
    name?: string;
    description?: string;
    verified?: boolean;
    stars?: number;
    rank?: number;
  };
}

interface RegistryData {
  registry_version?: number;
  schema_version?: string;
  generated?: { at?: string; count?: number };
  plugins?: RegistryPlugin[];
}

type EcosystemType = 'plugin' | 'mcp' | 'skill' | 'agent';

function itemType(plugin: RegistryPlugin): EcosystemType {
  if (plugin.type === 'mcp' || plugin.type === 'skill' || plugin.type === 'agent') return plugin.type;
  const runtime = plugin.runtime?.type;
  if (runtime === 'mcp' || runtime === 'skill' || runtime === 'agent') return runtime;
  const capabilities = plugin.capabilities ?? [];
  if (capabilities.includes('mcp')) return 'mcp';
  if (capabilities.includes('skill')) return 'skill';
  if (capabilities.includes('agent')) return 'agent';
  return 'plugin';
}

let registry: RegistryData = { plugins: [] };
try {
  registry = JSON.parse(readFileSync(resolve('..', 'catalog', 'registry-v3.json'), 'utf8')) as RegistryData;
} catch {
  registry = { plugins: [] };
}

const items = (registry.plugins ?? []).map((plugin) => {
  const type = itemType(plugin);
  const deepLink = new URL('dsh://install');
  deepLink.searchParams.set('id', plugin.id);
  deepLink.searchParams.set('version', plugin.version);
  deepLink.searchParams.set('type', type);
  const identityQuery = new URLSearchParams({ type }).toString();
  return {
    id: plugin.id,
    key: `${type}:${plugin.id}`,
    name: plugin.metadata?.name || plugin.id,
    description: plugin.metadata?.description || '',
    version: plugin.version,
    type,
    verified: plugin.metadata?.verified === true,
    stars: Number(plugin.metadata?.stars || 0),
    rank: Number(plugin.metadata?.rank || 0),
    repo: plugin.source?.repo || '',
    commit: plugin.source?.commit || '',
    capabilities: plugin.capabilities ?? [],
    dependencies: plugin.dependencies?.length ?? 0,
    install: `dsh ${type} install ${plugin.id}@${plugin.version}`,
    deepLink: deepLink.toString(),
    detail: `${u(`/ecosystem/${encodeURIComponent(plugin.id)}`)}?${identityQuery}`,
    api: `${apiUrl(`/api/v1/ecosystem/${encodeURIComponent(plugin.id)}`)}?${identityQuery}`,
  };
}).sort((left, right) => {
  const leftRank = left.rank || Number.MAX_SAFE_INTEGER;
  const rightRank = right.rank || Number.MAX_SAFE_INTEGER;
  return leftRank - rightRank || right.stars - left.stars || left.key.localeCompare(right.key);
});

const counts = Object.fromEntries(['plugin', 'mcp', 'skill', 'agent'].map((type) => [type, items.filter((item) => item.type === type).length]));
const updatedAt = registry.generated?.at ? new Date(registry.generated.at).toISOString().slice(0, 10) : '—';
---

<Layout title="DSH Go · Ecosystem Marketplace" description="Registry V3 驱动的 Plugin、MCP、Skill 与 Agent 统一生态市场">
  <section class="hero">
    <span class="eyebrow">DSH 0.1.0 · Registry V3 · API v1</span>
    <h1 class="grad-text">DSH Ecosystem</h1>
    <p>Plugin、MCP、Skill、Agent 统一发现与安装计划。网页只提供可信目录和本地命令，不会远程修改你的客户端。</p>
    <div class="metrics">
      <span><b>{items.length}</b><i>总条目</i></span>
      <span><b>{counts.plugin}</b><i>Plugin</i></span>
      <span><b>{counts.mcp}</b><i>MCP</i></span>
      <span><b>{counts.skill}</b><i>Skill</i></span>
      <span><b>{counts.agent}</b><i>Agent</i></span>
      <span><b>{updatedAt}</b><i>Registry 更新</i></span>
    </div>
  </section>

  <section class="notice">
    <b>安装闭环：</b>
    一键安装或复制命令 → 本地 DSH Runtime 预检权限/兼容性并安装 → 手动重启客户端 → Startup Loader 再校验并激活。
  </section>

  <section class="filters" aria-label="ecosystem filters">
    <input id="eco-search" type="search" placeholder="搜索名称、仓库、描述、type:id 或 capability…" autocomplete="off" />
    <div class="type-filters">
      <button class="type-filter active" type="button" data-type-filter="all">All <small>{items.length}</small></button>
      <button class="type-filter" type="button" data-type-filter="plugin">Plugin <small>{counts.plugin}</small></button>
      <button class="type-filter" type="button" data-type-filter="mcp">MCP <small>{counts.mcp}</small></button>
      <button class="type-filter" type="button" data-type-filter="skill">Skill <small>{counts.skill}</small></button>
      <button class="type-filter" type="button" data-type-filter="agent">Agent <small>{counts.agent}</small></button>
      <label class="verified-only"><input id="eco-verified" type="checkbox" /> Verified only</label>
    </div>
  </section>

  <div class="result-line"><span id="eco-count">{items.length} 个生态条目</span><span class="result-links"><a href={u('/profiles')}>Profiles / Bundles</a><a href={apiUrl('/api/v1/search')}>Search API v1 ↗</a></span></div>

  <section id="eco-grid" class="grid">
    {items.map((item) => (
      <article
        class="eco-card"
        data-type={item.type}
        data-verified={String(item.verified)}
        data-search={`${item.key} ${item.id} ${item.name} ${item.repo} ${item.description} ${item.capabilities.join(' ')}`.toLowerCase()}
      >
        <div class="card-head">
          <span class={`kind ${item.type}`}>{item.type.toUpperCase()}</span>
          {item.verified && <span class="verified">✓ Verified</span>}
        </div>
        <h2>{item.name}</h2>
        <p class="description">{item.description || '暂无描述'}</p>
        <div class="meta">
          <span>{item.key}</span>
          <span>v{item.version}</span>
          {item.stars > 0 && <span>★ {item.stars}</span>}
          {item.dependencies > 0 && <span>{item.dependencies} deps</span>}
          {item.commit && <span title={item.commit}>commit {item.commit.slice(0, 8)}</span>}
        </div>
        <div class="caps">
          {item.capabilities.slice(0, 6).map((capability) => <span>{capability}</span>)}
        </div>
        <div class="repo">{item.repo || item.id}</div>
        <div class="install-row">
          <code>{item.install}</code>
          <a class="copy-btn" href={item.deepLink}>一键安装</a>
          <button class="copy-btn" type="button" data-copy-command={item.install}>复制</button>
        </div>
        <div class="links">
          <a href={item.detail}>详情 / 安装</a>
          <a href={item.api}>API</a>
          {item.repo && <a href={`https://github.com/${item.repo}`} target="_blank" rel="noreferrer">GitHub ↗</a>}
        </div>
      </article>
    ))}
  </section>
  <div id="eco-empty" class="empty" hidden>没有匹配的生态条目。</div>

  <script>
    const search = document.querySelector<HTMLInputElement>('#eco-search');
    const verified = document.querySelector<HTMLInputElement>('#eco-verified');
    const count = document.querySelector<HTMLElement>('#eco-count');
    const empty = document.querySelector<HTMLElement>('#eco-empty');
    const cards = [...document.querySelectorAll<HTMLElement>('.eco-card')];
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-type-filter]')];
    let activeType = 'all';

    function applyFilters() {
      const keyword = (search?.value || '').trim().toLowerCase();
      const verifiedOnly = verified?.checked === true;
      let visible = 0;
      for (const card of cards) {
        const typeMatch = activeType === 'all' || card.dataset.type === activeType;
        const searchMatch = !keyword || (card.dataset.search || '').includes(keyword);
        const verifiedMatch = !verifiedOnly || card.dataset.verified === 'true';
        const show = typeMatch && searchMatch && verifiedMatch;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = `${visible} 个生态条目`;
      if (empty) empty.hidden = visible !== 0;
    }

    search?.addEventListener('input', applyFilters);
    verified?.addEventListener('change', applyFilters);
    for (const button of filters) {
      button.addEventListener('click', () => {
        activeType = button.dataset.typeFilter || 'all';
        for (const candidate of filters) candidate.classList.toggle('active', candidate === button);
        applyFilters();
      });
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-command]')) {
      button.addEventListener('click', async () => {
        const command = button.dataset.copyCommand || '';
        try {
          await navigator.clipboard.writeText(command);
          const previous = button.textContent;
          button.textContent = '已复制';
          window.setTimeout(() => { button.textContent = previous; }, 1400);
        } catch {
          window.prompt('复制本地安装命令', command);
        }
      });
    }
  </script>
</Layout>

<style>
  .hero { padding: 28px 0 20px; text-align: center; }
  .eyebrow { display: inline-block; color: var(--accent); background: var(--accent-soft); border-radius: 999px; padding: 4px 12px; font-size: 12px; font-weight: 700; }
  .hero h1 { margin: 10px 0 6px; font-size: 36px; line-height: 1.15; }
  .hero p { max-width: 720px; margin: 0 auto; color: var(--muted); }
  .metrics { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }
  .metrics span { display: inline-flex; align-items: baseline; gap: 6px; padding: 6px 12px; border: 1px solid var(--border); background: var(--card); border-radius: 999px; box-shadow: var(--shadow-sm); }
  .metrics b { color: var(--accent); }
  .metrics i { color: var(--muted); font-size: 12px; font-style: normal; }
  .notice { border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border)); background: var(--accent-soft); border-radius: 12px; padding: 12px 16px; color: var(--muted); font-size: 13px; margin-bottom: 16px; }
  .notice b { color: var(--fg); }
  .filters { display: grid; gap: 10px; margin-bottom: 14px; }
  #eco-search { width: 100%; border: 1px solid var(--border); border-radius: 12px; background: var(--card); color: var(--fg); padding: 11px 14px; font: inherit; box-shadow: var(--shadow-sm); }
  .type-filters { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; }
  .type-filter { border: 1px solid var(--border); border-radius: 999px; background: var(--card); color: var(--muted); padding: 6px 11px; cursor: pointer; }
  .type-filter small { margin-left: 3px; color: inherit; }
  .type-filter.active { background: var(--accent-soft); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); font-weight: 700; }
  .verified-only { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 13px; margin-left: auto; }
  .result-line { display: flex; justify-content: space-between; align-items: center; color: var(--muted); font-size: 13px; margin: 10px 0; gap: 12px; }
  .result-links { display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-end; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .eco-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px; box-shadow: var(--shadow-sm); min-width: 0; }
  .eco-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); }
  .card-head { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
  .kind, .verified { display: inline-flex; border-radius: 999px; padding: 2px 8px; font-size: 11px; font-weight: 800; }
  .kind { background: var(--bg-soft); color: var(--muted); }
  .kind.mcp { color: #7c3aed; background: color-mix(in srgb, #7c3aed 12%, transparent); }
  .kind.skill { color: #0891b2; background: color-mix(in srgb, #0891b2 12%, transparent); }
  .kind.agent { color: #db2777; background: color-mix(in srgb, #db2777 12%, transparent); }
  .verified { color: var(--green); background: color-mix(in srgb, var(--green) 12%, transparent); }
  h2 { font-size: 17px; margin: 10px 0 5px; overflow-wrap: anywhere; }
  .description { color: var(--muted); font-size: 13px; min-height: 42px; margin: 0 0 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .meta, .caps { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .meta span, .caps span { font-size: 11px; color: var(--muted); background: var(--bg-soft); border-radius: 999px; padding: 2px 7px; }
  .repo { color: var(--muted); font-size: 12px; margin: 8px 0; overflow-wrap: anywhere; }
  .install-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; }
  .install-row code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; font-size: 11px; }
  .copy-btn { border: none; border-radius: 8px; background: var(--accent); color: white; padding: 7px 10px; font-weight: 700; cursor: pointer; }
  .links { display: flex; gap: 12px; margin-top: 10px; font-size: 12px; }
  .empty { text-align: center; color: var(--muted); padding: 40px 0; }
  @media (max-width: 640px) {
    .hero h1 { font-size: 28px; }
    .verified-only { margin-left: 0; width: 100%; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
