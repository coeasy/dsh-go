---
import MarketplaceV2 from '../../components/MarketplaceV2.astro';
import { LANGUAGE_LABELS, SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { message } from '../../i18n/messages';
import { u } from '../../lib/urls';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Lang };
const SITE = import.meta.env.PUBLIC_SITE_URL || 'https://dsh-go.pages.dev';
const absoluteUrl = (path: string) => new URL(path, SITE).toString();
const title = `${message('hero_title', locale)} · DSH Marketplace`;
const description = message('hero_sub', locale);
---

<!doctype html>
<html lang={locale} data-route-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="canonical" href={absoluteUrl(u(`/${locale}/`))} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(u('/'))} />
    {SUPPORTED_LANGS.map((lang) => <link rel="alternate" hreflang={lang} href={absoluteUrl(u(`/${lang}/`))} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl(u(`/${locale}/`))} />
    <style>
      :root{--bg:#f7f9fc;--bg-soft:#eef2f7;--card:#fff;--fg:#0f172a;--muted:#64748b;--border:#e2e8f0;--border-strong:#cbd5e1;--accent:#2563eb;--accent-soft:#eff6ff;--green:#16a34a;--red:#ef4444;--shadow-sm:0 1px 2px rgb(15 23 42/.05);--shadow-md:0 5px 18px rgb(15 23 42/.08);--content-max:1560px}html{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--fg)}body{margin:0}.locale-nav{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:12px;padding:13px max(20px,calc((100vw - var(--content-max))/2));border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(16px)}.brand{font-weight:850;color:var(--fg);text-decoration:none}.nav-link{font-size:12px;color:var(--accent);text-decoration:none}.languages{display:flex;gap:6px;flex-wrap:wrap;margin-left:auto}.languages a{font-size:12px;padding:5px 8px;border-radius:999px;color:var(--muted);text-decoration:none}.languages a.active{color:var(--accent);background:var(--accent-soft);font-weight:800}main{max-width:var(--content-max);margin:auto;padding:0 28px 80px}.footer{border-top:1px solid var(--border);padding:24px;text-align:center;color:var(--muted);font-size:12px}@media(prefers-color-scheme:dark){:root{--bg:#0b1120;--bg-soft:#111a2e;--card:#10192c;--fg:#f1f5f9;--muted:#94a3b8;--border:#1e293b;--border-strong:#334155;--accent:#60a5fa;--accent-soft:#16233d;--green:#4ade80;--red:#f87171}}@media(max-width:650px){.locale-nav{flex-wrap:wrap}.languages{width:100%;margin-left:0}main{padding-inline:16px}}
    </style>
  </head>
  <body>
    <nav class="locale-nav" aria-label="Marketplace locale navigation">
      <a class="brand" href={u('/')}>DSH Marketplace</a>
      <a class="nav-link" href={u('/trust')}>{message('trust', locale)}</a>
      <a class="nav-link" href={u('/publishers/')}>{message('publishers', locale)}</a>
      <div class="languages">
        {SUPPORTED_LANGS.map((lang) => <a class={lang === locale ? 'active' : ''} href={u(`/${lang}/`)} hreflang={lang}>{LANGUAGE_LABELS[lang]}</a>)}
      </div>
    </nav>
    <main><MarketplaceV2 /></main>
    <footer class="footer">{message('footer_summary', locale)}</footer>
  </body>
</html>
