{
  "$schema": "https://coeasy.github.io/dsh-go/schemas/dsh-marketplace-discovery.schema.json",
  "schema": "dsh-marketplace-discovery.v1",
  "service": {
    "id": "dsh-go",
    "name": "DSH Go Marketplace",
    "version": "0.1.0",
    "mode": "read-only"
  },
  "api": {
    "version": "v1",
    "base_url": "https://dsh-go.pages.dev",
    "openapi_url": "https://dsh-go.pages.dev/openapi.json",
    "health": "/api/v1/health",
    "capabilities": "/api/v1/capabilities",
    "registry": "/api/v1/registry",
    "registry_delta": "/api/v1/registry/delta",
    "mcp": "/api/v1/mcp"
  },
  "registry": {
    "version": 3,
    "schema_url": "https://coeasy.github.io/dsh-go/catalog/schema-v3.json",
    "distribution": {
      "version": 1,
      "index_path": "/catalog/distribution-v1/index.json",
      "delta_path": "/catalog/distribution-v1/delta.json",
      "package_endpoint": "/api/v1/registry/packages/{type}/{id}",
      "versions_endpoint": "/api/v1/registry/packages/{type}/{id}/versions"
    }
  },
  "package_types": ["plugin", "mcp", "skill", "agent"],
  "installation": {
    "mode": "plan-only",
    "cli_template": "dsh {type} install {id}@{version}",
    "deep_link_scheme": "dsh",
    "explicit_confirmation_required": true,
    "restart_required_after_install": true
  },
  "deployments": [
    {
      "id": "cloudflare-pages",
      "role": "api-and-static-authority",
      "url": "https://dsh-go.pages.dev",
      "api": true,
      "static": true
    },
    {
      "id": "github-pages",
      "role": "static-replica",
      "url": "https://coeasy.github.io/dsh-go/",
      "api": false,
      "static": true
    },
    {
      "id": "edgeone-pages",
      "role": "static-replica",
      "url": null,
      "url_source": "EDGEONE_SITE_URL or CLI deployment result",
      "api": false,
      "static": true
    }
  ]
}
