{
  "$schema": "https://coeasy.github.io/dsh-go/schemas/dsh-marketplace-discovery-v2.schema.json",
  "schema": "dsh-marketplace-discovery.v2",
  "service": {
    "id": "dsh-go",
    "name": "DSH Go Marketplace",
    "version": "0.1.0",
    "mode": "read-only-discovery"
  },
  "protocol": {
    "version": 2,
    "package_coordinate": "<type>:<id>@<semver-range>",
    "package_types": ["plugin", "mcp", "skill", "agent"],
    "release_channels": ["stable", "beta", "nightly", "dev"]
  },
  "api": {
    "version": "v2",
    "base_url": "https://dsh-go.pages.dev",
    "openapi_url": "https://dsh-go.pages.dev/openapi.json",
    "index": "/api/v2",
    "health": "/api/v2/health",
    "capabilities": "/api/v2/capabilities",
    "packages": "/api/v2/packages",
    "package_detail": "/api/v2/packages/{type}/{id}",
    "package_releases": "/api/v2/packages/{type}/{id}/releases",
    "search": "/api/v2/search",
    "resolve": "/api/v2/resolve",
    "install_plan": "/api/v2/install-plan",
    "publishers": "/api/v2/publishers",
    "advisories": "/api/v2/advisories",
    "registry_revision": "/api/v2/registry/revision",
    "registry_delta": "/api/v2/registry/delta",
    "mcp": "/api/v2/mcp"
  },
  "registry": {
    "version": 4,
    "authority_path": "/catalog/registry-v4.json",
    "distribution": {
      "version": 2,
      "index_path": "/catalog/registry-v4/index.json"
    },
    "search_index": {
      "version": 3,
      "path": "/catalog/search-index-v3.json"
    }
  },
  "marketplace": {
    "detail_min_stars": 200,
    "trust_is_popularity": false,
    "locales": ["en", "zh-CN", "ja", "ko", "es"]
  },
  "installation": {
    "remote_mode": "plan-only",
    "remote_mutation": false,
    "local_runtime_is_write_authority": true,
    "cli_template": "dsh package install {type}:{id}@{range}",
    "deep_link_template": "dsh://package/install?spec={encoded-coordinate}&channel={channel}",
    "deep_link_registry_override": false,
    "explicit_confirmation_required": true,
    "auto_restart": false
  },
  "deployments": [
    { "id": "cloudflare-pages", "role": "api-and-static-authority", "url": "https://dsh-go.pages.dev", "api": true, "static": true },
    { "id": "github-pages", "role": "static-replica", "url": "https://coeasy.github.io/dsh-go/", "api": false, "static": true },
    { "id": "edgeone-pages", "role": "static-replica", "url": null, "url_source": "EDGEONE_SITE_URL or CLI deployment result", "api": false, "static": true }
  ]
}
