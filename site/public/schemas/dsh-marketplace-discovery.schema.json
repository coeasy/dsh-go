{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coeasy.github.io/dsh-go/schemas/dsh-marketplace-discovery.schema.json",
  "title": "DSH Marketplace Discovery Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "service", "api", "registry", "package_types", "installation", "deployments"],
  "properties": {
    "schema": { "const": "dsh-marketplace-discovery.v1" },
    "service": {
      "type": "object",
      "required": ["id", "name", "version", "mode"],
      "properties": {
        "id": { "const": "dsh-go" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "mode": { "const": "read-only" }
      },
      "additionalProperties": true
    },
    "api": {
      "type": "object",
      "required": ["version", "base_url", "openapi_url", "health", "capabilities", "registry", "registry_delta", "mcp"],
      "properties": {
        "version": { "const": "v1" },
        "base_url": { "type": "string", "format": "uri" },
        "openapi_url": { "type": "string", "format": "uri" },
        "health": { "type": "string" },
        "capabilities": { "type": "string" },
        "registry": { "type": "string" },
        "registry_delta": { "type": "string" },
        "mcp": { "type": "string" }
      },
      "additionalProperties": true
    },
    "registry": {
      "type": "object",
      "required": ["version", "schema_url", "distribution"],
      "properties": {
        "version": { "const": 3 },
        "schema_url": { "type": "string", "format": "uri" },
        "distribution": {
          "type": "object",
          "required": ["version", "index_path", "delta_path", "package_endpoint"],
          "properties": {
            "version": { "const": 1 },
            "index_path": { "type": "string" },
            "delta_path": { "type": "string" },
            "package_endpoint": { "type": "string" },
            "versions_endpoint": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "package_types": {
      "type": "array",
      "const": ["plugin", "mcp", "skill", "agent"]
    },
    "installation": {
      "type": "object",
      "required": ["mode", "cli_template", "deep_link_scheme", "explicit_confirmation_required", "restart_required_after_install"],
      "properties": {
        "mode": { "const": "plan-only" },
        "cli_template": { "type": "string" },
        "deep_link_scheme": { "const": "dsh" },
        "explicit_confirmation_required": { "const": true },
        "restart_required_after_install": { "const": true }
      },
      "additionalProperties": true
    },
    "deployments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "role", "api", "static"],
        "properties": {
          "id": { "enum": ["cloudflare-pages", "github-pages", "edgeone-pages"] },
          "role": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "api": { "type": "boolean" },
          "static": { "const": true }
        },
        "additionalProperties": true
      }
    }
  }
}
