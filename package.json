{
  "name": "dsh-hub",
  "version": "2.1.0",
  "description": "DeepSeek Harness 插件市场导航站（全自动同步 + 真·RESTful API + 中英文）",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:full": "node scripts/sync.mjs --full",
    "sync:incremental": "node scripts/sync.mjs --incremental",
    "validate": "node scripts/validate.mjs",
    "copy-assets": "node scripts/copy-assets.mjs",
    "site:install": "cd site && npm ci",
    "site:dev": "cd site && npm run dev",
    "site:build": "node scripts/copy-assets.mjs && cd site && npm run build",
    "deploy": "npx wrangler pages deploy site/dist --project-name=dsh-hub",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && cd site && npm run check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.114.0"
  }
}
