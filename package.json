{
  "name": "dsh_go",
  "version": "2.3.0",
  "description": "DeepSeek Harness 插件市场导航站（全自动同步 + 真·RESTful API + 中英文）",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:full": "node scripts/sync.mjs --full",
    "sync:incremental": "node scripts/sync.mjs --incremental",
    "sync:v3": "node scripts/sync-v3.mjs",
    "sync:v3:full": "node scripts/sync-v3.mjs --full",
    "deploy:gate": "node scripts/deploy-gate.mjs",
    "registry:migrate": "node scripts/migration-v3.mjs",
    "registry:verify": "node scripts/validate-registry-v3.mjs",
    "runtime:check": "node runtime/resolver.mjs",
    "validate": "node scripts/validate.mjs",
    "readme:update": "node scripts/update-readme.mjs",
    "copy-assets": "node scripts/copy-assets.mjs",
    "site:install": "cd site && npm ci",
    "site:dev": "cd site && npm run dev",
    "site:build": "node scripts/copy-assets.mjs && cd site && npm run build",
    "deploy": "npx wrangler pages deploy site/dist --project-name=dsh-go",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && cd site && npm run check"
  }
}
