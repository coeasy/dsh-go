{
  "name": "dsh_go",
  "version": "0.1.0",
  "description": "DeepSeek Harness Plugin / MCP / Skill / Agent ecosystem runtime and marketplace",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsh": "bin/dsh.mjs"
  },
  "files": [
    "bin/",
    "runtime/",
    "scripts/",
    "marketplace/",
    "mcp/",
    "skills/",
    "agents/",
    "profiles/",
    "schemas/",
    "catalog/schema-v3.json",
    "docs/"
  ],
  "scripts": {
    "dsh": "node bin/dsh.mjs",
    "sync": "node scripts/sync-v3.mjs",
    "sync:legacy": "node scripts/sync.mjs",
    "sync:full": "node scripts/sync-v3.mjs --full",
    "sync:incremental": "node scripts/sync-v3.mjs --incremental",
    "sync:v3": "node scripts/sync-v3.mjs",
    "sync:v3:full": "node scripts/sync-v3.mjs --full",
    "registry:migrate": "node scripts/sync-v3.mjs --registry-only",
    "registry:verify": "node scripts/validate-registry-v3.mjs",
    "registry:pipeline": "node scripts/registry-pipeline-v3.mjs",
    "registry:distribution": "node scripts/registry-distribution.mjs",
    "runtime:check": "node runtime/cli.mjs check-registry",
    "runtime:resolve": "node runtime/cli.mjs resolve",
    "runtime:install": "node runtime/cli.mjs install",
    "runtime:package": "node runtime/cli.mjs package",
    "runtime:plugin": "node runtime/cli.mjs plugin",
    "runtime:doctor": "node bin/dsh.mjs doctor",
    "runtime:startup": "node bin/dsh.mjs startup activate",
    "runtime:control": "node runtime/control-cli.mjs",
    "runtime:test": "vitest run tests/runtime-platform",
    "phase7:test": "vitest run tests/runtime-platform/host-bridge.test.ts tests/runtime-platform/startup-batch.test.ts tests/runtime-platform/bin-cli.test.ts tests/runtime-platform/self-update.test.ts tests/runtime-platform/client-bridge-e2e.test.ts",
    "phase8:test": "vitest run tests/runtime-platform/package-model-v3.test.ts tests/runtime-platform/registry-v3.test.ts tests/runtime-platform/unified-resolver-v3.test.ts tests/runtime-platform/bindings-v3.test.ts tests/runtime-platform/host-bridge-v3.test.ts tests/runtime-platform/unified-cli-v3.test.ts tests/runtime-platform/unified-runtime-v3-e2e.test.ts tests/runtime-platform/v3-contracts.test.ts tests/runtime-platform/registry.test.ts tests/runtime-platform/resolver.test.ts tests/runtime-platform/activation.test.ts tests/runtime-platform/startup-batch.test.ts tests/runtime-platform/e2e.test.ts tests/runtime-platform/cli.test.ts tests/runtime-platform/bin-cli.test.ts tests/runtime-platform/host-bridge.test.ts tests/runtime-platform/client-bridge-e2e.test.ts",
    "test:production-v2": "vitest run tests/production-v2 tests/e2e",
    "completion:test": "vitest run tests/completion",
    "contract:check": "node scripts/check-contract.mjs",
    "ecosystem:test": "vitest run tests/ecosystem-v1",
    "ecosystem:check": "npm run typecheck && npm run lint && npm run ecosystem:test",
    "deploy:gate": "node scripts/deploy-gate-v3.mjs",
    "validate": "node scripts/validate.mjs",
    "audit:identity": "node scripts/audit-catalog-identity.mjs",
    "audit:identity:report": "node scripts/audit-catalog-identity.mjs --report catalog/audit-report.json",
    "readme:update": "node scripts/update-readme.mjs",
    "copy-assets": "node scripts/copy-assets.mjs",
    "search:index": "node scripts/build-search-index-v2.mjs",
    "package:init": "node runtime/dsh.mjs package init",
    "package:validate": "node runtime/dsh.mjs package validate",
    "package:audit": "node runtime/dsh.mjs package audit",
    "package:sbom": "node runtime/dsh.mjs package sbom",
    "package:verify": "node scripts/verify-package-evidence.mjs",
    "site:install": "cd site && npm ci",
    "site:dev": "cd site && npm run dev",
    "site:build": "node scripts/copy-assets.mjs && cd site && npm run build",
    "deploy": "npx wrangler pages deploy site/dist --project-name=dsh-go",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run contract:check && npm run typecheck && npm run lint && npm test && cd site && npm run check",
    "platform:check": "node scripts/check-platform-discovery.mjs --file site/public/.well-known/dsh-marketplace.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
