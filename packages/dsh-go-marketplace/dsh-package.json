{
  "manifest_version": 2,
  "type": "mcp",
  "id": "coeasy/dsh-go-marketplace",
  "version": "0.1.3",
  "channel": "stable",
  "name": "DSH Go Marketplace",
  "description": "Read-only DSH package and ecosystem discovery through the canonical API V2 MCP endpoint.",
  "runtime": {
    "type": "mcp",
    "transport": "streamable-http",
    "activation": "remote"
  },
  "entrypoints": {
    "mcp": "https://dsh-go.pages.dev/api/v2/mcp"
  },
  "capabilities": [
    "marketplace.discovery",
    "registry.read",
    "install.plan",
    "mcp.tools"
  ],
  "permissions": [
    "network",
    "mcp.tools"
  ],
  "dependencies": [],
  "compatibility": {
    "os": ["linux", "darwin", "win32"],
    "arch": ["x64", "arm64"],
    "node": ">=22.0.0"
  },
  "publisher": {
    "id": "coeasy",
    "provider": "github",
    "url": "https://github.com/coeasy"
  },
  "security": {},
  "metadata": {
    "category": "mcp",
    "tags": ["dsh", "marketplace", "mcp", "registry"],
    "repository": "coeasy/dsh-go",
    "homepage": "https://dsh-go.pages.dev"
  },
  "source": {
    "provider": "github",
    "repo": "coeasy/dsh-go"
  },
  "release": {
    "package_path": "packages/dsh-go-marketplace"
  }
}
