{
  "schema_version": 2,
  "type": "plugin",
  "id": "coeasy/dsh-go-marketplace-plugin",
  "version": "0.1.2",
  "channel": "stable",
  "name": "DSH Go Marketplace Desktop",
  "description": "Desktop Marketplace UI for Package Protocol V2. Remote services are discovery-only; all local mutations are delegated to the authenticated Runtime Supervisor through Local Host API V2.",
  "runtime": {
    "type": "plugin",
    "host": "tauri-or-compatible-webview",
    "activation": "explicit"
  },
  "entrypoints": {
    "main": "index.mjs",
    "ui": "ui/index.html"
  },
  "capabilities": [
    "marketplace.ui",
    "marketplace.discovery",
    "package-manager.ipc",
    "runtime.status"
  ],
  "permissions": [
    "network"
  ],
  "dependencies": [],
  "compatibility": {
    "os": ["linux", "darwin", "win32"],
    "arch": ["x64", "arm64"],
    "node": ">=22.0.0"
  },
  "metadata": {
    "category": "marketplace",
    "tags": ["dsh", "marketplace", "desktop", "tauri", "package-manager"],
    "repository": "coeasy/dsh-go",
    "local_host_api": "v2",
    "remote_api": "v2",
    "auto_restart": false
  }
}
