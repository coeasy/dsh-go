catalog/.sync-observed.json

# 环境与本地运行
.env
.env.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# wrangler 本地状态
.wrangler/

# Agent 本地记忆 / 工作缓冲（不入库）
.workbuddy/

